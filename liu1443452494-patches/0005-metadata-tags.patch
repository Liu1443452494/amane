+"""自用刮削标签在影片详情与标签筛选中的接线。"""
+
+import pytest
+from httpx2 import AsyncClient
+
+from amane.config import HotSettings
+from amane.crawlers.models import FilmActor, MediaMetadata
+from amane.db.repository import Repository
+from amane.handlers import ScrapeHandler, ScrapePayload
+from amane.handlers.models import CacheKind
+from amane.media import ResourceStore
+from amane.parsing import ContentType
+from tests.handlers.test_scraper import FakeFactory, MockCrawler
+
+
+@pytest.mark.asyncio
+async def test_scraped_actor_tags_are_visible_and_filterable(
+    client: AsyncClient, repo: Repository, resource_store: ResourceStore
+) -> None:
+    source = MediaMetadata(number="MIDV-123", actors=[FilmActor(name="枫花恋")], tags=["單體作品", "单体作品"])
+    await repo.upsert_metadata(number=source.number, raw={"javdb": source.model_dump(mode="json")})
+    handler = ScrapeHandler(
+        repo=repo,
+        factory=FakeFactory({"javdb": MockCrawler()}),
+        resource_store=resource_store,
+        pipeline_config=HotSettings(),
+    )
+    result = await handler.handle(
+        ScrapePayload(number=source.number, content_type=ContentType.CENSORED, use_cache={CacheKind.metadata})
+    )
+    assert result.success
+    meta = await repo.get_metadata_by_number(source.number)
+    assert meta is not None
+    detail = await client.get(f"metadata/{meta.id}")
+    assert detail.status_code == 200
+    body = detail.json()
+    assert body["metadata"]["tags"] == ["单体作品", "枫花恋"]
+    assert set(body["tag_ids"]) == {"单体作品", "枫花恋"}
+    selected = await client.get("metadata", params={"tag_ids": body["tag_ids"]["枫花恋"]})
+    assert selected.status_code == 200
+    assert [item["number"] for item in selected.json()["items"]] == [source.number]
