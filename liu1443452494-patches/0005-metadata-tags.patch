+"""自用刮削标签的简繁转换、演员归一、查询关联与写入边界。"""
+
+import pytest
+
+from amane.crawlers.models import MediaMetadata
+from amane.db.models import FacetKind
+from amane.db.repo_types import WriteMode
+from amane.db.repository import Repository
+from amane.enums import MetadataField
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    ("source_tags", "source_actors", "expected_actors", "expected_tags"),
+    [
+        (
+            ["單體作品", "单体作品", " 高畫質 ", "", " \t"],
+            ["枫花恋(枫可怜)", "枫花恋", "明里䌷"],
+            ["枫花恋", "明里䌷"],
+            ["单体作品", "高画质", "枫花恋", "明里䌷"],
+        ),
+        (["單體作品"], ["楓可憐(枫可怜)"], ["楓可憐"], ["单体作品", "楓可憐"]),
+        (["Drama", "オリジナル", "HD"], [], [], ["Drama", "オリジナル", "HD"]),
+        (["明里䌷", "劇情"], ["明里䌷"], ["明里䌷"], ["明里䌷", "剧情"]),
+        ([], ["甲", "乙", "丙", "丁"], ["甲", "乙", "丙", "丁"], ["甲", "乙", "丙", "丁"]),
+        (["", " \t"], [], [], []),
+        ([], [], [], []),
+    ],
+)
+async def test_scraped_tags_are_simplified_and_linked(
+    repo: Repository,
+    source_tags: list[str],
+    source_actors: list[str],
+    expected_actors: list[str],
+    expected_tags: list[str],
+) -> None:
+    source = MediaMetadata.model_validate({"number": "MIDV-123", "tags": source_tags, "actors": source_actors})
+    snapshot = source.model_dump(mode="json")
+    meta = await repo.upsert_metadata(
+        number=source.number,
+        tags=source.tags,
+        actors=[actor.name for actor in source.actors],
+        raw={"javdb": snapshot},
+        enrich_tags=True,
+    )
+    assert meta.actors == expected_actors
+    assert meta.tags == expected_tags
+    assert meta.raw == {"javdb": snapshot}
+    assert source.tags == source_tags
+    facets, total = await repo.list_facets(FacetKind.TAG)
+    assert total == len(expected_tags)
+    assert {facet.name for facet in facets} == set(expected_tags)
+    for facet in facets:
+        found, count = await repo.list_metadata(tag_ids=[facet.id])
+        assert count == 1 and [item.id for item in found] == [meta.id]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    ("locks", "expected_actor", "expected_tags"),
+    [
+        ([], "新演员", ["新标签", "新演员"]),
+        ([MetadataField.TAGS], "新演员", ["旧标签", "旧演员"]),
+        ([MetadataField.ACTORS], "旧演员", ["新标签", "旧演员"]),
+        ([MetadataField.TAGS, MetadataField.ACTORS], "旧演员", ["旧标签", "旧演员"]),
+    ],
+)
+async def test_rescrape_replaces_tags_and_respects_locks(
+    repo: Repository,
+    locks: list[MetadataField],
+    expected_actor: str,
+    expected_tags: list[str],
+) -> None:
+    meta = await repo.upsert_metadata(
+        number="MIDV-123",
+        actors=["旧演员"],
+        tags=["舊標籤"],
+        field_sources={"tags": "javdb"},
+        enrich_tags=True,
+    )
+    assert meta.id is not None
+    await repo.set_metadata_locks(meta.id, locks)
+    updated = await repo.upsert_metadata(
+        number=meta.number,
+        actors=["新演员"],
+        tags=["新標籤"],
+        field_sources={"tags": "javbus"},
+        raw={"javbus": {"tags": ["新標籤"]}},
+        enrich_tags=True,
+    )
+    assert updated.actors == [expected_actor]
+    assert updated.tags == expected_tags
+    assert updated.raw == {"javbus": {"tags": ["新標籤"]}}
+    assert updated.field_sources["tags"] == ("javdb" if MetadataField.TAGS in locks else "javbus")
+    _, _, _, tag_ids, _, _, _ = await repo.resolve_metadata_facet_ids(updated)
+    assert set(tag_ids) == set(expected_tags)
+
+
+@pytest.mark.asyncio
+async def test_manual_and_unrequested_tag_writes_are_preserved(repo: Repository) -> None:
+    meta = await repo.upsert_metadata(number="MIDV-123", actors=["演员"], tags=["原始標籤"])
+    assert meta.id is not None and meta.tags == ["原始標籤"]
+    unchanged = await repo.upsert_metadata(number=meta.number, title="更新标题", enrich_tags=True)
+    assert unchanged.tags == ["原始標籤"]
+    manual = await repo.update_metadata(meta.id, mode=WriteMode.MANUAL, tags=["手動標籤"])
+    assert manual is not None and manual.tags == ["手動標籤"]
+    scraped = await repo.upsert_metadata(number=meta.number, actors=["新演员"], tags=["劇情"], enrich_tags=True)
+    assert scraped.tags == ["手動標籤"]
+    assert scraped.actors == ["新演员"]
+
+
+@pytest.mark.asyncio
+async def test_actor_aliases_and_facet_rules_are_respected(repo: Repository) -> None:
+    meta = await repo.upsert_metadata(
+        number="MIDV-123", actors=["标准名(旧名)", "剔除演员"], tags=["單體作品"], enrich_tags=True
+    )
+    facets, _ = await repo.list_facets(FacetKind.TAG)
+    tag_ids = {facet.name: facet.id for facet in facets}
+    await repo.rename_facet(FacetKind.TAG, tag_ids["单体作品"], "自定义标签")
+    await repo.delete_facet(FacetKind.TAG, tag_ids["标准名"])
+    blocked_actor = (await repo.get_actors_by_names(["剔除演员"]))[0]
+    assert blocked_actor.id is not None
+    await repo.delete_facet(FacetKind.ACTOR, blocked_actor.id)
+
+    updated = await repo.upsert_metadata(
+        number=meta.number, actors=["旧名", "剔除演员"], tags=["單體作品"], enrich_tags=True
+    )
+    assert updated.actors == ["标准名"]
+    assert updated.tags == ["自定义标签"]
+    _, _, _, actual_tags, _, _, _ = await repo.resolve_metadata_facet_ids(updated)
+    assert set(actual_tags) == {"自定义标签"}
