@@ -0,0 +1,13 @@
+"""自用刮削标签：原始标签转简体，再追加已归一的演员姓名。"""
+
+from collections.abc import Sequence
+
+import zhconv
+
+
+def build_metadata_tags(tags: Sequence[str], actors: Sequence[str]) -> list[str]:
+    """不修改输入或转换演员姓名；空标签排除，重复标签保留首次出现的位置。"""
+    # 通用简体保留原有用词，避免地区词汇替换。
+    labels = [zhconv.convert(tag, "zh-hans").strip() for tag in tags]
+    labels.extend(actors)
+    return list(dict.fromkeys(label for label in labels if label))
