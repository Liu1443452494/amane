new file mode 100644
index 0000000000000000000000000000000000000000..a0d31d29c1e5b18830bf3d114ad3b0242fcedd02
--- /dev/null
+++ b/tests/handlers/test_liu1443452494_library_images.py
@@ -0,0 +1,108 @@
+"""独立图片输出与备用海报裁切。"""
+
+from collections.abc import Sequence
+from pathlib import Path
+from unittest.mock import Mock
+
+import pytest
+from PIL import Image
+from pydantic import ValidationError
+
+from amane.api.models.libraries import LibraryCreateRequest
+from amane.config import HotSettings, ScrapingConfig, WatermarkConfig
+from amane.db.models import Metadata
+from amane.enums import LibraryResource
+from amane.handlers.file import _download_images_via_store
+from amane.media import ResourceStore
+from amane.net.http import WebClient
+from amane.organize import ResolvedPaths
+from amane.parsing import ContentType, parse_file_info
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    ("selected", "has_poster", "old_thumb", "cover_available"),
+    [
+        ([], False, False, True),
+        (["thumb"], False, False, True),
+        (["fanart"], False, False, True),
+        (["poster"], False, False, True),
+        (["poster", "fanart"], False, True, True),
+        (["thumb", "poster", "fanart"], True, False, True),
+        (["poster"], True, False, False),
+        (["poster", "fanart"], False, False, False),
+    ],
+)
+async def test_independent_images(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+    resource_store: ResourceStore,
+    selected: list[str],
+    has_poster: bool,
+    old_thumb: bool,
+    cover_available: bool,
+) -> None:
+    cover = tmp_path / "原图.jpg"
+    Image.new("RGB", (300, 200), "red").save(cover)
+    original_cover = cover.read_bytes()
+    poster = tmp_path / "原海报.jpg"
+    Image.new("RGB", (90, 160), "blue").save(poster)
+    output = tmp_path / "整理"
+    output.mkdir()
+    paths = ResolvedPaths(
+        video=output / "影片.mp4",
+        thumb=output / "thumb.jpg",
+        poster=output / "poster.jpg",
+        fanart=output / "fanart.jpg",
+        extrafanart_dir=output / "extrafanart",
+        nfo=output / "影片.nfo",
+        trailer=output / "trailer.mp4",
+    )
+    if old_thumb:
+        paths.thumb.write_bytes(b"existing-thumb")
+    requested: list[str] = []
+
+    async def acquire(urls: Sequence[str], store: ResourceStore, client: WebClient) -> Path | None:
+        requested.extend(urls)
+        if urls == ["https://example.test/poster"]:
+            return poster if has_poster else None
+        return cover if cover_available else None
+
+    monkeypatch.setattr("amane.handlers.file._acquire_first_local", acquire)
+    await _download_images_via_store(
+        Metadata(
+            number="IPSS-453", thumb_urls=["https://example.test/cover"], poster_urls=["https://example.test/poster"]
+        ),
+        resource_store,
+        Mock(spec=WebClient),
+        paths,
+        HotSettings(watermark=WatermarkConfig(enabled=old_thumb)),
+        {LibraryResource(kind) for kind in selected},
+        parse_file_info("ipss-453-uc.mp4"),
+        ContentType.CENSORED,
+    )
+    assert cover.read_bytes() == original_cover
+    if old_thumb:
+        assert paths.thumb.read_bytes() == b"existing-thumb"
+    else:
+        assert paths.thumb.exists() is ("thumb" in selected and cover_available)
+    assert paths.fanart.exists() is ("fanart" in selected and cover_available)
+    if paths.fanart.exists():
+        assert paths.fanart.read_bytes() == original_cover
+    assert paths.poster.exists() is ("poster" in selected and (has_poster or cover_available))
+    if paths.poster.exists():
+        with Image.open(paths.poster) as generated:
+            assert generated.size == ((90, 160) if has_poster else (140, 200))
+    if selected == ["poster"] and has_poster:
+        assert requested == ["https://example.test/poster"]
+    if not selected:
+        assert requested == []
+
+
+def test_fanart_is_only_a_library_resource(tmp_path: Path) -> None:
+    request = LibraryCreateRequest(path=str(tmp_path), copy_resources=[LibraryResource.fanart])
+    assert request.model_dump(mode="json")["copy_resources"] == ["fanart"]
+    with pytest.raises(ValidationError, match="download_resources"):
+        ScrapingConfig.model_validate({"download_resources": ["fanart"]})
+    with pytest.raises(ValidationError, match="copy_resources"):
+        LibraryCreateRequest.model_validate({"path": str(tmp_path), "copy_resources": ["invalid"]})
