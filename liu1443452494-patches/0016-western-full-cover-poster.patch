+@pytest.mark.asyncio
+@pytest.mark.parametrize("valid_cover", [True, False])
+async def test_full_cover_jpeg_conversion_and_invalid_source(
+    resource_store: ResourceStore, tmp_path: Path, valid_cover: bool
+) -> None:
+    cover_url = "https://images.test/cover.png"
+    stream = BytesIO()
+    Image.new("RGB", (800, 400), "red").save(stream, format="PNG")
+    original_bytes = stream.getvalue() if valid_cover else b"invalid image"
+    client = PosterClient(images={cover_url: original_bytes})
+    paths = _paths(tmp_path / "整理")
+    paths.poster.parent.mkdir(parents=True, exist_ok=True)
+    paths.poster.write_bytes(b"previous poster")
+    config = HotSettings(watermark=WatermarkConfig(enabled=False))
+    config.scraping.western_full_cover_poster = True
+    metadata = Metadata(number="Studio.24.01.01", thumb_urls=[cover_url])
+    if not valid_cover:
+        with pytest.raises(OSError, match="无法取得整理所需的原始资源: 海报"):
+            await _download_images_via_store(
+                metadata,
+                resource_store,
+                cast("WebClient", client),
+                paths,
+                config,
+                {LibraryResource.poster},
+                None,
+                ContentType.WESTERN,
+                fresh_only=True,
+                required_images=frozenset({"poster"}),
+            )
+        assert paths.poster.read_bytes() == b"previous poster"
+        return
+    outputs = await _download_images_via_store(
+        metadata,
+        resource_store,
+        cast("WebClient", client),
+        paths,
+        config,
+        {LibraryResource.poster, LibraryResource.fanart},
+        None,
+        ContentType.WESTERN,
+    )
+    assert {output.kind for output in outputs} == {"poster", "fanart"}
+    assert not paths.thumb.exists()
+    for path in (paths.poster, paths.fanart):
+        with Image.open(path) as image:
+            assert image.format == "JPEG"
+            assert image.size == (800, 400)
+    source = await resource_store.resolve(cover_url)
+    assert source is not None and source.read_bytes() == original_bytes
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("image_format", ["JPEG", "PNG"])
+@pytest.mark.parametrize("poster_saved", [False, True])
