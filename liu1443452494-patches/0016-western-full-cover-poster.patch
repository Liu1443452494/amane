+"""欧美完整海报的启用条件、图片有效性与历史裁切保护。"""
+
+from pathlib import Path
+from typing import Literal, cast
+
+import pytest
+from PIL import Image
+
+from amane.config import HotSettings
+from amane.enums import DownloadableResource
+from amane.media import ResourceStore, manual_crop_image, materialize_images
+from amane.net.http import WebClient
+from amane.parsing import ContentType
+from tests.media.test_liu1443452494_image_quality import PosterClient, image_bytes
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    ("content_type", "crop", "enabled", "poster_kind", "cover_valid", "expected"),
+    [
+        (ContentType.WESTERN, True, True, "absent", True, "full"),
+        (ContentType.WESTERN, True, True, "valid", True, "poster"),
+        (ContentType.WESTERN, True, True, "invalid", True, "full"),
+        (ContentType.WESTERN, True, True, "missing", True, "full"),
+        (ContentType.WESTERN, True, True, "absent", False, "none"),
+        (ContentType.WESTERN, False, True, "absent", True, "none"),
+        (ContentType.WESTERN, True, False, "absent", True, "none"),
+        (ContentType.CENSORED, True, True, "absent", True, "crop"),
+        (ContentType.UNCENSORED, True, True, "absent", True, "crop"),
+        (ContentType.CHINESE, True, True, "absent", True, "none"),
+        (ContentType.FC2, True, True, "absent", True, "none"),
+        (ContentType.AMATEUR, True, True, "absent", True, "none"),
+        (ContentType.HENTAI, True, True, "absent", True, "none"),
+    ],
+)
+async def test_western_poster_selection(
+    resource_store: ResourceStore,
+    tmp_path: Path,
+    content_type: ContentType,
+    crop: bool,
+    enabled: bool,
+    poster_kind: Literal["absent", "valid", "invalid", "missing"],
+    cover_valid: bool,
+    expected: Literal["full", "poster", "crop", "none"],
+) -> None:
+    cover_url = "https://images.test/cover.jpg"
+    poster_url = "https://images.test/poster.jpg"
+    cover_bytes = image_bytes((800, 400)) if cover_valid else b"<html>invalid cover</html>"
+    poster_bytes = image_bytes((100, 150)) if poster_kind == "valid" else b"<html>invalid poster</html>"
+    client = PosterClient(
+        images={cover_url: cover_bytes, poster_url: None if poster_kind == "missing" else poster_bytes}
+    )
+    config = HotSettings()
+    config.scraping.crop_poster = crop
+    config.scraping.western_full_cover_poster = enabled
+    result = await materialize_images(
+        [] if poster_kind == "absent" else [poster_url],
+        [cover_url],
+        [],
+        resource_store,
+        cast("WebClient", client),
+        config,
+        tmp_path,
+        content_type=content_type,
+    )
+    if expected == "none":
+        assert result.poster_urls == []
+        return
+    source = await resource_store.resolve_source(result.poster_urls[0], cast("WebClient", client))
+    assert source is not None
+    with Image.open(source.path) as image:
+        assert image.size == {"full": (800, 400), "poster": (100, 150), "crop": (280, 400)}[expected]
+    if expected == "full":
+        assert result.poster_urls == [cover_url]
+        assert source.path.read_bytes() == cover_bytes
+        assert client.downloaded.count(cover_url) == 1
+    elif expected == "poster":
+        assert result.poster_urls[0] == poster_url
+        assert source.path.read_bytes() == poster_bytes
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("selected", [[], ["thumb"], ["poster"], ["thumb", "poster"]])
+async def test_full_cover_respects_download_selection(
+    resource_store: ResourceStore, tmp_path: Path, selected: list[str]
+) -> None:
+    cover_url = "https://images.test/cover.jpg"
+    client = PosterClient(images={cover_url: image_bytes((800, 400))})
+    config = HotSettings()
+    config.scraping.western_full_cover_poster = True
+    config.scraping.download_resources = [DownloadableResource(kind) for kind in selected]
+    result = await materialize_images(
+        [],
+        [cover_url],
+        [],
+        resource_store,
+        cast("WebClient", client),
+        config,
+        tmp_path,
+        content_type=ContentType.WESTERN,
+    )
+    assert result.poster_urls == ([cover_url] if "poster" in selected else [])
+    assert client.downloaded == ([cover_url] if selected else [])
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    ("origin", "locked", "cover_available", "replace"),
+    [
+        ("automatic", False, True, True),
+        ("automatic", True, True, False),
+        ("automatic", False, False, False),
+        ("manual", False, True, False),
+        ("downloaded", False, True, False),
+    ],
+)
+async def test_full_cover_preserves_manual_and_source_posters(
+    resource_store: ResourceStore,
+    tmp_path: Path,
+    origin: Literal["automatic", "manual", "downloaded"],
+    locked: bool,
+    cover_available: bool,
+    replace: bool,
+) -> None:
+    cover_url = "https://images.test/cover.jpg"
+    downloaded_url = "https://images.test/previous.jpg"
+    client = PosterClient(images={cover_url: image_bytes((800, 400)), downloaded_url: image_bytes((100, 150))})
+    config = HotSettings()
+    if origin == "automatic":
+        previous = await materialize_images(
+            [],
+            [cover_url],
+            [],
+            resource_store,
+            cast("WebClient", client),
+            config,
+            tmp_path,
+            content_type=ContentType.CENSORED,
+        )
+        previous_url = previous.poster_urls[0]
+    elif origin == "manual":
+        previous_url = await manual_crop_image(
+            cover_url, (200, 0, 500, 400), resource_store, cast("WebClient", client), config, tmp_path, subject="封面图"
+        )
+    else:
+        assert await resource_store.acquire(downloaded_url, cast("WebClient", client)) is not None
+        previous_url = downloaded_url
+    config.scraping.western_full_cover_poster = True
+    result = await materialize_images(
+        [],
+        [cover_url] if cover_available else [],
+        [],
+        resource_store,
+        cast("WebClient", client),
+        config,
+        tmp_path,
+        content_type=ContentType.WESTERN,
+        previous_poster_urls=[previous_url],
+        locked_fields=["poster_urls"] if locked else [],
+    )
+    assert result.poster_urls == ([cover_url] if replace else [previous_url])
+    if replace:
+        source = await resource_store.resolve_source(result.poster_urls[0], cast("WebClient", client))
+        assert source is not None
+        with Image.open(source.path) as image:
+            assert image.size == (800, 400)
