+"""欧美整图海报在刮削保存与独立整理输出中的行为。"""
+
+from io import BytesIO
+from pathlib import Path
+from typing import Literal, cast
+
+import pytest
+from PIL import Image
+
+from amane.config import HotSettings, WatermarkConfig
+from amane.crawlers.models import MediaMetadata
+from amane.db.models import Metadata
+from amane.db.repository import Repository
+from amane.enums import LibraryResource, SiteName
+from amane.handlers import ScrapeHandler, ScrapePayload
+from amane.handlers.file import _download_images_via_store
+from amane.media import ResourceStore
+from amane.net.http import WebClient
+from amane.parsing import ContentType, parse_file_info
+from tests.handlers.test_file_ops import _paths
+from tests.handlers.test_liu1443452494_image_quality import OriginalCrawler
+from tests.handlers.test_scraper import FakeFactory
+from tests.media.test_liu1443452494_image_quality import PosterClient, image_bytes
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    ("stored_type", "task_type", "full"),
+    [
+        (None, ContentType.WESTERN, True),
+        (ContentType.WESTERN, ContentType.CENSORED, True),
+        (ContentType.CENSORED, ContentType.WESTERN, False),
+    ],
+)
+async def test_scrape_uses_persistent_content_type(
+    repo: Repository,
+    resource_store: ResourceStore,
+    stored_type: ContentType | None,
+    task_type: ContentType,
+    full: bool,
+) -> None:
+    cover_url = "https://images.test/cover.jpg"
+    original = MediaMetadata(number="Studio.24.01.01", title="测试影片", thumb_urls=[cover_url])
+    if stored_type is not None:
+        await repo.upsert_metadata(number=original.number, content_type=stored_type)
+    config = HotSettings()
+    config.scraping.western_full_cover_poster = True
+    config.scraping.content_routes[task_type] = [SiteName.DMM]
+    client = PosterClient(images={cover_url: image_bytes((800, 400))})
+    handler = ScrapeHandler(
+        repo,
+        FakeFactory({"dmm": OriginalCrawler(original)}),
+        resource_store,
+        config,
+        web_client=cast("WebClient", client),
+    )
+    result = await handler.handle(ScrapePayload(number=original.number, content_type=task_type, use_cache=set()))
+    assert result.success
+    saved = await repo.get_metadata_by_number(original.number)
+    assert saved is not None
+    assert saved.content_type is (stored_type or task_type)
+    assert saved.raw["dmm"]["poster_urls"] == []
+    assert (saved.poster_urls == [cover_url]) is full
+    source = await resource_store.resolve_source(saved.poster_urls[0], cast("WebClient", client))
+    assert source is not None
+    with Image.open(source.path) as image:
+        assert image.size == ((800, 400) if full else (280, 400))
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    ("selected", "enabled", "crop", "content_type", "poster_kind", "expected_size"),
+    [
+        (["poster", "fanart"], True, True, ContentType.WESTERN, "absent", (800, 400)),
+        (["poster"], True, True, ContentType.WESTERN, "absent", (800, 400)),
+        (["thumb", "poster", "fanart"], True, True, ContentType.WESTERN, "absent", (800, 400)),
+        (["fanart"], True, True, ContentType.WESTERN, "absent", None),
+        ([], True, True, ContentType.WESTERN, "absent", None),
+        (["poster", "fanart"], True, True, ContentType.WESTERN, "valid", (100, 150)),
+        (["poster", "fanart"], True, True, ContentType.WESTERN, "invalid", (800, 400)),
+        (["poster", "fanart"], True, True, ContentType.WESTERN, "missing", (800, 400)),
+        (["poster", "fanart"], True, True, ContentType.WESTERN, "cover", (800, 400)),
+        (["poster", "fanart"], False, True, ContentType.WESTERN, "absent", None),
+        (["poster", "fanart"], True, False, ContentType.WESTERN, "absent", None),
+        (["poster", "fanart"], True, True, ContentType.CENSORED, "absent", (280, 400)),
+        (["poster", "fanart"], True, True, ContentType.UNCENSORED, "absent", (280, 400)),
+        (["poster", "fanart"], True, True, ContentType.FC2, "absent", None),
+    ],
+)
+async def test_organize_full_cover_without_thumb_output(
+    resource_store: ResourceStore,
+    tmp_path: Path,
+    selected: list[str],
+    enabled: bool,
+    crop: bool,
+    content_type: ContentType,
+    poster_kind: Literal["absent", "valid", "invalid", "missing", "cover"],
+    expected_size: tuple[int, int] | None,
+) -> None:
+    cover_url = "https://images.test/cover.jpg"
+    poster_url = "https://images.test/poster.jpg"
+    cover_bytes = image_bytes((800, 400))
+    client = PosterClient(
+        images={cover_url: cover_bytes, poster_url: image_bytes((100, 150)) if poster_kind == "valid" else None}
+    )
+    if poster_kind == "invalid":
+        client.images[poster_url] = b"<html>invalid poster</html>"
+    paths = _paths(tmp_path / "整理")
+    paths.thumb.parent.mkdir(parents=True, exist_ok=True)
+    if "thumb" not in selected:
+        paths.thumb.write_bytes("原有封面保持不变".encode())
+    config = HotSettings(watermark=WatermarkConfig(enabled=False))
+    config.scraping.western_full_cover_poster = enabled
+    config.scraping.crop_poster = crop
+    urls = [] if poster_kind == "absent" else [cover_url if poster_kind == "cover" else poster_url]
+    outputs = await _download_images_via_store(
+        Metadata(number="Studio.24.01.01", content_type=content_type, thumb_urls=[cover_url], poster_urls=urls),
+        resource_store,
+        cast("WebClient", client),
+        paths,
+        config,
+        {LibraryResource(kind) for kind in selected},
+        None,
+        content_type,
+    )
+    assert {output.kind for output in outputs} == set(selected) - ({"poster"} if expected_size is None else set())
+    assert paths.fanart.exists() is ("fanart" in selected)
+    if paths.fanart.exists():
+        assert paths.fanart.read_bytes() == cover_bytes
+    if "thumb" not in selected:
+        assert paths.thumb.read_bytes() == "原有封面保持不变".encode()
+    assert paths.poster.exists() is (expected_size is not None)
+    if expected_size is not None:
+        with Image.open(paths.poster) as image:
+            assert image.size == expected_size
+        if expected_size == (800, 400):
+            assert paths.poster.read_bytes() == cover_bytes
+    assert client.downloaded.count(cover_url) <= 1
