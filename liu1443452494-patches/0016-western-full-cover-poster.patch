+    original = stream.getvalue()
+    client = PosterClient(images={cover_url: original})
+    stamps = tmp_path / "水印"
+    stamps.mkdir()
+    Image.new("RGBA", (40, 20), (255, 0, 0, 255)).save(stamps / "subtitle.png")
+    config = HotSettings(watermark=WatermarkConfig(enabled=True, scale=0.2))
+    config.scraping.western_full_cover_poster = True
+    paths = _paths(tmp_path / "整理")
+    outputs = await _download_images_via_store(
+        Metadata(
+            number="Studio.24.01.01",
+            content_type=ContentType.WESTERN,
+            thumb_urls=[cover_url],
+            poster_urls=[cover_url] if poster_saved else [],
+        ),
+        resource_store,
+        cast("WebClient", client),
+        paths,
+        config,
+        {LibraryResource.poster, LibraryResource.fanart},
+        parse_file_info("Studio.24.01.01-C.mp4"),
+        ContentType.WESTERN,
+        stamps,
+    )
+    assert {output.kind for output in outputs} == {"poster", "fanart"}
+    assert not paths.thumb.exists()
+    for path in (paths.poster, paths.fanart):
+        with Image.open(path) as image:
+            assert image.format == "JPEG" and image.size == (800, 400)
+            pixel = image.getpixel((20, 20))
+            assert isinstance(pixel, tuple)
+            if path == paths.poster:
+                assert pixel[0] > 230 and pixel[2] < 30
+            else:
+                assert pixel[0] < 30 and pixel[2] > 230
+    source = await resource_store.resolve(cover_url)
+    assert source is not None and source.read_bytes() == original
+    assert client.downloaded.count(cover_url) == 1
