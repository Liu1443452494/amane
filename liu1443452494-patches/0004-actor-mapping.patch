+"""XML 演员姓名匹配、歧义跳过和用户文件更新。"""
+
+from pathlib import Path
+
+import pytest
+
+from amane.config import HotSettings
+from amane.crawlers.models import FilmActor
+from amane.db.repository import Repository
+from amane.enums import ActorGender
+from amane.handlers import ScrapeHandler, ScrapePayload
+from amane.liu1443452494_actor_mapping import map_actor_names
+from amane.media import ResourceStore
+from amane.organize.template import TemplateContext
+from amane.parsing import ContentType, split_actor_aliases
+from tests.handlers.test_scraper import FakeFactory, MockCrawler
+
+
+@pytest.fixture
+def mapping_file(tmp_path: Path) -> Path:
+    path = tmp_path / "mapping_actor.xml"
+    path.write_text(
+        '<actors><a zh_cn="枫花恋" zh_tw="楓可憐" jp="楓カレン" '
+        'keyword="枫可怜,田中レモン,枫花恋" avatar="https://example.test/avatar.jpg"/></actors>',
+        encoding="utf-8",
+    )
+    return path
+
+
+@pytest.mark.parametrize(
+    ("name", "expected"),
+    [
+        ("枫花恋", "枫花恋"),
+        ("楓可憐", "枫花恋"),
+        ("楓カレン", "枫花恋"),
+        ("枫可怜", "枫花恋"),
+        (" 田中レモン ", "枫花恋"),
+        ("未知演员", "未知演员"),
+        ("前缀枫可怜", "前缀枫可怜"),
+        ("枫可怜（田中レモン）", "枫花恋"),
+    ],
+)
+def test_mapping_fields(mapping_file: Path, name: str, expected: str) -> None:
+    actor = FilmActor(name=name, gender=ActorGender.FEMALE)
+    mapped = map_actor_names([actor], mapping_file.parent)
+    primary, aliases = split_actor_aliases(mapped[0].name)
+    assert primary == expected
+    assert mapped[0].gender is ActorGender.FEMALE
+    assert actor.name == name
+    if name == "枫可怜（田中レモン）":
+        assert aliases == ["枫可怜", "田中レモン"]
+
+
+def test_ambiguous_name_uses_original_flow(mapping_file: Path) -> None:
+    mapping_file.write_text(
+        '<actors><a zh_cn="甲" keyword="重名,重名,甲的别名"/>'
+        '<a zh_cn="乙" keyword="重名"/><a zh_cn="甲" jp="甲的别名"/>'
+        '<a zh_cn="" keyword="空标准名"/></actors>',
+        encoding="utf-8",
+    )
+    actors = [FilmActor(name=name) for name in ("重名", "甲的别名", "空标准名")]
+    mapped = map_actor_names(actors, mapping_file.parent)
+    assert [split_actor_aliases(actor.name)[0] for actor in mapped] == ["重名", "甲", "空标准名"]
+
+
+def test_file_updates_and_missing_file(mapping_file: Path) -> None:
+    actor = FilmActor(name="枫可怜")
+    assert split_actor_aliases(map_actor_names([actor], mapping_file.parent)[0].name)[0] == "枫花恋"
+    mapping_file.write_text('<actors><a zh_cn="新标准名" keyword="枫可怜"/></actors>', encoding="utf-8-sig")
+    assert split_actor_aliases(map_actor_names([actor], mapping_file.parent)[0].name)[0] == "新标准名"
+    mapping_file.unlink()
+    assert map_actor_names([actor], mapping_file.parent) == [actor]
+    assert map_actor_names([], mapping_file.parent) == []
+
+
+@pytest.mark.parametrize("content", [b"<actors>", b"\xff\xfe"])
+def test_invalid_mapping_has_clear_error(mapping_file: Path, content: bytes) -> None:
+    mapping_file.write_bytes(content)
+    with pytest.raises(ValueError, match="演员映射文件读取失败"):
+        map_actor_names([FilmActor(name="枫可怜")], mapping_file.parent)
+
+
+@pytest.mark.asyncio
+async def test_scrape_uses_standard_name_before_saving(
+    mapping_file: Path,
+    repo: Repository,
+    resource_store: ResourceStore,
+) -> None:
+    mapping_file.write_text('<actors><a zh_cn="枫花恋" keyword="Actor A"/></actors>', encoding="utf-8")
+    handler = ScrapeHandler(
+        repo=repo,
+        factory=FakeFactory({"javdb": MockCrawler()}),
+        resource_store=resource_store,
+        pipeline_config=HotSettings(),
+    )
+    result = await handler.handle(ScrapePayload(number="MIDV-123", content_type=ContentType.CENSORED))
+    assert result.success
+    metadata = await repo.get_metadata_by_number("MIDV-123")
+    assert metadata is not None
+    assert metadata.actors == ["枫花恋"]
+    assert TemplateContext.from_metadata(metadata).variables["actresses"] == "枫花恋"
+    assert metadata.raw["javdb"]["actors"][0]["name"] == "Actor A"
+    actors = await repo.get_actors_by_names(["枫花恋"])
+    assert len(actors) == 1 and actors[0].id is not None
+    assert "Actor A" in await repo.get_actor_aliases(actors[0].id)
