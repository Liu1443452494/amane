@@ -0,0 +1,50 @@
+"""自用演员姓名映射，仅处理刮削结果，不维护演员数据库。"""
+
+from collections.abc import Sequence
+from pathlib import Path
+from xml.etree import ElementTree
+
+from .crawlers.models import FilmActor
+from .parsing import split_actor_aliases
+
+
+def map_actor_names(actors: Sequence[FilmActor], data_dir: Path) -> list[FilmActor]:
+    """每次读取映射文件；缺失文件、未匹配或歧义姓名沿用原始输入。"""
+    if not actors:
+        return []
+    path = data_dir / "mapping_actor.xml"
+    try:
+        root = ElementTree.fromstring(path.read_text(encoding="utf-8-sig"))
+    except FileNotFoundError:
+        return list(actors)
+    except (OSError, UnicodeError, ElementTree.ParseError) as exc:
+        raise ValueError(f"演员映射文件读取失败，请检查 UTF-8 编码和 XML 格式: {path}") from exc
+
+    names: dict[str, str | None] = {}
+    for entry in root.iter("a"):
+        standard = entry.get("zh_cn", "").strip()
+        if not standard:
+            continue
+        candidates = [entry.get(key, "") for key in ("zh_cn", "zh_tw", "jp")]
+        candidates.extend(entry.get("keyword", "").split(","))
+        for candidate in candidates:
+            name = candidate.strip()
+            if not name:
+                continue
+            if name not in names:
+                names[name] = standard
+            elif names[name] != standard:
+                names[name] = None
+
+    mapped: list[FilmActor] = []
+    for actor in actors:
+        name, aliases = split_actor_aliases(actor.name)
+        standard = names.get(name)
+        if standard is None:
+            mapped.append(actor)
+            continue
+        # 原始姓名交给现有括号别名解析，供后续演员资料查询使用。
+        aliases = list(dict.fromkeys(alias for alias in (name, *aliases) if alias != standard))
+        mapped_name = f"{standard}({','.join(aliases)})" if aliases else standard
+        mapped.append(FilmActor(name=mapped_name, gender=actor.gender))
+    return mapped
