diff --git a/tests/media/test_liu1443452494_nfo.py b/tests/media/test_liu1443452494_nfo.py
new file mode 100644
index 0000000000000000000000000000000000000000..4388787bd99447d3a3d4f02df0c9c62cb28e01af
--- /dev/null
+++ b/tests/media/test_liu1443452494_nfo.py
@@ -0,0 +1,86 @@
+"""自用 NFO 的文件标签与连续节点顺序。"""
+
+from pathlib import Path
+from xml.etree import ElementTree
+
+import pytest
+
+from amane.db.models import MediaFile, Metadata
+from amane.enums import MoveMode
+from amane.handlers.file import execute_file_operations
+from amane.media import ResourceStore, write_nfo
+from amane.organize import PlaceOutcome, ResolvedPaths
+from amane.parsing import ContentType, parse_file_info
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    ("filename", "content_type", "external_subtitle", "extra_labels"),
+    [
+        ("ipss-453-uc.mp4", ContentType.CENSORED, False, ["中文字幕", "破解"]),
+        ("IPSS-453-UC.mp4", ContentType.CENSORED, False, ["中文字幕", "破解"]),
+        ("ipss-453-u.mp4", ContentType.CENSORED, False, ["破解"]),
+        ("ipss-453-c.mp4", ContentType.CENSORED, False, ["中文字幕", "有码"]),
+        ("ipss-453.mp4", ContentType.CENSORED, False, ["有码"]),
+        ("ipss-453.mp4", ContentType.UNCENSORED, True, ["中文字幕", "无码"]),
+        ("ipss-453.mp4", ContentType.UNCENSORED, False, ["无码"]),
+        ("ipss-453.mp4", ContentType.WESTERN, False, []),
+    ],
+)
+async def test_nfo_labels(
+    tmp_path: Path,
+    filename: str,
+    content_type: ContentType,
+    external_subtitle: bool,
+    extra_labels: list[str],
+) -> None:
+    metadata = Metadata(
+        number="IPSS-453",
+        title="标题 & <内容>",
+        content_type=content_type,
+        actors=["明里䌷", "枫&花<恋"],
+        tags=["剧情", "明里䌷", "剧情", ""],
+        directors=["导演"],
+    )
+    target = tmp_path / "影片.nfo"
+    file_info = parse_file_info(filename, has_external_subtitle=external_subtitle)
+    assert await write_nfo(metadata, target, file_info=file_info)
+    root = ElementTree.fromstring(target.read_text(encoding="utf-8"))
+    expected = ["剧情", "明里䌷", "枫&花<恋", *extra_labels]
+    assert [element.text for element in root.findall("tag")] == expected
+    assert [element.text for element in root.findall("genre")] == expected
+    grouped = [element.tag for element in root if element.tag in ("tag", "genre")]
+    assert grouped == ["tag"] * len(expected) + ["genre"] * len(expected)
+    assert root.findall("director") == []
+    assert metadata.directors == ["导演"]
+    assert metadata.tags == ["剧情", "明里䌷", "剧情", ""]
+    assert [element.text for element in root.findall("actor/name")] == metadata.actors
+    assert root.findtext("title") == "IPSS-453 标题 & <内容>"
+
+
+@pytest.mark.asyncio
+async def test_organize_supplies_file_labels(tmp_path: Path, resource_store: ResourceStore) -> None:
+    source = tmp_path / "ipss-453-uc.mp4"
+    source.write_bytes(b"video")
+    output = tmp_path / "整理"
+    paths = ResolvedPaths(
+        video=output / source.name,
+        thumb=output / "thumb.jpg",
+        poster=output / "poster.jpg",
+        fanart=output / "fanart.jpg",
+        extrafanart_dir=output / "extrafanart",
+        nfo=output / "影片.nfo",
+        trailer=output / "trailer.mp4",
+    )
+    result = await execute_file_operations(
+        MediaFile(library_id=1, path=str(source)),
+        Metadata(number="IPSS-453", content_type=ContentType.CENSORED),
+        paths,
+        MoveMode.COPY,
+        resource_store,
+        parse_file_info(str(source)),
+        download_images=False,
+    )
+    assert result.outcome is PlaceOutcome.PLACED
+    root = ElementTree.parse(paths.nfo).getroot()
+    assert [element.text for element in root.findall("tag")] == ["中文字幕", "破解"]
