+def _actress_directory_tree(nodes: Sequence[_Node], *, is_directory: bool) -> tuple[_Node, ...]:
+    """按模板目录段替换演员占位符；可选组中的其他占位符即使为空也阻止替换。"""
+    segments: list[list[_Placeholder]] = [[]]
+
+    def collect(items: Sequence[_Node]) -> None:
+        for node in items:
+            if isinstance(node, _Literal):
+                if "/" in node.text or "\\" in node.text:
+                    segments.append([])
+            elif isinstance(node, _Placeholder):
+                segments[-1].append(node)
+            else:
+                collect(node.children)
+
+    collect(nodes)
+    # 同名占位符可以出现在不同目录，替换仅针对当前出现位置。
+    selected = {
+        id(node)
+        for segment in (segments if is_directory else segments[:-1])
+        if all(slot.name == "actresses" for slot in segment)
+        for node in segment
+    }
+
+    def replace_nodes(items: Sequence[_Node]) -> tuple[_Node, ...]:
+        result: list[_Node] = []
+        for node in items:
+            if isinstance(node, _Placeholder) and id(node) in selected:
+                result.append(_Placeholder(node.name, node.mapping, value_override="多人作品"))
+            elif isinstance(node, _Group):
+                result.append(_Group(replace_nodes(node.children), node.wrap))
+            else:
+                result.append(node)
+        return tuple(result)
+
+    return replace_nodes(nodes)
+
