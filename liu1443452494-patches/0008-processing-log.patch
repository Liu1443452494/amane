+        )
+    task = Task(id=82, type=TaskType.ORGANIZE, started_at=datetime.now(UTC), payload={"library_id": library.id})
+    with caplog.at_level(logging.INFO, logger="amane"), bound_contextvars(number="调用方上下文"):
+        recorder = Recorder.begin(tmp_path / "logs", task, HotSettings())
+        try:
+            result = await OrganizeHandler(repo, HotSettings(), resource_store).handle(
+                OrganizePayload(library_id=library.id, path=str(library_root))
