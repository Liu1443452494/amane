new file mode 100644
index 0000000..7e8cb0f
--- /dev/null
+++ b/src/amane/api/routes/liu1443452494_processing_log.py
@@ -0,0 +1,85 @@
+"""片库详情按番号读取最近可关联的刮削或整理记录，不新增任务关联表。"""
+
+from typing import Annotated
+
+from fastapi import APIRouter, HTTPException, Path
+
+from ...db.models import SortOrder, TaskSortField, TaskStatus, TaskType
+from ...observability.liu1443452494_processing_log import (
+    ProcessingLogResponse,
+    build_report,
+    read_log,
+    same_number,
+    task_number,
+    utc_time,
+)
+from ..deps import ConfigDep, RepoDep
+
+router = APIRouter(tags=["metadata"])
+
+
+@router.get("/metadata/{metadata_id}/processing-log")
+async def get_latest_processing_log(
+    metadata_id: Annotated[int, Path(ge=1)],
+    repo: RepoDep,
+    config: ConfigDep,
+) -> ProcessingLogResponse:
+    metadata = await repo.get_metadata(metadata_id)
+    if metadata is None:
+        raise HTTPException(status_code=404, detail="影片不存在")
+    response = ProcessingLogResponse(number=metadata.number)
+    # 先检查活跃任务；终态按结束时间倒序，以该时间作为批量任务中单片记录的上界。
+    for statuses, sort_by in (
+        ([TaskStatus.RUNNING, TaskStatus.QUEUED], TaskSortField.CREATED_AT),
+        ([TaskStatus.DONE, TaskStatus.FAILED], TaskSortField.FINISHED_AT),
+    ):
+        offset = 0
+        finished = False
+        while not finished:
+            tasks = await repo.list_tasks(
+                statuses=statuses,
+                task_types=[TaskType.SCRAPE, TaskType.ORGANIZE],
+                limit=50,
+                offset=offset,
+                sort_by=sort_by,
+                order=SortOrder.DESC,
+            )
+            if not tasks:
+                break
+            for task in tasks:
+                if task.id is None:
+                    continue
+                if (
+                    sort_by is TaskSortField.FINISHED_AT
+                    and task.finished_at is not None
+                    and response.record is not None
+                    and utc_time(task.finished_at) < response.record.last_activity_at
+                ):
+                    finished = True
+                    break
+                if task.type is TaskType.SCRAPE and not same_number(task_number(task), metadata.number):
+                    continue
+                if task.type is TaskType.ORGANIZE and task.started_at is None:
+                    continue
+                data = await read_log(config.cold.log_dir, task, metadata.number, metadata_id)
+                candidate = build_report(task, data)
+                if candidate is None:
+                    if data.notices:
+                        response.notices.append("部分整理日志缺失、无法读取或不完整，显示最近可确认归属的任务。")
+                    continue
+                if task.finished_at is not None:
+                    candidate.last_activity_at = min(candidate.last_activity_at, utc_time(task.finished_at))
+                if response.record is None or (candidate.last_activity_at, candidate.task_id) > (
+                    response.record.last_activity_at,
+                    response.record.task_id,
+                ):
+                    # 删除任务与读取日志可以并发；任务编号复用时不能返回上一条任务的记录。
+                    current = await repo.get_task(task.id)
+                    if current is not None and current.created_at == task.created_at:
+                        response.record = candidate
+            offset += len(tasks)
+            finished = finished or len(tasks) < 50
+    response.notices = list(dict.fromkeys(response.notices))
+    if response.record is None:
+        response.notices.append("暂无可关联的处理记录；旧整理日志未记录番号时无法确认归属。")
+    return response
