+        elif key == "outcome":
+            text = {"placed": "完成", "failed": "失败", "conflict": "目标冲突", "skipped": "跳过"}.get(text, text)
+        elif key == "mode":
+            text = {
+                "move": "移动",
+                "copy": "复制",
+                "hardlink": "硬链接",
+                "symlink": "符号链接",
+                "none": "原地整理",
+            }.get(text, text)
+        elif key == "source" and event.event.startswith("organize target"):
+            result.append(f"原路径：{text}")
+            continue
+        elif key in {"download_kinds", "copy_resources", "kinds", "locked_fields", "field"}:
+            names = {
+                "thumb": "封面",
+                "poster": "海报",
+                "fanart": "缩略图",
+                "extrafanart": "剧照",
+                "trailer": "预告片",
+                "thumb_urls": "封面地址",
+                "poster_urls": "海报地址",
+                "title": "标题",
+                "plot": "剧情",
+                "actors": "演员",
+                "tags": "标签",
+                "genres": "类型",
+            }
+            if isinstance(value, list):
+                text = (
+                    "、".join(
+                        names.get(item, _value_text(item)) if isinstance(item, str) else _value_text(item)
+                        for item in value
+                    )
+                    or "无"
+                )
+            elif isinstance(value, str):
+                text = names.get(value, text)
+        if len(text) > 16000:
+            text = text[:16000] + "……（本字段过长，剩余内容请查看原始任务记录）"
+        result.append(f"{labels[key]}：{text}")
+    url = event.text("url")
+    if url and event.value("asin") is None:
+        asin = re.search(
+            r"https?://(?:www\.)?(?:amazon\.co\.jp/(?:dp|gp/product)/|tenhow\.net/images/)([A-Z0-9]{10})(?:[/?#.]|$)",
+            url,
+        )
+        if asin:
+            result.insert(0, f"ASIN：{asin[1]}")
+    if _event_title(event.event) == "其他处理记录":
+        result.insert(0, f"原始事件：{_clean_text(event.event)}")
+    return result
+
+
+def _entry(event: LogEvent, task_type: TaskType) -> ProcessingLogEntry:
+    level: Literal["info", "warning", "error", "debug"] = "info"
+    if event.level.casefold() in {"error", "critical"} or event.value("outcome") == "failed":
+        level = "error"
+    elif event.level.casefold() == "warning" or event.value("outcome") == "conflict":
+        level = "warning"
+    elif event.level.casefold() == "debug":
+        level = "debug"
+    return ProcessingLogEntry(
+        timestamp=utc_time(event.timestamp) if event.timestamp else None,
+        level=level,
+        stage=_stage(event, task_type),
+        message=_event_title(event.event),
+        media_path=event.media_path,
+        details=_details(event),
+    )
+
+
+def build_report(task: Task, data: LogRead) -> ProcessingLogReport | None:
+    assert task.id is not None
+    if task.type is TaskType.ORGANIZE and not data.events:
+        return None
+    moments = [utc_time(event.timestamp) for event in data.events if event.timestamp is not None]
+    latest = max(moments, default=utc_time(task.started_at or task.created_at))
+    if task.type is TaskType.SCRAPE and task.finished_at is not None:
+        latest = max(latest, utc_time(task.finished_at))
+    report = ProcessingLogReport(
+        task_id=task.id,
+        task_type="scrape" if task.type is TaskType.SCRAPE else "organize",
+        status=task.status,
+        started_at=utc_time(task.started_at) if task.started_at else None,
+        finished_at=utc_time(task.finished_at) if task.finished_at else None,
+        last_activity_at=latest,
+        notices=data.notices,
+    )
+    ordered = sorted(
+        enumerate(data.events), key=lambda pair: (utc_time(pair[1].timestamp) if pair[1].timestamp else latest, pair[0])
+    )
+    for _, event in ordered:
+        if event.media_path:
+            if event.media_path != report.media_path:
+                report.target_path = None
+                report.file_outcome = None
+            report.media_path = event.media_path
+        if event.event in {"文件整理结果", "file operations done", "organize target occupied"}:
+            report.target_path = event.text("target_path") or event.text("dest")
+            outcome = event.text("outcome")
+            report.file_outcome = {"placed": "完成", "failed": "失败", "conflict": "目标冲突", "skipped": "跳过"}.get(
+                outcome or "", {"file operations done": "完成", "organize target occupied": "目标冲突"}.get(event.event)
+            )
+        elif event.event == "整理跳过文件":
+            report.file_outcome = "跳过"
+        elif event.event in {"文件整理异常", "file operations failed"}:
+            report.file_outcome = "失败"
+        report.entries.append(_entry(event, task.type))
+    for outcome in data.outcomes:
+        label = {"ok": "取得数据", "failed": "未取得可用数据", "cache_hit": "复用缓存"}[outcome.outcome]
+        details = [f"来源：{outcome.site}", f"结果：{label}"]
+        if outcome.reason:
+            details.append(f"原因：{_reason_text(outcome.reason)}")
+        if outcome.http_status:
+            details.append(f"HTTP 状态码：{outcome.http_status}")
+        if outcome.detail:
+            details.append(f"补充说明：{_clean_text(outcome.detail)}")
+        report.entries.append(
+            ProcessingLogEntry(
+                stage="来源汇总",
+                message=f"{outcome.site}：{label}",
+                details=details,
+                level="warning" if outcome.outcome == "failed" else "info",
+            )
+        )
+    if task.type is TaskType.SCRAPE:
+        if task.error:
+            report.entries.append(
+                ProcessingLogEntry(
+                    stage="任务结果", level="error", message="任务错误", details=[_clean_text(task.error)]
+                )
+            )
+        if not any(event.value("file_bytes") is not None for event in data.events):
+            report.notices.append("该次任务未记录图片尺寸与文件大小；不会使用当前图片替代历史数据。")
+        if report.media_path is None:
+            media_id = (task.payload or {}).get("media_file_id")
+            report.notices.append(
+                f"历史记录未保存媒体文件路径（媒体文件编号：{media_id}）。"
+                if media_id is not None
+                else "本次按番号处理影片信息，未指定媒体文件。"
+            )
+    else:
+        report.notices.append("仅展示当前番号的处理记录；顶部任务状态属于整个整理任务，文件结果单独显示。")
+        if report.media_path is None:
+            report.notices.append("历史整理记录未保存原文件路径。")
+    return report
