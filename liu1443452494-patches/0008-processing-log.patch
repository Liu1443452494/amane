+            task.status = TaskStatus.DONE
+            task.finished_at = datetime.now(UTC)
+            recorder.finalize(task, success=True, error=None, debug_capture=False)
+            assert get_contextvars()["number"] == "调用方上下文"
+        finally:
+            recorder.close()
+    assert result.result is not None and result.result.organized == 2
+    for number in numbers:
+        report = build_report(task, await read_log(tmp_path / "logs", task, number, 0))
+        assert report is not None
+        assert report.media_path == str(library_root / f"{number}.mp4")
+        assert report.file_outcome == "完成"
+        assert any(entry.message == "NFO 已写入" for entry in report.entries)
+        other = next(value for value in numbers if value != number)
+        assert str(library_root / f"{other}.mp4") not in report.model_dump_json()
