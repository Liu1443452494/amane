+"""详情日志按实际单片处理时间选取，包含子任务、失败与历史缺失情况。"""
+
+from datetime import UTC, datetime, timedelta
+from pathlib import Path
+from typing import TYPE_CHECKING
+from unittest.mock import patch
+
+import pytest
+
+from amane.db.models import Task, TaskStatus, TaskType
+from amane.observability.liu1443452494_processing_log import LogEvent, ProcessingLogResponse
+from tests.observability.test_liu1443452494_processing_log import write_events
+
+if TYPE_CHECKING:
+    from fastapi import FastAPI
+    from httpx2 import AsyncClient
+
+    from amane.db.repository import Repository
+
+
+async def recorded_task(
+    repo: Repository, kind: TaskType, start: datetime, finish: datetime, number: str | None = None
+) -> Task:
+    task = await repo.create_task(kind, {"number": number} if number else {"library_id": 1})
+    assert task.id is not None
+    with patch("amane.db.repos.tasks._utcnow", return_value=start):
+        claimed = await repo.claim_next_task()
+    assert claimed is not None and claimed.id == task.id
+    with patch("amane.db.repos.tasks._utcnow", return_value=finish):
+        await repo.complete_task(task.id)
+    saved = await repo.get_task(task.id)
+    assert saved is not None
+    return saved
+
+
+@pytest.mark.asyncio(loop_scope="function")
+async def test_latest_record_scope_pagination_failure_and_missing(
+    client: AsyncClient,
+    repo: Repository,
+    app: FastAPI,
+    stop_worker: None,
+    tmp_path: Path,
+) -> None:
+    metadata = await repo.upsert_metadata(number="ABP-901")
+    assert metadata.id is not None
+    endpoint = f"metadata/{metadata.id}/processing-log"
+    for path, status in (("metadata/0/processing-log", 422), ("metadata/99999/processing-log", 404), (endpoint, 200)):
+        response = await client.get(path)
+        assert response.status_code == status
+    assert ProcessingLogResponse.model_validate(response.json()).record is None
+
+    logs = tmp_path / "logs"
+    base = datetime.now(UTC)
+    batch = await recorded_task(repo, TaskType.ORGANIZE, base, base + timedelta(seconds=10))
+    scrape = await recorded_task(
+        repo, TaskType.SCRAPE, base + timedelta(seconds=3), base + timedelta(seconds=4), "abp-901"
+    )
+    assert batch.id is not None and scrape.id is not None
+    events = [
+        LogEvent.model_validate(
+            {
+                "event": "文件整理结果",
+                "task_id": batch.id,
+                "timestamp": base + timedelta(seconds=2),
+                "number": "ABP-901",
+                "media_path": "/库/本片.mp4",
+                "target_path": "/输出/本片.mp4",
+                "outcome": "placed",
+            }
+        ),
+        LogEvent.model_validate(
+            {
+                "event": "文件整理结果",
+                "task_id": batch.id,
+                "timestamp": base + timedelta(seconds=9),
+                "number": "ABP-9010",
+                "media_path": "/库/其他片.mp4",
+                "target_path": "/输出/其他片.mp4",
+                "outcome": "failed",
+            }
+        ),
+    ]
+    write_events(logs, batch.id, events)
+    result = ProcessingLogResponse.model_validate((await client.get(endpoint)).json())
+    assert result.record is not None and result.record.task_id == scrape.id
+
+    events.append(
+        LogEvent.model_validate(
+            {
+                "event": "文件整理结果",
+                "task_id": batch.id,
+                "timestamp": base + timedelta(seconds=8),
+                "number": "ABP-901",
+                "media_path": "/库/本片另一份.mp4",
+                "target_path": "/输出/本片另一份.mp4",
+                "outcome": "conflict",
+            }
+        )
+    )
+    write_events(logs, batch.id, events)
+    result = ProcessingLogResponse.model_validate((await client.get(endpoint)).json())
+    assert result.record is not None and result.record.task_id == batch.id
+    assert result.record.media_path == "/库/本片另一份.mp4"
+    assert result.record.file_outcome == "目标冲突"
+    assert "其他片" not in result.model_dump_json()
+
+    # 超过一页的无关任务不能让真正相关的记录消失。
+    unrelated = await repo.create_tasks(TaskType.SCRAPE, [{"number": f"OTHER-{index}"} for index in range(51)])
+    with patch("amane.db.repos.tasks._utcnow", return_value=base + timedelta(seconds=20)):
+        for task in unrelated:
+            assert task.id is not None
+            await repo.complete_task(task.id)
+    result = ProcessingLogResponse.model_validate((await client.get(endpoint)).json())
+    assert result.record is not None and result.record.task_id == batch.id
+
+    failed = await recorded_task(
+        repo, TaskType.SCRAPE, base + timedelta(seconds=22), base + timedelta(seconds=23), "ABP-901"
+    )
+    assert failed.id is not None
+    with patch("amane.db.repos.tasks._utcnow", return_value=base + timedelta(seconds=24)):
+        await repo.fail_task(failed.id, "站点请求失败")
+    result = ProcessingLogResponse.model_validate((await client.get(endpoint)).json())
+    assert result.record is not None and result.record.task_id == failed.id
+    assert result.record.status is TaskStatus.FAILED
+    assert "站点请求失败" in result.model_dump_json()
+    await repo.delete_task(failed.id)
+    result = ProcessingLogResponse.model_validate((await client.get(endpoint)).json())
+    assert result.record is not None and result.record.task_id == batch.id
+
+    parent = await repo.create_task(TaskType.REFRESH, {"library_id": 1})
+    assert parent.id is not None
+    with patch("amane.db.repos.tasks._utcnow", return_value=base + timedelta(seconds=30)):
+        await repo.claim_next_task()
+        children = await repo.complete_task_with_followups(
+            parent.id,
+            None,
+            [("scrape:1", TaskType.SCRAPE, {"number": "ABP-901"}, 0)],
+        )
+    assert len(children) == 1 and children[0].id is not None
+    with patch("amane.db.repos.tasks._utcnow", return_value=base + timedelta(seconds=31)):
+        await repo.claim_next_task()
+    with patch("amane.db.repos.tasks._utcnow", return_value=base + timedelta(seconds=32)):
+        await repo.complete_task(children[0].id)
+    result = ProcessingLogResponse.model_validate((await client.get(endpoint)).json())
+    assert result.record is not None and result.record.task_id == children[0].id
+
+    active = await repo.create_task(TaskType.SCRAPE, {"number": "ABP-901", "media_file_id": 5})
+    assert active.id is not None
+    with patch("amane.db.repos.tasks._utcnow", return_value=base + timedelta(seconds=33)):
+        await repo.claim_next_task()
+    write_events(
+        logs,
+        active.id,
+        [LogEvent(event="刮削对象", timestamp=base + timedelta(seconds=34), media_path="/库/当前文件.mp4")],
+    )
+    result = ProcessingLogResponse.model_validate((await client.get(endpoint)).json())
+    assert result.record is not None and result.record.task_id == active.id
+    assert result.record.status is TaskStatus.RUNNING
+    assert result.record.media_path == "/库/当前文件.mp4"
