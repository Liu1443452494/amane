+"""历史日志的归属、中文内容、缺失信息与异常输入。"""
+
+import json
+import sys
+from datetime import UTC, datetime, timedelta
+from pathlib import Path
+from typing import Literal
+
+import pytest
+
+from amane.db.models import Task, TaskStatus, TaskType
+from amane.net.errors import FailureReason
+from amane.observability.liu1443452494_processing_log import LogEvent, LogRead, build_report, read_log
+from amane.observability.models import SiteOutcomeKind, SiteOutcomeRecord
+from amane.observability.recorder import task_dir_for
+from tests.helpers import make_junction
+
+
+def write_events(log_dir: Path, task_id: int, events: list[LogEvent]) -> Path:
+    directory = task_dir_for(log_dir, task_id)
+    directory.mkdir(parents=True, exist_ok=True)
+    path = directory / "task.log"
+    path.write_text("".join(event.model_dump_json() + "\n" for event in events), encoding="utf-8")
+    return path
+
+
+@pytest.mark.parametrize("kind", [TaskType.SCRAPE, TaskType.ORGANIZE])
+def test_reader_excludes_other_numbers_reused_ids_and_invalid_lines(tmp_path: Path, kind: TaskType) -> None:
+    started = datetime(2026, 10, 30, tzinfo=UTC)
+    task = Task(id=4, type=kind, started_at=started, payload={"number": "ABP-901"}, status=TaskStatus.DONE)
+    events = [
+        LogEvent(event="旧记录", task_id=4, number="ABP-901", timestamp=started - timedelta(seconds=1)),
+        LogEvent(event="其他番号", task_id=4, number="ABP-9010", timestamp=started),
+        LogEvent(event="其他任务", task_id=5, number="ABP-901", timestamp=started),
+        LogEvent(event="缺少时间", task_id=4, number="ABP-901"),
+        LogEvent(event="文件整理开始", task_id=4, number="abp-901", media_path="/库/甲.mp4", timestamp=started),
+        LogEvent(event="未标明番号", task_id=4, timestamp=started),
+    ]
+    path = write_events(tmp_path, 4, events)
+    with path.open("ab") as stream:
+        stream.write(b'{broken\n{"event":42}\n' + b"x" * (512 * 1024 + 2) + b"\n")
+    data = read_log.sync(tmp_path, task, "ABP-901", 1)
+    assert [event.event for event in data.events] == (
+        ["文件整理开始", "未标明番号"] if kind is TaskType.SCRAPE else ["文件整理开始"]
+    )
