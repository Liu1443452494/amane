+@pytest.mark.parametrize("limit", ["bytes", "entries"])
+def test_large_log_keeps_recent_events_and_explains_omissions(
+    tmp_path: Path, limit: Literal["bytes", "entries"]
+) -> None:
+    started = datetime(2026, 10, 30, tzinfo=UTC)
+    task = Task(id=12, type=TaskType.ORGANIZE, started_at=started)
+    latest = LogEvent(event="最近记录", timestamp=started, number="ABP-901", media_path="/库/最近.mp4")
+    path = write_events(tmp_path, 12, [latest])
+    if limit == "bytes":
+        with path.open("wb") as stream:
+            stream.seek(33 * 1024 * 1024)
+            stream.write(b"\n" + latest.model_dump_json().encode("utf-8") + b"\n")
+    else:
+        with path.open("wb") as stream:
+            old = LogEvent(event="较早记录", timestamp=started, number="ABP-901", media_path="/库/较早.mp4")
+            stream.write((old.model_dump_json().encode("utf-8") + b"\n") * 10005)
+            stream.write(latest.model_dump_json().encode("utf-8") + b"\n")
+    result = read_log.sync(tmp_path, task, "ABP-901", 1)
+    assert result.events[-1] == latest
+    assert any("32 MiB" in notice if limit == "bytes" else "省略 6 条" in notice for notice in result.notices)
+    report = build_report(task, result)
+    assert report is not None and report.media_path == "/库/最近.mp4"
