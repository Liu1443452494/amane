+import { Alert, Badge, Button, Group, Modal, Paper, Stack, Text } from "@mantine/core";
+import { IconFileText, IconRefresh } from "@tabler/icons-react";
+import { useQuery } from "@tanstack/react-query";
+import { useState } from "react";
+import { Virtuoso } from "react-virtuoso";
+import { getLatestProcessingLogOptions } from "@/client/@tanstack/react-query.gen";
+import type { ProcessingLogEntry } from "@/client/types.gen";
+import { extractErrorMessage } from "@/lib/api-error";
+
+/** 报告始终属于当前番号；重新打开时查询最新记录，关闭后停止轮询。 */
+export function ProcessingLogButton({ metadataId }: { metadataId: number }) {
+  const [opened, setOpened] = useState(false);
+  const query = useQuery({
+    ...getLatestProcessingLogOptions({ path: { metadata_id: metadataId } }),
+    enabled: opened,
+    staleTime: 0,
+    refetchOnWindowFocus: false,
+    refetchInterval: (state) =>
+      opened &&
+      (state.state.data?.record?.status === "running" ||
+        state.state.data?.record?.status === "queued")
+        ? 3000
+        : false,
+  });
+  const record = query.data?.record;
+  const statuses = { queued: "排队中", running: "进行中", done: "已完成", failed: "失败" };
+
+  return (
+    <>
+      <Button
+        size="xs"
+        variant="light"
+        leftSection={<IconFileText size={14} />}
+        onClick={() => setOpened(true)}
+      >
+        处理日志
+      </Button>
+      <Modal
+        opened={opened}
+        onClose={() => setOpened(false)}
+        title="最近处理记录"
+        size="xl"
+        centered
+      >
+        <Stack gap="sm">
+          <Group justify="space-between">
+            <Text fw={600}>{query.data?.number ?? "正在读取记录"}</Text>
+            <Button
+              size="xs"
+              variant="subtle"
+              leftSection={<IconRefresh size={14} />}
+              loading={query.isFetching}
+              onClick={() => void query.refetch()}
+            >
+              刷新
+            </Button>
+          </Group>
+          {query.isPending && <Text c="dimmed">正在读取本地任务日志……</Text>}
+          {query.isError && (
+            <Alert color="red" title="日志读取失败">
+              {extractErrorMessage(query.error, "无法读取处理日志")}
+            </Alert>
+          )}
+          {query.data?.notices?.map((notice) => (
+            <Alert key={notice} color="yellow">
+              {notice}
+            </Alert>
+          ))}
+          {record && (
+            <>
+              <Group gap="xs">
+                <Badge>{record.task_type === "scrape" ? "刮削" : "整理"}</Badge>
+                <Badge
+                  color={
+                    record.status === "failed" ? "red" : record.status === "done" ? "teal" : "blue"
+                  }
+                >
+                  任务{statuses[record.status]}
+                </Badge>
+                <Text size="sm">任务 #{record.task_id}</Text>
+                <Text size="sm" c="dimmed">
+                  {new Date(record.last_activity_at).toLocaleString("zh-CN")}
+                </Text>
+              </Group>
+              <Paper withBorder p="sm" radius="sm">
+                <Text size="sm" fw={700}>
+                  最近处理的文件
+                </Text>
+                <Text size="sm" style={{ overflowWrap: "anywhere" }}>
+                  {record.media_path ?? "本次记录未提供文件路径"}
+                </Text>
+                {record.target_path && (
+                  <>
+                    <Text size="sm" fw={700} mt="xs">
+                      目标路径
+                    </Text>
+                    <Text size="sm" style={{ overflowWrap: "anywhere" }}>
+                      {record.target_path}
+                    </Text>
+                  </>
+                )}
+                {record.file_outcome && (
+                  <Text size="sm" mt="xs">
+                    此文件处理结果：{record.file_outcome}
+                  </Text>
+                )}
+              </Paper>
+              {record.notices?.map((notice) => (
+                <Text key={notice} size="sm" c="dimmed">
+                  {notice}
+                </Text>
+              ))}
+              {!record.entries?.length ? (
+                <Text c="dimmed">该任务暂无可显示的过程日志。</Text>
+              ) : (
+                <Virtuoso
+                  style={{ height: "min(52vh, 620px)", minHeight: 240 }}
+                  data={record.entries}
+                  itemContent={renderProcessingEntry}
+                />
+              )}
+            </>
+          )}
+        </Stack>
+      </Modal>
+    </>
+  );
+}
+
+function renderProcessingEntry(_index: number, entry: ProcessingLogEntry) {
+  return <ProcessingEntry entry={entry} />;
+}
+
+function ProcessingEntry({ entry }: { entry: ProcessingLogEntry }) {
+  const colors = { info: "blue", warning: "orange", error: "red", debug: "gray" };
+  return (
+    <Paper withBorder p="sm" radius="sm" mb="xs">
+      <Group gap="xs" mb={4}>
+        <Badge size="xs" color={colors[entry.level ?? "info"]}>
+          {entry.stage}
+        </Badge>
+        {entry.timestamp && (
+          <Text size="xs" c="dimmed">
+            {new Date(entry.timestamp).toLocaleTimeString("zh-CN")}
+          </Text>
+        )}
+        <Text size="sm" fw={600}>
+          {entry.message}
+        </Text>
+      </Group>
+      {entry.media_path && (
+        <Text size="xs" c="dimmed" style={{ overflowWrap: "anywhere" }}>
+          处理文件：{entry.media_path}
+        </Text>
+      )}
+      {entry.details?.map((detail, index) => (
+        <Text
+          key={`${index}:${detail}`}
+          size="sm"
+          style={{ whiteSpace: "pre-wrap", overflowWrap: "anywhere" }}
+        >
+          {detail}
+        </Text>
+      ))}
+    </Paper>
+  );
+}
