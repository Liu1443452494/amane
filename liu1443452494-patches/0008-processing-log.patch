@@ -0,0 +1,44 @@
+"""自用处理记录：为文件操作附加番号与历史路径，图片度量失败不改变处理结果。"""
+
+from collections.abc import Generator
+from contextlib import contextmanager
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+from structlog.contextvars import bound_contextvars
+
+from ..media.images import probe_size
+from .recorder import current
+
+if TYPE_CHECKING:
+    from ..db.models import MediaFile
+
+
+@contextmanager
+def file_processing(number: str, media: MediaFile) -> Generator[None]:
+    with bound_contextvars(number=number, media_path=media.path, media_file_id=media.id):
+        current().info("文件整理开始")
+        try:
+            yield
+        except Exception:
+            current().exception("文件整理异常")
+            raise
+
+
+def record_copied_file(source: Path, target: Path) -> None:
+    try:
+        file_bytes = target.stat().st_size
+        dimensions = (
+            probe_size(target)
+            if target.suffix.lower() in {".jpg", ".jpeg", ".png", ".webp", ".gif", ".avif", ".bmp"}
+            else None
+        )
+        current().info(
+            "资源已复制",
+            source_path=str(source),
+            target_path=str(target),
+            file_bytes=file_bytes,
+            dimensions=dimensions,
+        )
+    except OSError as exc:
+        current().warning("资源已复制但大小读取失败", source_path=str(source), target_path=str(target), error=str(exc))
