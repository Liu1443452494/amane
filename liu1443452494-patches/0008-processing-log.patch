+
+@pytest.mark.asyncio
+async def test_image_report_records_actual_measurements_and_asin_at_info(
+    resource_store: ResourceStore,
+    tmp_path: Path,
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    setup_logging("INFO")
+    thumbnail = "https://images.test/thumb.jpg"
+    amazon = "https://m.media-amazon.com/images/I/poster.jpg"
+    tenhow = "https://www.tenhow.net/images/B000000001.jpg"
+    client = PosterClient(
+        pages={
+            "https://www.tenhow.net/mokuji.html": '<a href="kaede.html">楓カレン</a>',
+            "https://www.tenhow.net/kaede.html": tenhow_block(),
+            "https://www.amazon.co.jp/dp/B000000001": product_html(amazon),
+        },
+        images={
+            thumbnail: image_bytes((800, 540)),
+            tenhow: image_bytes((1055, 1500), 100000),
+            amazon: image_bytes((1784, 2535), 366664),
+        },
+    )
+    config = HotSettings()
+    config.scraping.download_resources = [DownloadableResource.thumb, DownloadableResource.poster]
+    config.scraping.crop_poster = True
+    task = Task(id=81, type=TaskType.SCRAPE, started_at=datetime.now(UTC), payload={"number": "IPZZ-396"})
+    with caplog.at_level(logging.INFO, logger="amane"), bound_contextvars(number="IPZZ-396"):
+        recorder = Recorder.begin(tmp_path / "logs", task, config)
+        try:
+            result = await materialize_images(
+                [],
+                [thumbnail],
+                [],
+                resource_store,
+                cast(WebClient, client),
+                config,
+                tmp_path,
+                poster_query=poster_query(),
+            )
+            task.status = TaskStatus.DONE
+            task.finished_at = datetime.now(UTC)
+            recorder.finalize(task, success=True, error=None, debug_capture=False)
+        finally:
+            recorder.close()
+    assert result.poster_urls[0] == amazon
+    report = build_report(task, await read_log(tmp_path / "logs", task, "IPZZ-396", 1))
+    assert report is not None
+    text = report.model_dump_json()
+    for expected in (
+        "B000000001",
+        "1784 × 2535",
+        "366,664 字节",
+        "Tenhow 作品匹配成功",
+        "海报裁剪判断",
+        "跳过标题搜索",
+        "最终海报地址",
+    ):
+        assert expected in text
+    assert not (tmp_path / "logs" / "tasks" / "task-81" / "http").exists()
+
+
+@pytest.mark.asyncio
+async def test_organize_records_per_file_paths_and_restores_context(
+    repo: Repository,
+    resource_store: ResourceStore,
+    tmp_path: Path,
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    setup_logging("INFO")
+    library_root = tmp_path / "库"
+    library_root.mkdir()
+    library = await repo.create_library(
+        name="测试",
+        path=str(library_root),
+        write_nfo=True,
+        move_mode=MoveMode.MOVE,
+        video_template="{number}/{number}",
+        min_file_size=0,
+    )
+    assert library.id is not None
+    numbers = ["ABP-901", "ABP-9010"]
+    for number in numbers:
+        metadata = await repo.upsert_metadata(number=number)
+        path = library_root / f"{number}.mp4"
+        path.write_bytes(b"video")
+        await repo.create_media_file(
