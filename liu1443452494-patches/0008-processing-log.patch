@@ -0,0 +1,554 @@
+"""按任务读取本地 JSON 日志并生成中文说明；历史数据缺失时不查询现有图片补值。"""
+
+import json
+import re
+from collections import deque
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Literal
+from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit
+
+from pydantic import BaseModel, ConfigDict, Field, JsonValue, ValidationError
+
+from ..db.models import Task, TaskStatus, TaskType
+from ..utils.threads import in_thread
+from .models import SiteOutcomeRecord, TaskSnapshot, TaskSummary
+from .recorder import task_dir_for
+
+
+class ProcessingLogEntry(BaseModel):
+    timestamp: datetime | None = None
+    level: Literal["info", "warning", "error", "debug"] = "info"
+    stage: str
+    message: str
+    media_path: str | None = None
+    details: list[str] = Field(default_factory=list)
+
+
+class ProcessingLogReport(BaseModel):
+    task_id: int
+    task_type: Literal["scrape", "organize"]
+    status: TaskStatus
+    started_at: datetime | None = None
+    finished_at: datetime | None = None
+    last_activity_at: datetime
+    media_path: str | None = None
+    target_path: str | None = None
+    file_outcome: str | None = None
+    entries: list[ProcessingLogEntry] = Field(default_factory=list)
+    notices: list[str] = Field(default_factory=list)
+
+
+class ProcessingLogResponse(BaseModel):
+    number: str
+    record: ProcessingLogReport | None = None
+    notices: list[str] = Field(default_factory=list)
+
+
+class LogEvent(BaseModel):
+    model_config = ConfigDict(extra="allow")
+    # Pydantic 要求以非空字典标注额外字段，所有值仍经 JsonValue 校验。
+    __pydantic_extra__: dict[str, JsonValue] = Field(init=False)  # ty: ignore[invalid-mutable-override]
+
+    event: str
+    timestamp: datetime | None = None
+    level: str = "info"
+    task_id: int | None = None
+    number: str | None = None
+    metadata_id: int | None = None
+    media_path: str | None = None
+
+    def value(self, key: str) -> JsonValue:
+        return (self.__pydantic_extra__ or {}).get(key)
+
+    def text(self, key: str) -> str | None:
+        value = self.value(key)
+        return value if isinstance(value, str) and value else None
+
+
+class LogRead(BaseModel):
+    events: list[LogEvent] = Field(default_factory=list)
+    outcomes: list[SiteOutcomeRecord] = Field(default_factory=list)
+    notices: list[str] = Field(default_factory=list)
+
+
+def utc_time(value: datetime) -> datetime:
+    return value.replace(tzinfo=UTC) if value.tzinfo is None else value.astimezone(UTC)
+
+
+def same_number(left: str | None, right: str) -> bool:
+    return left is not None and left.strip().casefold() == right.strip().casefold()
+
+
+def task_number(task: Task) -> str | None:
+    value = (task.payload or {}).get("number")
+    return value if isinstance(value, str) else None
+
+
+def _safe_path(log_dir: Path, task_id: int, filename: str) -> Path:
+    root = log_dir.resolve()
+    path = task_dir_for(log_dir, task_id) / filename
+    if not path.resolve().is_relative_to(root):
+        raise ValueError("任务日志路径超出日志目录")
+    return path
+
+
+def _matches(event: LogEvent, task: Task, number: str, metadata_id: int) -> bool:
+    if event.task_id is not None and event.task_id != task.id:
+        return False
+    if task.started_at is None or event.timestamp is None:
+        return False
+    if event.timestamp is not None and utc_time(event.timestamp) < utc_time(task.started_at):
+        return False
+    if event.number is not None:
+        return same_number(event.number, number)
+    if task.type is TaskType.SCRAPE:
+        return same_number(task_number(task), number)
+    return event.metadata_id == metadata_id
+
+
+def _read_outcomes(log_dir: Path, task: Task) -> list[SiteOutcomeRecord]:
+    if task.type is not TaskType.SCRAPE or task.id is None:
+        return []
+    values = (task.result or {}).get("outcomes")
+    if isinstance(values, list):
+        try:
+            return [SiteOutcomeRecord.model_validate(value) for value in values]
+        except ValidationError:
+            pass
+    try:
+        snapshot_path = _safe_path(log_dir, task.id, "task.json")
+        summary_path = _safe_path(log_dir, task.id, "summary.json")
+        if snapshot_path.stat().st_size > 2 * 1024 * 1024 or summary_path.stat().st_size > 2 * 1024 * 1024:
+            return []
+        snapshot = TaskSnapshot.model_validate_json(snapshot_path.read_bytes())
+        if (
+            snapshot.id != task.id
+            or snapshot.started_at is None
+            or task.started_at is None
+            or utc_time(snapshot.started_at) != utc_time(task.started_at)
+        ):
+            return []
+        return list(TaskSummary.model_validate_json(summary_path.read_bytes()).outcomes.values())
+    except OSError, ValueError:
+        return []
+
+
+@in_thread
+def read_log(log_dir: Path, task: Task, number: str, metadata_id: int) -> LogRead:
+    assert task.id is not None
+    out = LogRead(outcomes=_read_outcomes(log_dir, task))
+    rows: deque[LogEvent] = deque(maxlen=10000)
+    invalid = 0
+    matched = 0
+    try:
+        path = _safe_path(log_dir, task.id, "task.log")
+        with path.open("rb") as stream:
+            size = path.stat().st_size
+            if size > 32 * 1024 * 1024:
+                stream.seek(size - 32 * 1024 * 1024)
+                stream.readline()
+                out.notices.append("任务日志超过 32 MiB，仅读取末尾部分，较早记录可能缺失。")
+            while raw := stream.readline(512 * 1024 + 1):
+                if len(raw) > 512 * 1024:
+                    while raw and not raw.endswith(b"\n"):
+                        raw = stream.readline(512 * 1024 + 1)
+                    invalid += 1
+                    continue
+                try:
+                    event = LogEvent.model_validate_json(raw)
+                except ValueError:
+                    invalid += 1
+                    continue
+                if _matches(event, task, number, metadata_id):
+                    matched += 1
+                    rows.append(event)
+    except FileNotFoundError:
+        out.notices.append("该任务的过程日志不存在或已被清除。")
+    except OSError, ValueError:
+        out.notices.append("无法读取该任务的过程日志。")
+    if invalid:
+        out.notices.append(f"有 {invalid} 条日志不完整、格式无效或超过长度限制，已跳过。")
+    if matched > len(rows):
+        out.notices.append(f"仅展示最近 {len(rows)} 条相关记录，省略 {matched - len(rows)} 条较早记录。")
+    out.events = list(rows)
+    return out
+
+
+def _secret_key(value: str) -> bool:
+    return any(
+        part in value.casefold().replace("-", "_")
+        for part in (
+            "token",
+            "secret",
+            "password",
+            "cookie",
+            "authorization",
+            "credential",
+            "api_key",
+            "apikey",
+            "signature",
+            "dsn",
+        )
+    )
+
+
+def _redact_url(match: re.Match[str]) -> str:
+    try:
+        parts = urlsplit(match.group())
+        netloc = parts.netloc.rsplit("@", 1)[-1]
+        query = urlencode(
+            [
+                (key, "***" if _secret_key(key) else value)
+                for key, value in parse_qsl(parts.query, keep_blank_values=True)
+            ]
+        )
+        return urlunsplit((parts.scheme, netloc, parts.path, query, parts.fragment))
+    except ValueError:
+        return "[无效地址]"
+
+
+def _clean_text(value: str) -> str:
+    value = re.sub(r"https?://[^\s\"<>]+", _redact_url, value)
+    value = re.sub(r"(?i)(Bearer\s+)[A-Za-z0-9._~+/-]+=*", r"\1***", value)
+    return re.sub(
+        r"(?i)((?:password|api[_-]?key|token|secret|cookie|authorization)\s*[=:]\s*)[^\s,;&]+", r"\1***", value
+    )
+
+
+def _clean_value(value: JsonValue) -> JsonValue:
+    if isinstance(value, str):
+        return _clean_text(value)
+    if isinstance(value, list):
+        return [_clean_value(item) for item in value]
+    if isinstance(value, dict):
+        return {key: "***" if _secret_key(key) else _clean_value(item) for key, item in value.items()}
+    return value
+
+
+def _value_text(value: JsonValue) -> str:
+    if value is None:
+        return "未记录"
+    if isinstance(value, bool):
+        return "是" if value else "否"
+    if isinstance(value, str):
+        return _clean_text(value)
+    return json.dumps(_clean_value(value), ensure_ascii=False)
+
+
+def _reason_text(reason: str) -> str:
+    return {
+        "no_usable_metadata": "未取得可用元数据",
+        "timeout": "请求超时",
+        "network_error": "网络请求失败",
+        "network": "网络连接失败",
+        "api_error": "站点接口返回业务错误",
+        "not_found": "未找到资源",
+        "server_error": "站点服务器异常",
+        "cloudflare_challenge": "遇到 Cloudflare 验证页面",
+        "cloudflare_blocked": "请求被 Cloudflare 拦截",
+        "ip_banned": "站点限制当前 IP 访问",
+        "geo_restricted": "站点限制当前地区访问",
+        "empty_response": "站点返回空内容",
+        "crawler_unavailable": "来源当前不可用",
+        "http_error": "HTTP 请求失败",
+        "parse_error": "返回内容解析失败",
+        "unexpected": "发生未预期的错误",
+        "cloudflare": "遇到 Cloudflare 验证或访问限制",
+        "captcha": "遇到验证码",
+        "age_verification": "需要年龄确认",
+        "geo_blocked": "站点限制当前地区访问",
+        "login_required": "需要登录",
+        "rate_limited": "请求频率受限",
+    }.get(reason, reason)
+
+
+def _event_title(event: str) -> str:
+    names = {
+        "task started": "任务开始",
+        "task completed": "任务完成",
+        "task failed": "任务失败",
+        "scraping started": "开始获取影片信息",
+        "scrape completed": "刮削完成",
+        "scrape ok": "来源刮削成功",
+        "search hit": "找到作品页面",
+        "search miss": "未找到匹配的作品页面",
+        "source returned no usable metadata": "来源未返回可用元数据",
+        "source failed": "来源获取失败",
+        "site cache hit": "复用来源缓存",
+        "request retry": "请求失败，准备重试",
+        "request failed": "请求失败",
+        "http exchange": "HTTP 请求结果",
+        "images materialized": "图片处理完成，确定最终地址",
+        "image materialization failed, keeping raw urls": "图片处理异常，保留已有地址",
+        "translation failed, keeping original": "翻译失败，保留原文",
+        "field translated": "字段翻译完成",
+        "no eligible crawlers for content type": "该内容类型没有可用来源",
+        "no crawlers available": "没有可调用的来源",
+        "no data found from any source": "所有来源均未取得可用数据",
+        "resource download failed": "资源下载失败",
+        "resource is upstream placeholder": "资源地址返回占位图，已排除",
+        "resource file missing, invalidating record": "资源文件不存在，清除失效缓存",
+        "probe_size failed": "图片尺寸读取失败",
+        "file operations done": "文件整理完成",
