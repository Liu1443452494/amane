diff --git a/src/amane/media/liu1443452494_image_quality.py b/src/amane/media/liu1443452494_image_quality.py
new file mode 100644
index 0000000..c0b0149
--- /dev/null
+++ b/src/amane/media/liu1443452494_image_quality.py
@@ -0,0 +1,122 @@
+"""封面与海报的完整解码、文件大小排序及失败回退。"""
+
+from pathlib import Path
+from typing import TYPE_CHECKING
+from urllib.parse import urlsplit
+
+import structlog
+from PIL import Image
+from pydantic import BaseModel
+
+from .resource_store import internal_url_hash
+
+if TYPE_CHECKING:
+    from collections.abc import Sequence
+
+    from ..net.http import WebClient
+    from .resource_store import ResourceStore
+
+
+class ImageCandidate(BaseModel):
+    url: str
+    locator: str
+    path: Path
+    file_bytes: int
+    dimensions: tuple[int, int]
+
+
+def inspect_image(url: str, locator: str, path: Path) -> ImageCandidate | None:
+    """完整解码后量取文件；HTML、截断图片与无法读取的文件不能参与排序。"""
+    try:
+        with Image.open(path) as image:
+            image.load()
+            dimensions = image.size
+        size = path.stat().st_size
+        if size <= 0 or min(dimensions) <= 0:
+            return None
+        return ImageCandidate(url=url, locator=locator, path=path, file_bytes=size, dimensions=dimensions)
+    except (OSError, ValueError, SyntaxError, Image.DecompressionBombError) as exc:
+        structlog.get_logger().warning("图片校验失败", url=url, error=str(exc))
+        return None
+
+
+def dimensions_improve(candidate: tuple[int, int], current: tuple[int, int] | None) -> bool:
+    """宽高均不减小且至少一项增大时允许裁剪替换。"""
+    return min(candidate) > 0 and (
+        current is None or (candidate[0] >= current[0] and candidate[1] >= current[1] and candidate != current)
+    )
+
+
+class ImagePool:
+    def __init__(self, store: ResourceStore, client: WebClient, *, prefer_amazon: bool = False) -> None:
+        self._store = store
+        self._client = client
+        self._prefer_amazon = prefer_amazon
+        self._attempts: dict[str, ImageCandidate | None] = {}
+
+    async def acquire(self, urls: Sequence[str]) -> bool:
+        """每个地址仅处理一次；返回本组地址是否存在有效图片。"""
+        success = False
+        for url in urls:
+            if url not in self._attempts:
+                self._attempts[url] = None
+                try:
+                    source = await self._store.resolve_source(url, self._client)
+                    if source is not None:
+                        candidate = inspect_image(url, source.locator, source.path)
+                        self._attempts[url] = candidate
+                        if candidate is None:
+                            # 无效响应不能作为永久缓存阻止后续任务重试。
+                            await self._store.invalidate(source.locator)
+                except Exception as exc:
+                    structlog.get_logger().warning("图片候选获取失败", url=url, error=str(exc))
+            success = self._attempts[url] is not None or success
+        return success
+
+    async def restore_cached(self, urls: Sequence[str]) -> None:
+        """本次没有有效图片时读取旧资源，不重新请求旧地址。"""
+        if self.best is not None:
+            return
+        for url in urls:
+            try:
+                token = internal_url_hash(url)
+                if token is not None:
+                    found = await self._store.get_by_url_hash(token)
+                    path = found[1] if found else None
+                    locator = found[0].url if found else url
+                else:
+                    path = await self._store.resolve(url)
+                    locator = url
+                if path is not None:
+                    candidate = inspect_image(url, locator, path)
+                    if candidate is not None:
+                        self._attempts[url] = candidate
+            except Exception as exc:
+                structlog.get_logger().warning("旧图片读取失败", url=url, error=str(exc))
+
+    def _ranked(self) -> list[ImageCandidate]:
+        candidates = [candidate for candidate in self._attempts.values() if candidate is not None]
+        return sorted(
+            candidates,
+            key=lambda candidate: (
+                -candidate.file_bytes,
+                -int(
+                    self._prefer_amazon
+                    and urlsplit(candidate.url).hostname
+                    in {"m.media-amazon.com", "images-na.ssl-images-amazon.com", "images-fe.ssl-images-amazon.com"}
+                ),
+            ),
+        )
+
+    @property
+    def best(self) -> ImageCandidate | None:
+        ranked = self._ranked()
+        return ranked[0] if ranked else None
+
+    def ordered_urls(self, previous: Sequence[str] = ()) -> list[str]:
+        ranked = self._ranked()
+        if not ranked and previous:
+            return list(dict.fromkeys([*previous, *self._attempts]))
+        return [candidate.url for candidate in ranked] + [
+            url for url, candidate in self._attempts.items() if candidate is None
+        ]
diff --git a/src/amane/media/liu1443452494_posters.py b/src/amane/media/liu1443452494_posters.py
new file mode 100644
index 0000000..2c5b1b5
--- /dev/null
+++ b/src/amane/media/liu1443452494_posters.py
@@ -0,0 +1,505 @@
+"""Tenhow 作品核对、ASIN 日亚检索与原始日文标题回退。"""
+
+import re
+import unicodedata
+from collections.abc import Mapping
+from typing import TYPE_CHECKING
+from urllib.parse import parse_qs, urlencode, urljoin, urlsplit, urlunsplit
+
+import structlog
+from parsel import Selector
+from pydantic import BaseModel, Field, TypeAdapter, ValidationError
+
+from ..crawlers.models import MediaMetadata
+from ..net.errors import FailureReason, classify_block
+from ..parsing import split_actor_aliases
+
+if TYPE_CHECKING:
+    from ..net.http import WebClient
+    from .liu1443452494_image_quality import ImagePool
+
+
+class PosterQuery(BaseModel):
+    number: str
+    title: str = ""
+    title_source: str = ""
+    actors_source: str = ""
+    actors: list[str] = Field(default_factory=list)
+    dmm_ids: list[str] = Field(default_factory=list)
+
+
+class TenhowMatch(BaseModel):
+    asin: str
+    image_url: str
+
+
+class PosterPage(BaseModel):
+    url: str
+    html: str
+
+
+class AmazonProduct(BaseModel):
+    asin: str
+    title: str
+    actor_text: str
+    image_urls: list[str]
+
+
+def _text_key(value: str) -> str:
+    return "".join(char for char in unicodedata.normalize("NFKC", value).casefold() if char.isalnum())
+
+
+def _number_key(value: str) -> str | None:
+    match = re.fullmatch(r"(\d*[a-z]+)[-_]?(\d{2,7})", value.strip().lower())
+    if match is None or int(match[2]) == 0:
+        return None
+    return f"{match[1]}-{int(match[2])}"
+
+
+def _safe_url(value: str, hosts: set[str]) -> bool:
+    try:
+        parsed = urlsplit(value)
+        return (
+            parsed.scheme in {"http", "https"}
+            and parsed.hostname in hosts
+            and parsed.username is None
+            and parsed.password is None
+            and parsed.port in {None, 80, 443}
+        )
+    except ValueError:
+        return False
+
+
+def _absolute_url(base: str, href: str) -> str:
+    try:
+        return urljoin(base, href)
+    except ValueError:
+        return ""
+
+
+def _dmm_id(href: str) -> str | None:
+    if _safe_url(href, {"al.fanza.co.jp", "al.dmm.co.jp"}):
+        targets = parse_qs(urlsplit(href).query).get("lurl", [])
+        if len(targets) != 1:
+            return None
+        href = targets[0]
+    if not _safe_url(href, {"www.dmm.co.jp", "video.dmm.co.jp", "www.dmm.com"}):
+        return None
+    parsed = urlsplit(href)
+    match = re.search(r"/cid=([a-z0-9_]+)/?", parsed.path, re.IGNORECASE)
+    if match:
+        return match[1].lower()
+    ids = parse_qs(parsed.query).get("id", [])
+    return ids[0].lower() if len(ids) == 1 and re.fullmatch(r"[a-zA-Z0-9_]+", ids[0]) else None
+
+
+def make_poster_query(number: str, raw: Mapping[str, object]) -> PosterQuery | None:
+    """仅从来源快照读取检索信息；不接受聚合后的翻译标题与姓名映射结果。"""
+    if _number_key(number) is None:
+        return None
+    query = PosterQuery(number=number)
+    priorities = {"dmm": 0, "avbase": 1, "javbus": 2}
+    for key in sorted(
+        raw, key=lambda key: (priorities.get(key.split(":")[0], 3), key.split(":")[-1] not in {"jp", "ja"})
+    ):
+        site, _, language = key.partition(":")
+        if language and language not in {"jp", "ja"}:
+            continue
+        try:
+            data = MediaMetadata.model_validate(raw[key])
+        except ValidationError:
+            continue
+        if _number_key(data.number) != _number_key(number) and not (site == "dmm" and _matches_cid(data.number, query)):
+            continue
+        japanese_source = site in {"dmm", "avbase"} or language in {"jp", "ja"}
+        if not query.title and data.title and (japanese_source or re.search(r"[\u3040-\u30ff]", data.title)):
+            query.title = data.title
+            query.title_source = site
+        if not query.actors:
+            names: list[str] = []
+            for actor in data.actors:
+                if japanese_source or re.search(r"[\u3040-\u30ff]", actor.name):
+                    primary, aliases = split_actor_aliases(actor.name)
+                    names.extend([primary, *aliases])
+            query.actors = list(dict.fromkeys(name.strip() for name in names if name.strip()))
+            if query.actors:
+                query.actors_source = site
+        if site == "dmm" and data.source_url:
+            cid = _dmm_id(data.source_url)
+            if cid and cid not in query.dmm_ids:
+                query.dmm_ids.append(cid)
+    return query if query.title or query.actors else None
+
+
+def _cid_key(value: str) -> str:
+    match = re.fullmatch(r"([a-z0-9_]*[a-z])(\d+)", value.lower())
+    return f"{match[1]}-{int(match[2])}" if match else value.lower()
+
+
+def _matches_cid(cid: str, query: PosterQuery) -> bool:
+    cid = re.sub(r"(?<=[a-z])[-_](?=\d+$)", "", unicodedata.normalize("NFKC", cid).lower())
+    wanted = _number_key(query.number)
+    if wanted is None:
+        return False
+    if _cid_key(cid) in {_cid_key(value) for value in query.dmm_ids}:
+        return True
+    if _number_key(cid) == wanted:
+        return True
+    # 未经来源确认的厂商前缀只接受已知对应关系，禁止任意删除前导数字。
+    match = re.fullmatch(r"(h_\d+|\d+)([a-z]+)(\d+)", cid)
+    if match is None:
+        return False
+    prefixes = {
+        "stars": "1",
+        "star": "1",
+        "start": "1",
+        "sods": "1",
+        "fsdss": "1",
+        "fcdss": "1",
+        "fns": "1",
+        "abp": "118",
+        "abf": "118",
+        "chn": "118",
+        "rebd": "h_346",
+        "rebdb": "h_346",
+        "ovg": "13",
+    }
+    return prefixes.get(match[2]) == match[1] and _number_key(match[2] + match[3]) == wanted
+
+
+def _tenhow_page_url(href: str) -> str | None:
+    url = _absolute_url("https://www.tenhow.net/", href)
+    if not _safe_url(url, {"www.tenhow.net", "tenhow.net"}):
+        return None
+    parsed = urlsplit(url)
+    if parsed.query or not re.fullmatch(r"/[a-z][a-z0-9_]*\.html", parsed.path):
+        return None
+    return f"https://www.tenhow.net{parsed.path}"
+
+
+def tenhow_index_pages(html: str) -> list[str]:
+    pages: list[str] = []
+    for link in Selector(text=html).css("a[href]"):
+        if re.fullmatch(r"[あかさたなはまやらわ]行", (link.xpath("string(.)").get() or "").strip()):
+            url = _tenhow_page_url(link.attrib["href"])
+            if url:
+                pages.append(url)
+    return list(dict.fromkeys(pages))
+
+
+def tenhow_actor_pages(html: str | list[str], actors: list[str]) -> list[str]:
+    wanted = {_text_key(name) for name in actors if _text_key(name)}
+    links: dict[str, set[str]] = {}
+    for document in [html] if isinstance(html, str) else html:
+        for link in Selector(text=document).css("a[href]"):
+            name = _text_key(link.xpath("string(.)").get() or "")
+            if name not in wanted:
+                continue
+            url = _tenhow_page_url(link.attrib["href"])
+            if url:
+                links.setdefault(name, set()).add(url)
+    return list(
+        dict.fromkeys(next(iter(links[name])) for name in map(_text_key, actors) if len(links.get(name, ())) == 1)
+    )
+
+
+def tenhow_matches(html: str, query: PosterQuery) -> list[TenhowMatch]:
+    matches: dict[str, TenhowMatch] = {}
+    for block in Selector(text=html).css("div.um_image_a.um_popup"):
+        if block.xpath(
+            './/div[contains(concat(" ", normalize-space(@class), " "), " um_image_a ") and contains(concat(" ", normalize-space(@class), " "), " um_popup ")]'
+        ):
+            continue
+        ids = [cid for href in block.css("a::attr(href)").getall() if (cid := _dmm_id(href))]
+        if not ids or not all(_matches_cid(cid, query) for cid in ids):
+            continue
+        images: dict[str, str] = {}
+        for href in block.css('a[title="拡大表示"]::attr(href)').getall():
+            url = _absolute_url("https://www.tenhow.net/", href)
+            if not _safe_url(url, {"www.tenhow.net", "tenhow.net"}):
+                continue
+            parsed = urlsplit(url)
+            match = re.fullmatch(r"/images/([A-Z0-9]{10})\.jpg", parsed.path)
+            if match and not parsed.query and not parsed.fragment:
+                images[match[1]] = f"https://www.tenhow.net{parsed.path}"
+        if len(images) > 1:
+            return []
+        for asin, url in images.items():
+            matches[asin] = TenhowMatch(asin=asin, image_url=url)
+    return list(matches.values())
+
+
+def amazon_image_urls(value: str) -> list[str]:
+    """保留主图原始地址及页面提供的缩放地址，逐一验证后参与比较。"""
+    if not _safe_url(
+        value, {"m.media-amazon.com", "images-na.ssl-images-amazon.com", "images-fe.ssl-images-amazon.com"}
+    ):
+        return []
+    parsed = urlsplit(value)
+    if not re.fullmatch(r"/images/I/[A-Za-z0-9+_.%-]+\.(?:jpg|jpeg|png|webp)", parsed.path):
+        return []
+    original_path = re.sub(r"\._[^/]+_(?=\.(?:jpg|jpeg|png|webp)$)", "", parsed.path)
+    return list(
+        dict.fromkeys(urlunsplit(("https", parsed.netloc, path, "", "")) for path in (original_path, parsed.path))
+    )
+
+
+def _asin_from_url(url: str) -> str | None:
+    if not _safe_url(url, {"www.amazon.co.jp", "amazon.co.jp"}):
+        return None
+    match = re.search(r"/(?:dp|gp/product)/([A-Z0-9]{10})(?:/|$)", urlsplit(url).path)
+    return match[1] if match else None
+
+
+def amazon_product(page: PosterPage, asin: str) -> AmazonProduct | None:
+    tree = Selector(text=page.html)
+    ids = tree.css('input#ASIN::attr(value), input[name="ASIN"]::attr(value)').getall()
+    canonical = tree.css('link[rel="canonical"]::attr(href)').getall()
+    ids.extend(_asin_from_url(url) or "" for url in canonical)
+    if not ids or set(ids) != {asin} or _asin_from_url(page.url) != asin:
+        return None
+    urls: list[str] = []
+    for main in tree.css("img#landingImage, img#imgBlkFront"):
+        urls.extend(amazon_image_urls(main.attrib.get("data-old-hires", "")))
+        dynamic = main.attrib.get("data-a-dynamic-image", "")
+        if dynamic:
+            try:
+                for url in TypeAdapter(dict[str, object]).validate_json(dynamic):
+                    urls.extend(amazon_image_urls(url))
+            except ValidationError:
+                pass
+        urls.extend(amazon_image_urls(main.attrib.get("src", "")))
+    title = tree.css("#productTitle").xpath("string(.)").get() or ""
+    actor_text = " ".join(
+        tree.css(
+            "#bylineInfo, #detailBullets_feature_div, #detailBulletsWrapper_feature_div, "
+            "#productDetails_detailBullets_sections1, #productDetailsTable"
+        )
+        .xpath("string(.)")
+        .getall()
+    )
+    return AmazonProduct(asin=asin, title=title.strip(), actor_text=actor_text, image_urls=list(dict.fromkeys(urls)))
+
+
+def _number_prefix(value: str) -> re.Match[str] | None:
+    return re.match(r"^[\[【(「『]?\s*(\d*[a-zA-Z]+[-_]?\d{2,7})(?![a-zA-Z0-9])", value)
+
+
+def _clean_title(value: str, query: PosterQuery) -> str:
+    value = unicodedata.normalize("NFKC", value).strip()
+    prefix = _number_prefix(value)
+    if prefix and _matches_cid(prefix[1], query):
+        value = value[prefix.end() :].lstrip(" \t\r\n]】)」』:：/_-・")
+    value = re.sub(
+        r"[\[【(]\s*(?:DVD|Blu-?ray|ブルーレイ|Prime Video|Amazonビデオ|デジタル(?:動画|ダウンロード)|ダウンロード(?:版)?|動画配信)\s*[\]】)]",
+        "",
+        value,
+        flags=re.IGNORECASE,
+    ).strip()
+    # 仅清除已知演员的独立后缀，标题正文中的姓名仍参与作品核对。
+    actors = sorted(
+        {unicodedata.normalize("NFKC", actor).strip() for actor in query.actors if actor.strip()},
+        key=len,
+        reverse=True,
+    )
+    while value:
+        previous = value
+        for actor in actors:
+            value = re.sub(rf"(?:^|[\s、/・]+){re.escape(actor)}\s*$", "", value).strip()
+        if value == previous:
+            break
+    return value
+
+
+def poster_search_titles(query: PosterQuery) -> list[str]:
+    """最多进行一次缩短标题重试；候选核对始终使用完整原题。"""
+    title = _clean_title(query.title, query)
+    if not _text_key(title):
+        return []
+    titles = [title]
+    shortened = re.split(r"[。！？!?]", title, maxsplit=1)[0].strip()
+    if shortened == title or len(_text_key(shortened)) < 12:
+        shortened = title[:32].rstrip() if len(_text_key(title)) >= 48 else title
+    if 12 <= len(_text_key(shortened)) <= len(_text_key(title)) * 0.8:
+        titles.append(shortened)
+    return titles
+
+
+def _title_matches(title: str, query: PosterQuery) -> bool:
+    prefix = _number_prefix(unicodedata.normalize("NFKC", title).strip())
+    if prefix and not _matches_cid(prefix[1], query):
+        return False
+    wanted, actual = _text_key(_clean_title(query.title, query)), _text_key(_clean_title(title, query))
+    if not wanted or not actual:
+        return False
+    if wanted == actual:
+        return True
+    return len(wanted) >= 10 and wanted in actual and len(wanted) / len(actual) >= 0.75
+
+
+def _actors_match(text: str, query: PosterQuery) -> bool:
+    key = _text_key(text)
+    return any(_text_key(actor) in key for actor in query.actors if _text_key(actor))
+
+
+def _amazon_media(card: Selector, title: str) -> bool:
+    # 搜索覆盖光盘和数字视频；正文中的 DVD 字样不能证明商品属于影片。
+    text = " ".join(card.xpath(".//text()[not(ancestor::h2)]").getall())
+    text += " " + " ".join(re.findall(r"[\[【(（]([^\]】)）]+)[\]】)）]", title))
+    return (
+        re.search(
+            r"\bDVD\b|Blu-?ray|ブルーレイ|Prime Video|Amazonビデオ|デジタル動画|ダウンロード|動画配信",
+            text,
+            re.IGNORECASE,
+        )
+        is not None
+    )
+
+
+class PosterResolver:
+    def __init__(self, client: WebClient, images: ImagePool) -> None:
+        self._client = client
+        self._images = images
+        self._pages: dict[str, PosterPage | None] = {}
+
+    async def _html(self, url: str) -> PosterPage | None:
+        if url not in self._pages:
+            self._pages[url] = None
+            try:
+                response = await self._client.request("GET", url, headers={"Accept-Language": "ja-JP,ja;q=0.9"})
+                response.encoding = "utf-8"
+                html = response.text
+                reason = classify_block(html)
+                eligibility = (
+                    reason is FailureReason.AGE_VERIFICATION
+                    and "black-curtain" in html
+                    and _safe_url(str(response.url), {"www.amazon.co.jp", "amazon.co.jp"})
+                )
+                if (reason is not None and not eligibility) or "validateCaptcha" in html:
+                    structlog.get_logger().warning("高清海报页面不可用", url=url, reason=reason or "验证码")
+                else:
+                    self._pages[url] = PosterPage(url=str(response.url), html=html)
+            except Exception as exc:
+                structlog.get_logger().warning("高清海报页面获取失败", url=url, error=str(exc))
+        return self._pages[url]
+
+    async def _amazon_page(self, url: str) -> PosterPage | None:
+        page = await self._html(url)
+        if (
+            page
+            and "black-curtain" in page.html
+            and not Selector(text=page.html).css('#landingImage, #imgBlkFront, [data-component-type="s-search-result"]')
+        ):
+            parsed = urlsplit(url)
+            target = urlunsplit(("", "", parsed.path, parsed.query, ""))
+            eligibility = "https://www.amazon.co.jp/black-curtain/save-eligibility/black-curtain?" + urlencode(
+                {"returnUrl": target}
+            )
+            page = await self._html(eligibility)
+        return page
+
+    async def _tenhow(self, query: PosterQuery) -> list[TenhowMatch]:
+        if not query.actors:
+            return []
+        index = await self._html("https://www.tenhow.net/mokuji.html")
+        if index is None or not _safe_url(index.url, {"www.tenhow.net", "tenhow.net"}):
+            return []
+        actor_pages = tenhow_actor_pages(index.html, query.actors)
+        if not actor_pages:
+            # 首页只列出部分近期演员；完整目录由实际导航中的五十音子目录提供。
+            indexes = [index.html]
+            for url in tenhow_index_pages(index.html):
+                group = await self._html(url)
+                if (
+                    group
+                    and _safe_url(group.url, {"www.tenhow.net", "tenhow.net"})
+                    and urlsplit(group.url).path == urlsplit(url).path
+                ):
+                    indexes.append(group.html)
+            actor_pages = tenhow_actor_pages(indexes, query.actors)
+        matches: dict[str, TenhowMatch] = {}
+        for url in actor_pages:
+            page = await self._html(url)
+            if (
+                page
+                and _safe_url(page.url, {"www.tenhow.net", "tenhow.net"})
+                and urlsplit(page.url).path == urlsplit(url).path
+            ):
+                for match in tenhow_matches(page.html, query):
+                    matches[match.asin] = match
+        if len(matches) > 1:
+            structlog.get_logger().warning("Tenhow 作品对应多个 ASIN，回退标题检索", number=query.number)
+            return []
+        return list(matches.values())
+
+    async def _amazon_asin(self, asin: str) -> AmazonProduct | None:
+        page = await self._amazon_page(f"https://www.amazon.co.jp/dp/{asin}")
+        return amazon_product(page, asin) if page else None
+
+    async def _search_title(
+        self, query: PosterQuery, trusted_asins: set[str], title: str, matched_asins: set[str]
+    ) -> bool | None:
+        url = "https://www.amazon.co.jp/s?" + urlencode({"k": title})
+        page = await self._amazon_page(url)
+        if page is None or not _safe_url(page.url, {"www.amazon.co.jp", "amazon.co.jp"}):
+            return None
+        success = False
+        for card in Selector(text=page.html).css('[data-component-type="s-search-result"][data-asin]'):
+            asin = card.attrib.get("data-asin", "")
+            if re.fullmatch(r"[A-Z0-9]{10}", asin) is None:
+                continue
+            title = card.css("h2").xpath("string(.)").get() or card.css("img.s-image::attr(alt)").get() or ""
+            if asin not in trusted_asins and not _amazon_media(card, title):
+                continue
+            if asin not in trusted_asins and not _title_matches(title, query):
+                continue
+            # 搜索卡片的 ASIN 与商品链接必须一致；查询串不能用作演员匹配证据。
+            linked = {
+                _asin_from_url(_absolute_url("https://www.amazon.co.jp/", href))
+                for href in card.css("a::attr(href)").getall()
+            }
+            linked.discard(None)
+            if linked != {asin}:
+                continue
+            card_matches = asin in trusted_asins or _actors_match(card.xpath("string(.)").get() or "", query)
+            product = await self._amazon_asin(asin)
+            detail_matches = product is not None and (
+                asin in trusted_asins
+                or (
+                    _title_matches(product.title, query)
+                    and _actors_match(product.title + " " + product.actor_text, query)
+                )
+            )
+            if not card_matches and not detail_matches:
+                continue
+            matched_asins.add(asin)
+            images: list[str] = []
+            if product is not None and detail_matches:
+                images.extend(product.image_urls)
+            for src in card.css("img.s-image::attr(src)").getall():
+                images.extend(amazon_image_urls(src))
+            success = await self._images.acquire(images) or success
+        return success
+
+    async def _search(self, query: PosterQuery, trusted_asins: set[str]) -> bool:
+        matched_asins: set[str] = set()
+        for title in poster_search_titles(query):
+            success = await self._search_title(query, trusted_asins, title, matched_asins)
+            if success:
+                return True
+            if success is None:
+                break
+        # 标题路径核实的新 ASIN 仍可尝试 Tenhow 直链；网络失败不触发缩短标题重试。
+        await self._images.acquire([f"https://www.tenhow.net/images/{asin}.jpg" for asin in sorted(matched_asins)])
+        return False
+
+    async def resolve(self, query: PosterQuery) -> None:
+        matches = await self._tenhow(query)
+        await self._images.acquire([match.image_url for match in matches])
+        success = False
+        for match in matches:
+            product = await self._amazon_asin(match.asin)
+            if product is not None:
+                success = await self._images.acquire(product.image_urls) or success
+        if not success:
+            await self._search(query, {match.asin for match in matches})
