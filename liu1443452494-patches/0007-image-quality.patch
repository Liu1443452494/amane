+def image_bytes(size: tuple[int, int] = (100, 150), minimum_bytes: int = 0) -> bytes:
+    stream = BytesIO()
+    Image.new("RGB", size, "blue").save(stream, format="JPEG")
+    data = stream.getvalue()
+    return data + b"\0" * max(0, minimum_bytes - len(data))
+
+
+class PosterClient(FakeClient):
+    def __init__(
+        self,
+        *,
+        pages: Mapping[str, str | None] | None = None,
+        images: Mapping[str, bytes | None] | None = None,
+        redirects: Mapping[str, str] | None = None,
+    ) -> None:
+        super().__init__({})
+        self.pages = dict(pages or {})
+        self.images = dict(images or {})
+        self.redirects = dict(redirects or {})
+        self.page_requests: list[str] = []
+        self.events: list[str] = []
+
+    async def request(self, method: HttpMethod, url: str, **kwargs: object) -> Response:
+        assert method == "GET"
+        self.page_requests.append(url)
+        self.events.append(url)
+        html = self.pages.get(url)
+        if html is None:
+            raise OSError("测试页面无法访问")
+        response = Response()
+        response.status_code = 200
+        response.url = self.redirects.get(url, url)
+        response.content = html.encode("utf-8")
+        return response
+
+    async def download(self, url: str, dest: Path, **kwargs: object) -> bool:
+        self.downloaded.append(url)
+        self.events.append(url)
+        data = self.images.get(url)
+        if data is None:
+            return False
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        dest.write_bytes(data)
+        return True
+
