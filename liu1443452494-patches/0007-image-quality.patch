+def test_tenhow_keeps_identity_inside_one_product_block() -> None:
+    query = PosterQuery(number="IPZZ-396")
+    wrong = tenhow_block("ipzz00397", "B000000002")
+    matching = tenhow_block()
+    matches = tenhow_matches(wrong + matching, query)
+    assert [item.asin for item in matches] == ["B000000001"]
+    conflict = matching.replace(
+        '<div class="buythis">',
+        '<a href="https://video.dmm.co.jp/av/content/?id=ipzz00397">另一部作品</a><div class="buythis">',
+    )
+    assert tenhow_matches(conflict, query) == []
+    mixed_images = matching.replace(
+        '<div class="buythis">', '<a title="拡大表示" href="images/B000000003.jpg">海报</a><div class="buythis">'
+    )
+    assert tenhow_matches(mixed_images, query) == []
+    assert tenhow_matches('<a title="拡大表示" href="images/B000000001.jpg">无作品区块</a>', query) == []
+    assert (
+        tenhow_matches(matching.replace("images/B000000001.jpg", "https://other.test/images/B000000001.jpg"), query)
+        == []
+    )
+    assert tenhow_matches(matching.replace("B000000001.jpg", "invalid.jpg"), query) == []
