+def test_amazon_reads_only_main_image_metadata() -> None:
+    large = "https://m.media-amazon.com/images/I/81Main.jpg"
+    scaled = "https://m.media-amazon.com/images/I/81Main._AC_SY879_.jpg"
+    other = "https://m.media-amazon.com/images/I/81Recommendation.jpg"
+    dynamic = escape(json.dumps({scaled: [879, 614]}), quote=True)
+    html = product_html(large).replace(f'data-old-hires="{large}"', f'data-a-dynamic-image="{dynamic}" src="{scaled}"')
+    html += f'<div id="recommendations"><img data-old-hires="{other}"></div>'
+    result = amazon_product(PosterPage(url="https://www.amazon.co.jp/dp/B000000001", html=html), "B000000001")
+    assert result is not None
+    assert result.image_urls == [large, scaled]
+    malformed = amazon_product(
+        PosterPage(url="https://www.amazon.co.jp/dp/B000000001", html=html.replace(dynamic, "无效JSON")), "B000000001"
+    )
+    assert malformed is not None and malformed.image_urls == [large, scaled]
