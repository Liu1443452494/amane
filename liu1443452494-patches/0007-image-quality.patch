+)
+async def test_shortened_search_keeps_full_identity_and_stops_on_network_failure(
+    resource_store: ResourceStore, tmp_path: Path, outcome: str
+) -> None:
+    title = "長い作品名の検索に必要な前半部分。元の作品だけに含まれる後半の内容"
+    shortened = "長い作品名の検索に必要な前半部分"
+    query = PosterQuery(number="IPZZ-396", title=f"IPZZ-396 {title} 楓カレン", actors=["楓カレン"])
+    amazon = "https://m.media-amazon.com/images/I/81Shortened.jpg"
+    returned = f"{title} 楓カレン"
+    if outcome == "different_title":
+        returned = f"{shortened}。別の作品の内容 楓カレン"
+    elif outcome == "different_number":
+        returned = f"IPZZ-397 {returned}"
+    first_page = search_card(amazon, title=returned) if outcome == "first_success" else "<html></html>"
+    client = PosterClient(
+        pages={
+            search_url(title): None if outcome == "network_failure" else first_page,
+            search_url(shortened): search_card(amazon, title=returned),
+        },
+        images={amazon: image_bytes()},
+    )
+    result = await materialize_images(
+        [], [], [], resource_store, cast("WebClient", client), HotSettings(), tmp_path, poster_query=query
+    )
+    accepted = outcome in {"recovered", "first_success"}
+    assert result.poster_urls == ([amazon] if accepted else [])
+    searches = [url for url in client.page_requests if url.startswith("https://www.amazon.co.jp/s?")]
+    assert searches == (
+        [search_url(title)]
+        if outcome in {"network_failure", "first_success"}
+        else [search_url(title), search_url(shortened)]
+    )
+    assert all("IPZZ" not in url and "dvd" not in url.lower() for url in searches)
+    if not accepted:
+        assert client.downloaded == []
