+"""刮削入口的图片原文、字段锁定及旧图回退。"""
+
+from pathlib import Path
+from typing import cast
+
+import pytest
+
+from amane.config import HotSettings
+from amane.crawlers.models import FetchOptions, MediaMetadata, SearchQuery, film_actors
+from amane.db.repository import Repository
+from amane.enums import Language, MetadataField, SiteName
+from amane.handlers import ScrapeHandler, ScrapePayload
+from amane.llm import Translator
+from amane.media import ResourceStore
+from amane.net.http import WebClient
+from amane.parsing import ContentType
+from tests.handlers.test_scraper import FakeFactory, MockCrawler
+from tests.media.test_liu1443452494_image_quality import PosterClient, image_bytes, search_card, search_url
+
+
+class OriginalCrawler(MockCrawler):
+    name = SiteName.DMM
+
+    def __init__(self, metadata: MediaMetadata) -> None:
+        super().__init__()
+        self.metadata = metadata
+
+    async def fetch(self, query: SearchQuery, options: FetchOptions | None = None) -> MediaMetadata | None:
+        return self.metadata.model_copy(deep=True)
+
+
+class ChineseTranslator:
+    async def translate(self, text: str, language: Language, field: MetadataField, use_cache: bool) -> str:
+        return "已经翻译的中文标题"
+
+
+@pytest.mark.asyncio
+async def test_scrape_searches_original_japanese_before_xml_mapping(
+    repo: Repository, resource_store: ResourceStore, tmp_path: Path
+) -> None:
+    (tmp_path / "mapping_actor.xml").write_text('<actors><a zh_cn="枫花恋" jp="楓カレン"/></actors>', encoding="utf-8")
+    original = MediaMetadata(number="IPZZ-396", title="原題の長い物語 楓カレン", actors=film_actors(["楓カレン"]))
+    image = "https://m.media-amazon.com/images/I/81Found.jpg"
+    client = PosterClient(pages={search_url(): search_card(image)}, images={image: image_bytes()})
+    config = HotSettings()
+    config.scraping.content_routes[ContentType.CENSORED] = [SiteName.DMM]
+    config.scraping.field_language[MetadataField.TITLE] = Language.ZH_CN
+    handler = ScrapeHandler(
+        repo,
+        FakeFactory({"dmm": OriginalCrawler(original)}),
+        resource_store,
+        config,
+        web_client=cast("WebClient", client),
+        translator=cast("Translator", ChineseTranslator()),
+    )
+    result = await handler.handle(
+        ScrapePayload(number=original.number, content_type=ContentType.CENSORED, use_cache=set())
+    )
+    assert result.success
+    saved = await repo.get_metadata_by_number(original.number)
+    assert saved is not None
+    assert saved.title == "已经翻译的中文标题"
+    assert saved.actors == ["枫花恋"]
+    assert saved.poster_urls == [image]
+    assert saved.raw["dmm"]["title"] == original.title
+    assert saved.raw["dmm"]["actors"][0]["name"] == "楓カレン"
+    assert search_url() in client.page_requests
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("locked", [True, False])
+async def test_scrape_retains_existing_images_without_metadata_cache(
+    repo: Repository, resource_store: ResourceStore, locked: bool
+) -> None:
