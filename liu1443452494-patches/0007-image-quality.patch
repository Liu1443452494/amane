+def search_card(image_url: str, asin: str = "B000000001", *, title: str = "原題の長い物語 楓カレン") -> str:
+    return (
+        f'<div data-component-type="s-search-result" data-asin="{asin}">'
+        f'<a href="/dp/{asin}"><h2>{title} [DVD]</h2></a>'
+        f'<img class="s-image" src="{image_url}"></div>'
