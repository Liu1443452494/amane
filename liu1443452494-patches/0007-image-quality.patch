+def product_html(image_url: str, asin: str = "B000000001", *, title: str = "原題の長い物語 楓カレン") -> str:
+    return (
+        f'<link rel="canonical" href="https://www.amazon.co.jp/dp/{asin}">'
+        f'<input id="ASIN" value="{asin}"><span id="productTitle">{title}</span>'
+        f'<img id="landingImage" data-old-hires="{image_url}">'
+    )
