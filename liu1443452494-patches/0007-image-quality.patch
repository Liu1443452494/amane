+@pytest.mark.parametrize("mismatch", ["input", "canonical", "redirect", "missing", "none"])
+def test_amazon_validates_product_identity(mismatch: str) -> None:
+    url = "https://m.media-amazon.com/images/I/81Main.jpg"
+    html = product_html(url)
+    page_url = "https://www.amazon.co.jp/dp/B000000001"
+    if mismatch == "input":
+        html = html.replace('value="B000000001"', 'value="B000000002"')
+    elif mismatch == "canonical":
+        html = html.replace(
+            'href="https://www.amazon.co.jp/dp/B000000001"', 'href="https://www.amazon.co.jp/dp/B000000002"'
+        )
+    elif mismatch == "redirect":
+        page_url = "https://www.amazon.co.jp/dp/B000000002"
+    elif mismatch == "missing":
+        html = f'<img id="landingImage" src="{url}">'
+    result = amazon_product(PosterPage(url=page_url, html=html), "B000000001")
+    if mismatch == "none":
+        assert result is not None and result.image_urls == [url]
+    else:
+        assert result is None
+
