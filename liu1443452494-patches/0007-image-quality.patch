+def test_query_uses_dmm_original_and_explicit_japanese_fallback() -> None:
+    dmm = MediaMetadata(
+        number="IPZZ-396",
+        title="日本語の原題",
+        actors=film_actors(["楓カレン"]),
+        source_url="https://video.dmm.co.jp/av/content/?id=ipzz00396",
+    )
+    translated = MediaMetadata(number="IPZZ-396", title="翻译后的标题", actors=film_actors(["枫花恋"]))
+    raw = {"javdb:zh_cn": translated.model_dump(), "dmm": dmm.model_dump()}
+    query = make_poster_query("IPZZ396", raw)
+    assert query is not None
+    assert query.title == "日本語の原題"
+    assert query.actors == ["楓カレン"]
+    assert query.dmm_ids == ["ipzz00396"]
+    assert raw["dmm"]["title"] == "日本語の原題"
+    assert make_poster_query("IPZZ-396", {"javdb:zh_cn": translated.model_dump()}) is None
+    japanese = make_poster_query("IPZZ-396", {"javdb:jp": dmm.model_dump()})
+    assert japanese is not None and japanese.title == query.title and japanese.actors == query.actors
+    assert make_poster_query("IPZZ-396", {"dmm": {"number": "OTHER-396", "title": "別の作品"}}) is None
+    assert make_poster_query("IPZZ-396", {"dmm": {"title": "番号欠損"}}) is None
+    assert make_poster_query("任意の文字列", raw) is None
+
