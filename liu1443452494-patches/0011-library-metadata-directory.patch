diff --git a/web/src/components/library/metadata-directory.ts b/web/src/components/library/metadata-directory.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b8fd7a6113f4d8836f14bd94288c4633a71bbbb7
--- /dev/null
+++ b/web/src/components/library/metadata-directory.ts
@@ -0,0 +1,99 @@
+import type { LibraryResponse, OptionalPathTemplateDefaults } from "@/client/types.gen";
+
+export const OPTIONAL_TEMPLATE_KEYS: readonly (keyof OptionalPathTemplateDefaults)[] = [
+  "thumb_template",
+  "poster_template",
+  "fanart_template",
+  "extrafanart_template",
+  "nfo_template",
+  "trailer_template",
+  "subtitle_template",
+];
+
+export interface MetadataDirectoryFields extends OptionalPathTemplateDefaults {
+  metadata_directory: string;
+}
+
+function templateValues(
+  templates: Pick<LibraryResponse, keyof OptionalPathTemplateDefaults>,
+): OptionalPathTemplateDefaults {
+  return {
+    thumb_template: templates.thumb_template ?? "",
+    poster_template: templates.poster_template ?? "",
+    fanart_template: templates.fanart_template ?? "",
+    extrafanart_template: templates.extrafanart_template ?? "",
+    nfo_template: templates.nfo_template ?? "",
+    trailer_template: templates.trailer_template ?? "",
+    subtitle_template: templates.subtitle_template ?? "",
+  };
+}
+
+function templateSuffix(template: string | undefined): string | undefined {
+  const anchor = "{link_dir}";
+  if (!template?.startsWith(anchor)) return undefined;
+  const suffix = template.slice(anchor.length);
+  if (!/^[\\/][^\\/]/.test(suffix)) return undefined;
+  return suffix.slice(1);
+}
+
+/** 保留目录内部写法与已有末尾分隔符，避免改变盘符、共享路径和模板表达式。 */
+export function metadataDirectoryDefault(
+  directory: string,
+  defaultTemplate: string | undefined,
+): string | undefined {
+  const prefix = directory.trim();
+  if (!prefix) return defaultTemplate;
+  const suffix = templateSuffix(defaultTemplate);
+  if (suffix === undefined) return undefined;
+  return `${prefix}${/[\\/]$/.test(prefix) ? "" : "/"}${suffix}`;
+}
+
+/** 仅七项可以无损还原为共同目录和默认名称时合并显示。 */
+export function collapseMetadataDirectory(
+  templates: Pick<LibraryResponse, keyof OptionalPathTemplateDefaults>,
+  defaults?: OptionalPathTemplateDefaults,
+): MetadataDirectoryFields {
+  const result = { metadata_directory: "", ...templateValues(templates) };
+  if (!defaults) return result;
+
+  let directory: string | undefined;
+  for (const key of OPTIONAL_TEMPLATE_KEYS) {
+    const suffix = templateSuffix(defaults[key]);
+    const value = result[key];
+    if (suffix === undefined || !value.endsWith(suffix)) return result;
+    const prefix = value.slice(0, -suffix.length);
+    if (!/[\\/]$/.test(prefix) || prefix.trim() !== prefix) return result;
+    if (directory !== undefined && prefix !== directory) return result;
+    directory = prefix;
+  }
+  if (directory === undefined) return result;
+
+  result.metadata_directory = directory;
+  for (const key of OPTIONAL_TEMPLATE_KEYS) result[key] = "";
+  return result;
+}
+
+/** 请求体只包含原有七项；前缀仅展开留空项，显式单项始终优先。 */
+export function expandMetadataDirectory(
+  form: MetadataDirectoryFields,
+  defaults?: OptionalPathTemplateDefaults,
+): OptionalPathTemplateDefaults {
+  const result = templateValues(form);
+  for (const key of OPTIONAL_TEMPLATE_KEYS) {
+    const value = result[key].trim();
+    if (value || !form.metadata_directory.trim()) {
+      result[key] = value;
+      continue;
+    }
+    const defaultTemplate = defaults?.[key];
+    if (defaultTemplate === undefined) {
+      throw new Error("未能读取附属资源默认模板，请重新打开媒体库配置后重试。");
+    }
+    const expanded = metadataDirectoryDefault(form.metadata_directory, defaultTemplate);
+    if (expanded === undefined) {
+      throw new Error("附属资源默认模板不支持元数据目录前缀，请使用单项完整模板。");
+    }
+    result[key] = expanded;
+  }
+  return result;
+}
