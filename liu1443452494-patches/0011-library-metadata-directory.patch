+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  collapseMetadataDirectory,
+  expandMetadataDirectory,
+} from "../src/components/library/metadata-directory.ts";
+
+const EMPTY_TEMPLATES = Object.freeze({
+  thumb_template: "",
+  poster_template: "",
+  fanart_template: "",
+  extrafanart_template: "",
+  nfo_template: "",
+  trailer_template: "",
+  subtitle_template: "",
+});
+
+const DEFAULTS = Object.freeze({
+  thumb_template: "{link_dir}/thumb.jpg",
+  poster_template: "{link_dir}/poster.jpg",
+  fanart_template: "{link_dir}/fanart.jpg",
+  extrafanart_template: "{link_dir}/extrafanart",
+  nfo_template: "{link_dir}/{video_name}.nfo",
+  trailer_template: "{link_dir}/trailer.mp4",
+  subtitle_template: "{link_dir}/{raw_srt_name}.{ext}",
+});
+
+const USER_DIRECTORY = String.raw`D:\工作文件夹\日本元数据/{actresses}/[[{number}[-{mosaic?|cracked=U,censored=}{sub?}]]] {title}/`;
+const UNC_DIRECTORY = "\\\\媒体服务器\\共享目录\\元数据\\";
+const BACKSLASH_DEFAULTS = Object.freeze(
+  Object.fromEntries(
+    Object.entries(DEFAULTS).map(([key, value]) => [
+      key,
+      value.replace("{link_dir}/", "{link_dir}\\"),
+    ]),
+  ),
+);
+const NESTED_DEFAULTS = Object.freeze({
+  ...DEFAULTS,
+  thumb_template: "{link_dir}/images/thumb.jpg",
+  extrafanart_template: "{link_dir}\\images\\extrafanart",
+});
+
+function templatesIn(directory) {
+  return {
+    thumb_template: `${directory}thumb.jpg`,
+    poster_template: `${directory}poster.jpg`,
+    fanart_template: `${directory}fanart.jpg`,
+    extrafanart_template: `${directory}extrafanart`,
+    nfo_template: `${directory}{video_name}.nfo`,
+    trailer_template: `${directory}trailer.mp4`,
+    subtitle_template: `${directory}{raw_srt_name}.{ext}`,
+  };
+}
+
+function formWith(directory, overrides = {}) {
+  return { ...EMPTY_TEMPLATES, metadata_directory: directory, ...overrides };
+}
+
+function unchangedTemplates(templates) {
+  return {
+    ...Object.fromEntries(Object.keys(EMPTY_TEMPLATES).map((key) => [key, templates[key] ?? ""])),
+    metadata_directory: "",
+  };
+}
+
+const nestedTemplates = {
+  ...templatesIn("D:/元数据/"),
+  thumb_template: "D:/元数据/images/thumb.jpg",
+  extrafanart_template: "D:/元数据/images\\extrafanart",
+};
+
+const explicitTemplates = templatesIn("E:/单独设置/");
+const paddedExplicitTemplates = Object.fromEntries(
+  Object.entries(explicitTemplates).map(([key, value]) => [key, ` \t${value}\r\n`]),
+);
+
+for (const entry of [
+  {
+    name: "完整用户模板保留中文、映射、可选组和占位符",
+    form: formWith(USER_DIRECTORY),
+    defaults: DEFAULTS,
+    expected: templatesIn(USER_DIRECTORY),
+  },
+  {
+    name: "目录末尾缺少分隔符时补充正斜杠",
+    form: formWith("D:\\本地元数据"),
+    defaults: DEFAULTS,
+    expected: templatesIn("D:\\本地元数据/"),
+  },
+  {
+    name: "目录已有正斜杠时不重复追加",
+    form: formWith("D:/本地元数据/"),
+    defaults: DEFAULTS,
+    expected: templatesIn("D:/本地元数据/"),
+  },
+  {
+    name: "目录已有反斜杠时保留原分隔符",
+    form: formWith("D:\\本地元数据\\"),
+    defaults: DEFAULTS,
+    expected: templatesIn("D:\\本地元数据\\"),
+  },
+  {
+    name: "仅清除目录首尾空白并保留内部空格",
+    form: formWith(" \tD:/本地 元数据/\r\n"),
+    defaults: DEFAULTS,
+    expected: templatesIn("D:/本地 元数据/"),
+  },
+  {
+    name: "Windows 盘符根目录保留反斜杠",
+    form: formWith("D:\\"),
+    defaults: DEFAULTS,
+    expected: templatesIn("D:\\"),
+  },
+  {
+    name: "正斜杠根目录保留根路径",
+    form: formWith("/"),
+    defaults: DEFAULTS,
+    expected: templatesIn("/"),
+  },
+  {
+    name: "UNC 目录保留双反斜杠及共享路径",
+    form: formWith(UNC_DIRECTORY),
+    defaults: DEFAULTS,
+    expected: templatesIn(UNC_DIRECTORY),
+  },
+  {
+    name: "混合分隔符及相对目录模板不进行规范化",
+    form: formWith(String.raw`分类/{actresses}\[{number}]`),
+    defaults: DEFAULTS,
+    expected: templatesIn(String.raw`分类/{actresses}\[{number}]/`),
+  },
+  {
+    name: "显式单项清除首尾空白后优先使用",
+    form: formWith(USER_DIRECTORY, {
+      thumb_template: "  E:\\单独目录\\自定义封面.jpg  ",
+      nfo_template: "\tNFO/{number}.nfo\n",
+    }),
+    defaults: DEFAULTS,
+    expected: {
+      ...templatesIn(USER_DIRECTORY),
+      thumb_template: "E:\\单独目录\\自定义封面.jpg",
+      nfo_template: "NFO/{number}.nfo",
+    },
+  },
+  {
+    name: "共同目录为空时允许缺少默认模板且沿用单项修整",
+    form: formWith(" \t ", {
+      thumb_template: " D:/既有/thumb.jpg ",
+      nfo_template: "\t ",
+    }),
+    expected: {
+      ...EMPTY_TEMPLATES,
+      thumb_template: "D:/既有/thumb.jpg",
+    },
+  },
+  {
+    name: "七项均已填写时无需默认模板",
+    form: formWith("D:/共同目录/", paddedExplicitTemplates),
+    expected: explicitTemplates,
+  },
+  {
+    name: "默认模板锚点允许反斜杠",
+    form: formWith("D:/元数据/"),
+    defaults: BACKSLASH_DEFAULTS,
+    expected: templatesIn("D:/元数据/"),
+  },
+  {
+    name: "默认相对子目录与其分隔符完整保留",
+    form: formWith("D:/元数据/"),
+    defaults: NESTED_DEFAULTS,
+    expected: nestedTemplates,
+  },
+  {
+    name: "已有显式值的单项不依赖其默认模板",
+    form: formWith("D:/元数据/", { thumb_template: "E:/封面.jpg" }),
+    defaults: { ...DEFAULTS, thumb_template: "不支持的默认模板" },
+    expected: { ...templatesIn("D:/元数据/"), thumb_template: "E:/封面.jpg" },
+  },
+]) {
+  test(`保存展开：${entry.name}`, () => {
+    assert.deepEqual(expandMetadataDirectory(entry.form, entry.defaults), entry.expected);
+  });
+}
+
+for (const entry of [
+  { name: "默认模板数据缺失", defaults: undefined, missing: true },
+  { name: "单项默认模板缺失", defaults: { ...DEFAULTS, thumb_template: undefined }, missing: true },
+  { name: "默认模板仅有文件名", defaults: { ...DEFAULTS, thumb_template: "thumb.jpg" } },
+  {
+    name: "默认模板引用其他目录占位符",
+    defaults: { ...DEFAULTS, thumb_template: "{video_dir}/thumb.jpg" },
+  },
+  {
+    name: "默认目录锚点未出现在开头",
+    defaults: { ...DEFAULTS, thumb_template: "其他/{link_dir}/thumb.jpg" },
+  },
+  {
+    name: "默认目录锚点缺少路径分隔符",
+    defaults: { ...DEFAULTS, thumb_template: "{link_dir}thumb.jpg" },
+  },
+]) {
+  test(`保存错误：${entry.name}时返回中文错误`, () => {
+    const form = Object.freeze(formWith("D:/元数据/"));
+    assert.throws(
+      () => expandMetadataDirectory(form, entry.defaults),
+      (error) => {
+        assert.ok(error instanceof Error);
+        assert.match(
+          error.message,
+          entry.missing ? /未能读取附属资源默认模板/ : /附属资源默认模板不支持元数据目录前缀/,
+        );
+        return true;
+      },
+    );
+  });
+}
+
+for (const entry of [
+  { name: "完整用户目录模板", directory: USER_DIRECTORY, defaults: DEFAULTS },
+  { name: "Windows 盘符根目录", directory: "D:\\", defaults: DEFAULTS },
+  { name: "正斜杠根目录", directory: "/", defaults: DEFAULTS },
+  { name: "UNC 目录", directory: UNC_DIRECTORY, defaults: DEFAULTS },
+  { name: "末尾反斜杠目录", directory: "D:\\元数据\\", defaults: DEFAULTS },
+  { name: "反斜杠默认锚点", directory: "D:/元数据/", defaults: BACKSLASH_DEFAULTS },
+  {
+    name: "包含完整默认相对子目录",
+    directory: "D:/元数据/",
+    defaults: NESTED_DEFAULTS,
+    templates: nestedTemplates,
+  },
+]) {
+  test(`编辑提取：${entry.name}清空七项且再次保存保持原值`, () => {
+    const templates = entry.templates ?? templatesIn(entry.directory);
+    const collapsed = collapseMetadataDirectory(templates, entry.defaults);
+    assert.deepEqual(collapsed, formWith(entry.directory));
+    assert.deepEqual(expandMetadataDirectory(collapsed, entry.defaults), templates);
+  });
+}
+
+const matchingTemplates = templatesIn("D:/元数据/");
+
+for (const entry of [
+  { name: "默认模板数据缺失", templates: matchingTemplates },
+  { name: "七项均未提供", templates: {}, defaults: DEFAULTS },
+  {
+    name: "空串与空值并存",
+    templates: { ...EMPTY_TEMPLATES, thumb_template: null, nfo_template: undefined },
+    defaults: DEFAULTS,
+  },
+  {
+    name: "其中一项为空值",
+    templates: { ...matchingTemplates, poster_template: null },
+    defaults: DEFAULTS,
+  },
+  {
+    name: "其中一项未提供",
+    templates: { ...matchingTemplates, subtitle_template: undefined },
+    defaults: DEFAULTS,
+  },
+  {
+    name: "其中一项自定义文件名",
+    templates: { ...matchingTemplates, thumb_template: "D:/元数据/自定义封面.jpg" },
+    defaults: DEFAULTS,
+  },
+  {
+    name: "其中一项位于其他目录",
+    templates: { ...matchingTemplates, poster_template: "E:/其他目录/poster.jpg" },
+    defaults: DEFAULTS,
+  },
+  {
+    name: "目录仅大小写不同也不合并",
+    templates: { ...matchingTemplates, thumb_template: "d:/元数据/thumb.jpg" },
+    defaults: DEFAULTS,
+  },
+  {
+    name: "目录分隔符不同也不合并",
+    templates: { ...matchingTemplates, thumb_template: "D:\\元数据\\thumb.jpg" },
+    defaults: DEFAULTS,
+  },
+  {
+    name: "单项包含额外前导空白",
+    templates: { ...matchingTemplates, thumb_template: " D:/元数据/thumb.jpg" },
+    defaults: DEFAULTS,
+  },
+  {
+    name: "单项包含额外末尾空白",
+    templates: { ...matchingTemplates, thumb_template: "D:/元数据/thumb.jpg " },
+    defaults: DEFAULTS,
+  },
+  {
+    name: "共同字符串与默认名称之间缺少目录分隔符",
+    templates: templatesIn("自定义"),
+    defaults: DEFAULTS,
+  },
+  {
+    name: "只有默认名称而没有目录前缀",
+    templates: templatesIn(""),
+    defaults: DEFAULTS,
+  },
+  {
+    name: "NFO 名称已经展开而不再包含默认占位符",
+    templates: { ...matchingTemplates, nfo_template: "D:/元数据/影片名称.nfo" },
+    defaults: DEFAULTS,
+  },
+  {
+    name: "字幕文件名未保持默认后缀",
+    templates: { ...matchingTemplates, subtitle_template: "D:/元数据/{video_name}.{ext}" },
+    defaults: DEFAULTS,
+  },
+  {
+    name: "默认相对子目录不匹配",
+    templates: matchingTemplates,
+    defaults: NESTED_DEFAULTS,
+  },
+  {
+    name: "单项默认模板缺失",
+    templates: matchingTemplates,
+    defaults: { ...DEFAULTS, thumb_template: undefined },
+  },
+  {
+    name: "单项默认模板锚点不支持",
+    templates: matchingTemplates,
+    defaults: { ...DEFAULTS, thumb_template: "{video_dir}/thumb.jpg" },
+  },
+]) {
+  test(`编辑保留：${entry.name}时完整保留各项`, () => {
+    assert.deepEqual(
+      collapseMetadataDirectory(entry.templates, entry.defaults),
+      unchangedTemplates(entry.templates),
+    );
+  });
+}
+
+test("保存输出只包含七项模板且不修改表单或默认值", () => {
+  const form = Object.freeze({
+    ...formWith(USER_DIRECTORY),
+    name: "媒体库名称",
+    path: "Z:/网盘",
+    video_template: "{raw_video_path}",
+    write_nfo: false,
+  });
+  const formBefore = { ...form };
+  const defaultsBefore = { ...DEFAULTS };
+  const expanded = expandMetadataDirectory(form, DEFAULTS);
+  assert.deepEqual(expanded, templatesIn(USER_DIRECTORY));
+  assert.notStrictEqual(expanded, form);
+  assert.deepEqual(form, formBefore);
+  assert.deepEqual(DEFAULTS, defaultsBefore);
+});
+
+test("编辑提取返回新对象且不修改响应或默认值", () => {
+  const response = Object.freeze({ ...templatesIn(USER_DIRECTORY), id: 1, name: "媒体库名称" });
+  const responseBefore = { ...response };
+  const defaultsBefore = { ...DEFAULTS };
+  const collapsed = collapseMetadataDirectory(response, DEFAULTS);
+  assert.deepEqual(collapsed, formWith(USER_DIRECTORY));
+  assert.notStrictEqual(collapsed, response);
+  assert.deepEqual(response, responseBefore);
+  assert.deepEqual(DEFAULTS, defaultsBefore);
+});
+
+test("未发生展开或提取时仍返回新对象并保留输入", () => {
+  const form = Object.freeze(formWith(""));
+  const response = Object.freeze({ ...matchingTemplates, poster_template: null });
+  const expanded = expandMetadataDirectory(form);
+  const collapsed = collapseMetadataDirectory(response, DEFAULTS);
+  assert.deepEqual(expanded, EMPTY_TEMPLATES);
+  assert.deepEqual(collapsed, unchangedTemplates(response));
+  assert.notStrictEqual(expanded, form);
+  assert.notStrictEqual(collapsed, response);
+  assert.equal(response.poster_template, null);
+  assert.equal(form.metadata_directory, "");
+});
