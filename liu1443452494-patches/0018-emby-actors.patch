+from ..crawlers.actor import ActorFetcher, ActorMetadata, filter_sites_for_gender
+from ..enums import ActorGender, SiteName
+from ..liu1443452494_emby_client import EmbyActorClient, emby_server_key, require_emby
+from ..media_server import MediaPerson, MediaServerError, normalize_person_name
+from ..net.errors import FailureReason, SourceError
+from ..net.recording import skip_body_recording
+from ..utils.dates import normalize_calendar_date
+from ..utils.threads import in_thread
+from .models import EmbyActorScrapePayload, EmbyActorScrapeResult
+from .protocol import TaskHandler, TaskResult
+
+if TYPE_CHECKING:
+    from ..config import ActorScrapingConfig, HotSettings, MediaServerConfig
+    from ..net.http import WebClient
+    from .actor_scrape import ActorCrawlerFactoryLike
+
+
+class _SiteResult(BaseModel):
+    site: SiteName
+    metadata: ActorMetadata | None = None
+    error: str | None = None
+
+
+class _FetchedActor(BaseModel):
+    metadata: AggregatedActor
+    errors: list[str] = Field(default_factory=list)
+
+
+class _Portrait(BaseModel):
+    content_type: str
+    data: bytes
+
+
+class _PersonUpdates(BaseModel):
+    overview: str | None = Field(default=None, alias="Overview")
+    birthday: str | None = Field(default=None, alias="PremiereDate")
+    year: int | None = Field(default=None, alias="ProductionYear")
+    locations: list[str] | None = Field(default=None, alias="ProductionLocations")
+
+    model_config = {"populate_by_name": True}
+
+
+@in_thread
+def read_emby_name_mapping(data_dir: Path) -> dict[str, str | None]:
+    """原名优先，XML 仅提供唯一匹配的日文备用名，不改变 Emby 显示名。"""
+    path = data_dir / "mapping_actor.xml"
+    try:
+        root = ElementTree.fromstring(path.read_text(encoding="utf-8-sig"))
+    except FileNotFoundError:
+        return {}
+    except OSError, UnicodeError, ElementTree.ParseError:
+        raise ValueError("演员映射文件读取失败，请检查 UTF-8 编码和 XML 格式") from None
+    names: dict[str, str | None] = {}
+    for entry in root.iter("a"):
+        japanese = entry.get("jp", "").strip()
+        if not japanese:
+            continue
+        candidates = [entry.get(key, "") for key in ("zh_cn", "zh_tw", "jp")]
+        candidates.extend(entry.get("keyword", "").split(","))
+        for candidate in candidates:
+            key = normalize_person_name(candidate)
+            if not key:
+                continue
+            if key not in names:
+                names[key] = japanese
+            elif names[key] != japanese:
+                names[key] = None
+    return names
+
+
+def _lookup_names(name: str, mapping: Mapping[str, str | None]) -> list[str]:
+    japanese = mapping.get(normalize_person_name(name))
+    return [name, japanese] if japanese and normalize_person_name(japanese) != normalize_person_name(name) else [name]
+
+
+async def _fetch_site(site: SiteName, crawler: ActorFetcher | None, names: list[str]) -> _SiteResult:
+    if crawler is None:
+        return _SiteResult(site=site, error=f"{site}：来源不可用")
+    for name in names:
+        try:
+            metadata = await crawler.fetch(name)
+        except SourceError as exc:
+            if exc.reason in {FailureReason.NOT_FOUND, FailureReason.NO_USABLE_METADATA}:
+                continue
+            return _SiteResult(site=site, error=f"{site}：来源请求失败（{exc.reason.value}）")
+        except Exception:
+            # 来源异常可能携带响应正文，仅记录分类信息，禁止保存完整演员资料。
+            return _SiteResult(site=site, error=f"{site}：来源解析失败")
+        if metadata is not None and (
+            metadata.overview
+            or metadata.birthday
+            or metadata.birthplace
+            or metadata.image_urls
+            or metadata.gender in {ActorGender.FEMALE, ActorGender.MALE}
+        ):
+            return _SiteResult(site=site, metadata=metadata)
+    return _SiteResult(site=site)
+
+
+async def fetch_emby_actor(
+    names: list[str], config: ActorScrapingConfig, factory: ActorCrawlerFactoryLike, *, need_image: bool
+) -> _FetchedActor:
+    profiles = config.profile_sites
+    images = config.image_sites if need_image else []
+    configured = list(dict.fromkeys([*profiles, *images]))
+    sites, deferred = filter_sites_for_gender(configured, ActorGender.UNKNOWN)
+    crawlers = await factory.get_actor_crawlers(configured)
+    outcomes = list(await asyncio.gather(*(_fetch_site(site, crawlers.get(site), names) for site in sites)))
+    results = {outcome.site: outcome.metadata for outcome in outcomes}
+    gender = first_known_gender(results, profile_sites=profiles)
+    if gender is not None:
+        second, _ = filter_sites_for_gender(deferred, gender)
+        extra = await asyncio.gather(*(_fetch_site(site, crawlers.get(site), names) for site in second))
+        outcomes.extend(extra)
+        results.update({outcome.site: outcome.metadata for outcome in extra})
+    return _FetchedActor(
+        metadata=merge_actor_metadata(results, profile_sites=profiles, image_sites=images),
+        errors=[outcome.error for outcome in outcomes if outcome.error is not None],
+    )
+
+
+def _has_text(value: str | None) -> bool:
+    return bool(value and value.strip())
+
+
+def _profile_complete(person: MediaPerson) -> bool:
+    return (
+        _has_text(person.overview)
+        and _has_text(person.premiere_date)
+        and person.production_year is not None
+        and any(value.strip() for value in person.production_locations)
+    )
+
+
+def emby_profile_updates(actor: AggregatedActor, person: MediaPerson, *, force: bool) -> _PersonUpdates:
+    updates = _PersonUpdates()
+    if _has_text(actor.overview) and (force or not _has_text(person.overview)):
+        updates.overview = actor.overview
+    birthday = normalize_calendar_date(actor.birthday) if actor.birthday else None
+    if birthday:
+        if force or not _has_text(person.premiere_date):
+            updates.birthday = birthday
+        if force or person.production_year is None:
+            # 补充出生年份时与已保留的生日保持一致，避免产生互相矛盾的日期。
+            effective = (
+                birthday
+                if force or not _has_text(person.premiere_date)
+                else normalize_calendar_date(person.premiere_date or "")
+            )
+            if effective:
+                updates.year = int(effective[:4])
+    if _has_text(actor.birthplace) and (force or not any(value.strip() for value in person.production_locations)):
+        updates.locations = [actor.birthplace] if actor.birthplace is not None else None
+    return updates
+
+
+@in_thread
+def _portrait(data: bytes) -> _Portrait:
+    with Image.open(BytesIO(data)) as image:
+        content_type = Image.MIME.get(image.format or "")
+        # JPEG 容器校验无法确认像素完整，上传前必须完成解码。
+        image.load()
+    if content_type not in {"image/jpeg", "image/png", "image/webp", "image/gif"}:
+        raise ValueError("头像格式不受 Emby 支持")
+    return _Portrait(content_type=content_type, data=data)
+
+
+class EmbyActorScrapeHandler(TaskHandler[EmbyActorScrapePayload, EmbyActorScrapeResult]):
+    def __init__(
+        self,
+        config: HotSettings,
+        factory: Callable[[], ActorCrawlerFactoryLike],
+        web_client: WebClient,
+        data_dir: Path,
+        client_factory: Callable[[MediaServerConfig], EmbyActorClient] = EmbyActorClient,
+    ) -> None:
+        super().__init__(payload_t=EmbyActorScrapePayload, result_t=EmbyActorScrapeResult)
+        self._server = config.media_server.model_copy(deep=True)
+        self._scraping = config.actor_scraping.model_copy(deep=True)
+        self._factory = factory
+        self._web_client = web_client
+        self._data_dir = data_dir
+        self._client_factory = client_factory
+
+    async def handle(self, payload: EmbyActorScrapePayload) -> TaskResult[EmbyActorScrapeResult]:
+        result = EmbyActorScrapeResult()
+        try:
+            require_emby(self._server)
+            if payload.server_key != emby_server_key(self._server):
+                raise ValueError("Emby 服务器配置已变化，请刷新媒体库后重新提交")
+            if not self._scraping.profile_sites and not self._scraping.image_sites:
+                raise ValueError("尚未配置演员刮削来源")
+            mapping = await read_emby_name_mapping(self._data_dir)
+            factory = self._factory()
+            # 覆盖整个来源调用范围，即使开启调试捕获，也只记录 HTTP 状态，不保存响应正文。
+            with skip_body_recording():
+                async with self._client_factory(self._server) as client:
+                    await self.report_progress(0, 0, "读取 Emby 媒体库演员")
+                    actors = await client.library_actors(payload.library_ids)
+                    result.requested = len(actors)
+                    for actor in actors:
+                        await self._sync_person(actor.id, actor.name, payload, client, factory, mapping, result)
+                        result.processed += 1
+                        await self.report_progress(result.processed, result.requested, actor.name)
+        except (MediaServerError, ValueError) as exc:
+            return TaskResult(success=False, error=str(exc), result=result)
+        return TaskResult(
+            success=result.failed == 0,
+            error="部分演员处理失败，请查看任务结果" if result.failed else None,
+            result=result,
+        )
+
+    async def _sync_person(
+        self,
+        person_id: str,
+        name: str,
+        payload: EmbyActorScrapePayload,
+        client: EmbyActorClient,
+        factory: ActorCrawlerFactoryLike,
+        mapping: Mapping[str, str | None],
+        result: EmbyActorScrapeResult,
+    ) -> None:
+        try:
+            person = await client.get_person(person_id)
+            if not payload.force and person.has_primary_image and _profile_complete(person):
+                result.skipped += 1
+                return
+            fetched = await fetch_emby_actor(
+                _lookup_names(person.name, mapping),
+                self._scraping,
+                factory,
+                need_image=payload.force or not person.has_primary_image,
+            )
+            # 刮削期间 Emby 可能被人工编辑，写回前重新读取，补充模式保护新出现的内容。
+            current = await client.get_person(person_id)
+            updates = emby_profile_updates(fetched.metadata, current, force=payload.force)
+            image: _Portrait | None = None
+            image_failed = False
+            if payload.force or not current.has_primary_image:
+                for url in fetched.metadata.image_urls:
+                    try:
+                        image = await _portrait(await self._web_client.get_bytes(url))
+                        break
+                    except SourceError, OSError, ValueError, UnidentifiedImageError, Image.DecompressionBombError:
+                        image_failed = True
+                if image is not None:
+                    image_failed = False
+            fields = updates.model_dump(by_alias=True, exclude_none=True)
+            if not fields and image is None:
+                if image_failed or fetched.errors:
+                    self._failed(result, name, "；".join(fetched.errors) or "头像下载或校验失败")
+                elif _profile_complete(current) and current.has_primary_image and not payload.force:
+                    result.skipped += 1
+                else:
+                    result.not_found += 1
+                    self._detail(result, name, "没有取得可用于补充的资料或头像")
+                return
+            errors: list[str] = []
+            if fields:
+                try:
+                    await client.update_person(current, fields)
+                    result.updated += 1
+                except MediaServerError as exc:
+                    errors.append(str(exc))
+            if image is not None:
+                try:
+                    await client.upload_primary_image(person_id, image.data, content_type=image.content_type)
+                    result.images += 1
+                except MediaServerError as exc:
+                    errors.append(str(exc))
+            elif image_failed:
+                errors.append("头像下载或校验失败")
+            if errors:
+                self._failed(result, name, "；".join(errors))
+        except MediaServerError as exc:
+            self._failed(result, name, str(exc))
+
+    @staticmethod
+    def _detail(result: EmbyActorScrapeResult, name: str, message: str) -> None:
+        if len(result.failures) < 50:
+            result.failures.append(f"{name}：{message}")
+
+    @classmethod
+    def _failed(cls, result: EmbyActorScrapeResult, name: str, message: str) -> None:
+        result.failed += 1
+        cls._detail(result, name, message)
