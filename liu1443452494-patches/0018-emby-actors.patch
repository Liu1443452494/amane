+"""Emby 媒体库及库内演员读取，写回复用既有人物接口。"""
+
+from __future__ import annotations
+
+import hashlib
+from typing import TYPE_CHECKING, Annotated, Self
+
+from httpx2 import HTTPError, InvalidURL
+from pydantic import BaseModel, Field, TypeAdapter, ValidationError
+
+from .media_server import MediaPerson, MediaServerClient, MediaServerError
+
+if TYPE_CHECKING:
+    from .config import MediaServerConfig
+
+
+type EmbyItemId = Annotated[str, Field(pattern=r"^[a-zA-Z0-9_-]+$", min_length=1, max_length=128)]
+
+
+class EmbyLibrary(BaseModel):
+    id: EmbyItemId
+    name: str
+
+
+class EmbyLibrariesResponse(BaseModel):
+    server_key: str
+    libraries: list[EmbyLibrary]
+
+
+class _VirtualFolder(BaseModel):
+    id: EmbyItemId = Field(alias="ItemId")
+    name: str = Field(alias="Name", min_length=1)
+
+
+class EmbyActorReference(BaseModel):
+    id: EmbyItemId
+    name: str
+
+
+class _PersonReference(BaseModel):
+    id: EmbyItemId | None = Field(default=None, alias="Id")
+    name: str = Field(alias="Name", min_length=1)
+    type: str = Field(default="", alias="Type")
+
+
+class _LibraryItem(BaseModel):
+    id: EmbyItemId = Field(alias="Id")
+    people: list[_PersonReference] | None = Field(default=None, alias="People")
+
+
+class _LibraryPage(BaseModel):
+    items: list[_LibraryItem] = Field(alias="Items")
+    total: int = Field(alias="TotalRecordCount", ge=0, strict=True)
+
+
+def emby_server_key(config: MediaServerConfig) -> str:
+    """任务仅保存连接配置的摘要，配置变化后必须重新选择媒体库。"""
+    return hashlib.sha256(config.model_dump_json().encode("utf-8")).hexdigest()
+
+
+def require_emby(config: MediaServerConfig) -> None:
+    if config.kind != "emby" or not config.enabled:
+        raise ValueError("请先保存有效的 Emby 服务器地址和 API Key")
+
+
+class EmbyActorClient(MediaServerClient):
+    async def __aenter__(self) -> Self:
+        return self
+
+    async def list_libraries(self) -> list[EmbyLibrary]:
+        try:
+            response = await self._client.get(self._base + "/Library/VirtualFolders", headers=self._headers())
+        except (HTTPError, InvalidURL) as exc:
+            raise MediaServerError("无法连接 Emby，请检查服务器地址和连接配置") from exc
+        self._raise_for_status(response.status_code, "")
+        try:
+            folders = TypeAdapter(list[_VirtualFolder]).validate_json(response.content)
+        except ValidationError:
+            raise MediaServerError("Emby 媒体库列表格式无效") from None
+        if len({folder.id for folder in folders}) != len(folders):
+            raise MediaServerError("Emby 媒体库列表包含重复标识，请刷新后重试")
+        return [EmbyLibrary(id=folder.id, name=folder.name) for folder in folders]
+
+    async def library_actors(self, library_ids: list[str]) -> list[EmbyActorReference]:
+        """通过库内影片的 People 取得人物 ID，避免全服人物检索扩大选定范围。"""
+        selected = set(library_ids)
+        available = {library.id for library in await self.list_libraries()}
+        if not selected or not selected <= available:
+            raise MediaServerError("所选 Emby 媒体库已失效，请刷新媒体库后重新选择")
+        actors: dict[str, EmbyActorReference] = {}
+        for library_id in dict.fromkeys(library_ids):
+            seen: set[str] = set()
+            start = 0
+            total: int | None = None
+            while True:
+                data = await self._get_json(
+                    "/Items",
+                    {
+                        "ParentId": library_id,
+                        "Recursive": "true",
+                        "IncludeItemTypes": "Movie,Episode",
+                        "Fields": "People",
+                        "EnableImages": "false",
+                        "EnableTotalRecordCount": "true",
+                        "SortBy": "SortName",
+                        "SortOrder": "Ascending",
+                        "StartIndex": start,
+                        "Limit": 200,
+                    },
+                )
+                try:
+                    page = _LibraryPage.model_validate(data)
+                except ValidationError:
+                    raise MediaServerError("Emby 库内影片列表格式无效，无法确认演员范围") from None
+                if total is not None and page.total != total:
+                    raise MediaServerError("读取期间 Emby 媒体库发生变化，请重试")
+                total = page.total
+                if not page.items:
+                    if start == total:
+                        break
+                    raise MediaServerError("Emby 库内影片分页提前结束，未取得完整演员列表")
+                for item in page.items:
+                    if item.id in seen:
+                        raise MediaServerError("Emby 库内影片分页重复，未取得完整演员列表")
+                    seen.add(item.id)
+                    for person in item.people or []:
+                        if person.type.casefold() != "actor":
+                            continue
+                        if person.id is None:
+                            raise MediaServerError("Emby 库内演员缺少人物 ID，无法确认写回对象")
+                        actors.setdefault(person.id, EmbyActorReference(id=person.id, name=person.name))
+                start += len(page.items)
+                if start > total:
+                    raise MediaServerError("Emby 库内影片数量超过分页总数，请重试")
+                if start == total:
+                    break
+        return list(actors.values())
+
+    async def get_person(self, person_id: str) -> MediaPerson:
+        data = await self._get_json(
+            f"/Items/{person_id}",
+            {
+                "Fields": (
+                    "Overview,OriginalTitle,PremiereDate,ProductionYear,ProductionLocations,"
+                    "CustomRating,Genres,Tags,People,Settings,ProviderIds"
+                ),
+                "EnableImages": "true",
+            },
+        )
+        person = MediaPerson.from_dto(data)
+        if person is None or person.id != person_id or data.get("Type") != "Person":
+            raise MediaServerError("Emby 人物详情与请求对象不一致，已停止该人物写回")
+        return person
+
+    @staticmethod
+    def _raise_for_status(status: int, body: str) -> None:
+        """错误记录仅保留状态信息，不包含可能携带人物资料的响应正文。"""
+        MediaServerClient._raise_for_status(status, "")
