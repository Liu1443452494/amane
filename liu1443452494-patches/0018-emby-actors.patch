+"""独立 Emby 任务的 gFriends 索引只在任务内存中使用。"""
+
+from pathlib import Path
+from unittest.mock import AsyncMock
+
+import pytest
+
+from amane.crawlers.factory import CrawlerFactory
+from amane.crawlers.http import HttpClient
+
+
+@pytest.mark.asyncio
+async def test_transient_factory_ignores_disk_cache_and_does_not_retain_task_index(
+    tmp_path: Path, http_client: HttpClient, mock_web_client: AsyncMock
+) -> None:
+    cache = tmp_path / "gfriends.json"
+    original_bytes = '{"演员.jpg": "https://images.test/Content/old/actor.jpg"}'.encode()
+    cache.write_bytes(original_bytes)
+    factory = CrawlerFactory(http_client, data_dir=tmp_path, gfriends_repo="https://github.com/example/portraits")
+    regular = await factory.get_actor("gfriends")
+    assert regular is not None
+    cached = await regular.fetch("演员")
+    assert cached is not None and cached.image_urls == ["https://images.test/Content/old/actor.jpg"]
+    mock_web_client.get_json.assert_not_awaited()
+
+    for target in ("first.jpg", "second.jpg"):
+        mock_web_client.get_json.return_value = {"Content": {"custom": {"演员.jpg": target}}}
+        transient = factory.for_transient_actors()
+        crawler = await transient.get_actor("gfriends")
+        assert crawler is not None
+        for _ in range(2):
+            result = await crawler.fetch("演员")
+            assert result is not None
+            assert result.image_urls == [
+                f"https://raw.githubusercontent.com/example/portraits/master/Content/custom/{target}"
+            ]
+    assert mock_web_client.get_json.await_count == 2
+    assert cache.read_bytes() == original_bytes
+    assert list(tmp_path.iterdir()) == [cache]
