+import type {
+  EmbyActorScrapePayload,
+  EmbyLibrariesResponse,
+  MediaServerConfig,
+} from "../../client/types.gen";
+
+/** 连接参数的任一变化都使旧媒体库选择失效，密钥不进入查询缓存键。 */
+export function sameEmbyConnection(
+  first: MediaServerConfig | undefined,
+  second: MediaServerConfig | undefined,
+): boolean {
+  return (
+    first?.kind === second?.kind &&
+    first?.url === second?.url &&
+    first?.api_key === second?.api_key &&
+    first?.verify_tls === second?.verify_tls
+  );
+}
+
+/** 提交时再次检查选择，避免刷新、未保存配置或失效媒体库绕过按钮状态。 */
+export function embyActorRequest(
+  libraries: EmbyLibrariesResponse | undefined,
+  selected: readonly string[],
+  force: boolean,
+  blocked: boolean,
+): EmbyActorScrapePayload | null {
+  if (blocked || !libraries || selected.length === 0) return null;
+  const available = new Set(libraries.libraries.map((library) => library.id));
+  if (selected.some((id) => !available.has(id))) return null;
+  return {
+    library_ids: [...new Set(selected)],
+    server_key: libraries.server_key,
+    force,
+  };
+}
