+import { Alert, Button, Divider, Group, MultiSelect, Stack, Switch, Text } from "@mantine/core";
+import { notifications } from "@mantine/notifications";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { Link } from "@tanstack/react-router";
+import { useId, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { listTasksQueryKey, scrapeEmbyActorsMutation } from "@/client/@tanstack/react-query.gen";
+import { getEmbyLibraries } from "@/client/sdk.gen";
+import type { MediaServerConfig } from "@/client/types.gen";
+import { extractErrorMessage } from "@/lib/api-error";
+import { embyActorRequest, sameEmbyConnection } from "./liu1443452494-emby-actors";
+
+interface EmbyActorsPanelProps {
+  server: MediaServerConfig | undefined;
+  unsaved: boolean;
+  saving: boolean;
+}
+
+export function EmbyActorsPanel({ server, unsaved, saving }: EmbyActorsPanelProps) {
+  const [connection, setConnection] = useState({ server, revision: 0 });
+  if (!sameEmbyConnection(connection.server, server)) {
+    setConnection({ server, revision: connection.revision + 1 });
+  }
+  if (server?.kind !== "emby") return null;
+  return (
+    <EmbyActorsControls
+      key={connection.revision}
+      server={server}
+      unsaved={unsaved}
+      saving={saving}
+      revision={connection.revision}
+    />
+  );
+}
+
+function EmbyActorsControls({
+  server,
+  unsaved,
+  saving,
+  revision,
+}: EmbyActorsPanelProps & { revision: number }) {
+  const { t } = useTranslation("settings");
+  const queryClient = useQueryClient();
+  const instance = useId();
+  const [selected, setSelected] = useState<string[]>([]);
+  const [force, setForce] = useState(false);
+  const [taskId, setTaskId] = useState<number | null>(null);
+  const configured = Boolean(server?.url && server?.api_key);
+  const libraries = useQuery({
+    queryKey: ["emby-library-choices", instance, revision],
+    queryFn: async () => {
+      const { data } = await getEmbyLibraries({ throwOnError: true });
+      return data;
+    },
+    enabled: configured && !unsaved && !saving,
+    retry: false,
+    gcTime: 0,
+    refetchOnWindowFocus: false,
+  });
+  const scrape = useMutation({
+    ...scrapeEmbyActorsMutation(),
+    onSuccess: (response) => {
+      setTaskId(response.task_id);
+      void queryClient.invalidateQueries({ queryKey: listTasksQueryKey() });
+      notifications.show({ message: t("embyActors.started"), color: "blue" });
+    },
+    onError: (error) =>
+      notifications.show({
+        message: extractErrorMessage(error, t("embyActors.failed")),
+        color: "red",
+      }),
+  });
+  const blocked =
+    !configured ||
+    unsaved ||
+    saving ||
+    libraries.isFetching ||
+    libraries.isError ||
+    scrape.isPending;
+  const request = embyActorRequest(libraries.data, selected, force, blocked);
+  return (
+    <Stack gap="md">
+      <Divider />
+      <Text fw={600}>{t("embyActors.title")}</Text>
+      <Text size="sm" c="dimmed">
+        {t("embyActors.description")}
+      </Text>
+      {(!configured || unsaved || saving) && (
+        <Text size="sm" c="dimmed">
+          {t("embyActors.saveFirst")}
+        </Text>
+      )}
+      {libraries.isError && (
+        <Alert color="red">
+          {extractErrorMessage(libraries.error, t("embyActors.loadFailed"))}
+        </Alert>
+      )}
+      <MultiSelect
+        label={t("embyActors.libraries")}
+        placeholder={
+          libraries.isFetching ? t("embyActors.loading") : t("embyActors.selectLibraries")
+        }
+        data={(libraries.data?.libraries ?? []).map((library) => ({
+          value: library.id,
+          label: library.name,
+        }))}
+        value={selected}
+        onChange={setSelected}
+        searchable
+        clearable
+        disabled={blocked}
+        nothingFoundMessage={t("embyActors.noLibraries")}
+      />
+      <Switch
+        label={t("embyActors.overwrite")}
+        description={t("embyActors.overwriteDescription")}
+        checked={force}
+        onChange={(event) => setForce(event.currentTarget.checked)}
+        disabled={blocked}
+      />
+      <Group>
+        <Button
+          type="button"
+          variant="default"
+          loading={libraries.isFetching}
+          disabled={!configured || unsaved || saving || scrape.isPending}
+          onClick={() => {
+            setSelected([]);
+            void libraries.refetch();
+          }}
+        >
+          {t("embyActors.refresh")}
+        </Button>
+        <Button
+          type="button"
+          loading={scrape.isPending}
+          disabled={request === null}
+          onClick={() => {
+            if (request !== null) scrape.mutate({ body: request });
+          }}
+        >
+          {t("embyActors.start")}
+        </Button>
+        {taskId !== null && (
+          <Button
+            renderRoot={(props) => (
+              <Link {...props} to="/tasks" search={{ type: ["emby_actor_scrape"], page: 1 }} />
+            )}
+            variant="light"
+          >
+            {t("embyActors.viewTask", { id: taskId })}
+          </Button>
+        )}
+      </Group>
+    </Stack>
+  );
+}
