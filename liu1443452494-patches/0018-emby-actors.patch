diff --git a/web/tests/emby-actors.test.mjs b/web/tests/emby-actors.test.mjs
new file mode 100644
index 00000000..bf055e02
--- /dev/null
+++ b/web/tests/emby-actors.test.mjs
@@ -0,0 +1,58 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  embyActorRequest,
+  sameEmbyConnection,
+} from "../src/components/media/liu1443452494-emby-actors.ts";
+
+const connection = {
+  kind: "emby",
+  url: "https://emby.test",
+  api_key: "test-key",
+  verify_tls: true,
+};
+
+for (const change of [
+  { kind: "jellyfin" },
+  { url: "https://another.test" },
+  { api_key: "changed-key" },
+  { verify_tls: false },
+]) {
+  test(`修改连接参数后废弃旧媒体库选择：${Object.keys(change)[0]}`, () => {
+    assert.equal(sameEmbyConnection(connection, { ...connection, ...change }), false);
+  });
+}
+
+test("读取相同配置不会误清除当前媒体库选择", () => {
+  assert.equal(sameEmbyConnection(connection, { ...connection }), true);
+  assert.equal(sameEmbyConnection(undefined, connection), false);
+});
+
+const libraries = {
+  server_key: "a".repeat(64),
+  libraries: [
+    { id: "one", name: "媒体库一" },
+    { id: "two", name: "媒体库二" },
+  ],
+};
+
+for (const { name, data, selected, blocked } of [
+  { name: "尚未读取媒体库", data: undefined, selected: ["one"], blocked: false },
+  { name: "未选择媒体库", data: libraries, selected: [], blocked: false },
+  { name: "选择中包含已删除媒体库", data: libraries, selected: ["one", "removed"], blocked: false },
+  { name: "配置未保存或请求尚未完成", data: libraries, selected: ["one"], blocked: true },
+]) {
+  test(`${name}时不能提交任务`, () => {
+    assert.equal(embyActorRequest(data, selected, false, blocked), null);
+  });
+}
+
+for (const force of [false, true]) {
+  test(`${force ? "覆盖" : "补充"}模式只提交所选媒体库和服务器摘要`, () => {
+    assert.deepEqual(embyActorRequest(libraries, ["two", "two"], force, false), {
+      library_ids: ["two"],
+      server_key: libraries.server_key,
+      force,
+    });
+  });
+}
