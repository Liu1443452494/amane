+class _ScriptedCrawler:
+    def __init__(
+        self,
+        hits: dict[str, ActorMetadata | Exception | None],
+        change: Callable[[], None] | None = None,
+    ) -> None:
+        self.hits = hits
+        self.change = change
+        self.calls: list[str] = []
+
+    async def fetch(self, name: str) -> ActorMetadata | None:
+        self.calls.append(name)
+        if self.change is not None:
+            self.change()
+        recorder = get_recorder()
+        if recorder is not None:
+            recorder.record_http(
+                method="GET",
+                url="https://source.test/actor",
+                status=200,
+                error=None,
+                content_type="text/html",
+                body="不应保存的完整演员正文".encode(),
+                elapsed_ms=1,
+            )
+        result = self.hits.get(name)
+        if isinstance(result, Exception):
+            raise result
+        return result
+
