+"""媒体服务器设置页的 Emby 媒体库选择与独立演员任务。"""
+
+from fastapi import APIRouter, HTTPException
+from pydantic import BaseModel
+
+from ...db.models import TaskType
+from ...handlers.models import EmbyActorScrapePayload
+from ...liu1443452494_emby_client import (
+    EmbyActorClient,
+    EmbyLibrariesResponse,
+    emby_server_key,
+    require_emby,
+)
+from ...media_server import MediaServerError
+from ..deps import ConfigDep, RepoDep
+
+router = APIRouter(prefix="/media-server/emby", tags=["media_server"])
+
+
+class EmbyActorTaskResponse(BaseModel):
+    task_id: int
+
+
+@router.get("/libraries")
+async def get_emby_libraries(config: ConfigDep) -> EmbyLibrariesResponse:
+    server = config.hot.media_server.model_copy(deep=True)
+    try:
+        require_emby(server)
+    except ValueError as exc:
+        raise HTTPException(422, detail=str(exc)) from exc
+    try:
+        async with EmbyActorClient(server) as client:
+            libraries = await client.list_libraries()
+    except MediaServerError as exc:
+        raise HTTPException(502, detail=str(exc)) from exc
+    return EmbyLibrariesResponse(server_key=emby_server_key(server), libraries=libraries)
+
+
+@router.post("/actors/scrape", status_code=202)
+async def scrape_emby_actors(req: EmbyActorScrapePayload, config: ConfigDep, repo: RepoDep) -> EmbyActorTaskResponse:
+    try:
+        require_emby(config.hot.media_server)
+    except ValueError as exc:
+        raise HTTPException(422, detail=str(exc)) from exc
+    if req.server_key != emby_server_key(config.hot.media_server):
+        raise HTTPException(409, detail="Emby 服务器配置已变化，请刷新媒体库后重新选择")
+    task = await repo.create_task(TaskType.EMBY_ACTOR_SCRAPE, req)
+    assert task.id is not None
+    return EmbyActorTaskResponse(task_id=task.id)
