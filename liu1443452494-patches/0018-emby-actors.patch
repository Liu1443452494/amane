+"""Emby 选库范围、分页完整性与按人物 ID 写回。"""
+
+from __future__ import annotations
+
+import base64
+import json
+
+import httpx2
+import pytest
+
+from amane.config import MediaServerConfig
+from amane.liu1443452494_emby_client import EmbyActorClient
+from amane.media_server import MediaServerError
+from tests.media_server.test_client import _person_dto
+
+
+def _config() -> MediaServerConfig:
+    return MediaServerConfig(kind="emby", url="https://emby.test/emby", api_key="test-key")
+
+
+@pytest.mark.asyncio
+async def test_selected_libraries_deduplicate_actors_and_preserve_person_fields() -> None:
+    requests: list[httpx2.Request] = []
+
+    def respond(request: httpx2.Request) -> httpx2.Response:
+        requests.append(request)
+        path = request.url.path.removeprefix("/emby")
+        if request.method == "POST":
+            return httpx2.Response(204)
+        if path == "/Library/VirtualFolders":
+            return httpx2.Response(200, json=[{"ItemId": key, "Name": key} for key in ("a", "b", "outside")])
+        if path == "/Items/p1":
+            return httpx2.Response(200, json=_person_dto(person_id="p1", name="原显示名", lock_data=True))
+        assert path == "/Items"
+        library = request.url.params["ParentId"]
+        start = int(request.url.params["StartIndex"])
+        assert library in {"a", "b"}
+        assert request.url.params["IncludeItemTypes"] == "Movie,Episode"
+        assert request.url.params["Fields"] == "People"
+        if library == "a" and start == 0:
+            return httpx2.Response(
+                200,
+                json={
+                    "Items": [
+                        {
+                            "Id": "film-1",
+                            "People": [
+                                {"Id": "p1", "Name": "同名演员", "Type": "Actor"},
+                                {"Id": "director", "Name": "导演", "Type": "Director"},
+                            ],
+                        }
+                    ],
+                    "TotalRecordCount": 2,
+                },
+            )
+        if library == "a":
+            assert start == 1
+            return httpx2.Response(200, json={"Items": [{"Id": "film-2", "People": None}], "TotalRecordCount": 2})
+        return httpx2.Response(
+            200,
+            json={
+                "Items": [
+                    {
+                        "Id": "film-3",
+                        "People": [
+                            {"Id": "p1", "Name": "同名演员", "Type": "Actor"},
+                            {"Id": "p2", "Name": "同名演员", "Type": "Actor"},
+                        ],
+                    }
+                ],
+                "TotalRecordCount": 1,
+            },
+        )
+
+    async with EmbyActorClient(_config(), client=httpx2.AsyncClient(transport=httpx2.MockTransport(respond))) as client:
+        actors = await client.library_actors(["a", "b", "a"])
+        assert [actor.id for actor in actors] == ["p1", "p2"]
+        person = await client.get_person("p1")
+        await client.update_person(person, {"Overview": "新简介"})
+        await client.upload_primary_image("p1", b"portrait", content_type="image/png")
+
+    for request in requests:
+        assert request.headers["X-Emby-Token"] == _config().api_key
+        assert "Token=" in request.headers["Authorization"]
+        assert "api_key" not in request.url.params
+    writes = [request for request in requests if request.method == "POST"]
+    assert [request.url.path for request in writes] == ["/emby/Items/p1", "/emby/Items/p1/Images/Primary"]
+    data = json.loads(writes[0].content)
+    assert data["Name"] == "原显示名"
+    assert data["Overview"] == "新简介"
+    assert data["LockData"] is True
+    assert data["LockedFields"] == []
+    assert data["ProviderIds"] == {"Imdb": "tt1"}
+    assert data["PremiereDate"] == "1990-01-01T00:00:00"
+    assert data["Tags"] == ["tag"]
+    assert "People" not in data and "ImageTags" not in data
+    assert writes[1].headers["Content-Type"] == "image/png"
+    assert base64.b64decode(writes[1].content) == b"portrait"
+
+
+@pytest.mark.parametrize(
+    ("pages", "message"),
+    [
+        ([{"Items": [], "TotalRecordCount": 1}], "提前结束"),
+        ([{"Items": [], "TotalRecordCount": True}], "格式无效"),
+        ([{"Items": []}], "格式无效"),
+        ([{"Items": [{"Id": "f"}], "TotalRecordCount": 0}], "超过分页总数"),
+        (
+            [{"Items": [{"Id": "f", "People": [{"Name": "演员", "Type": "Actor"}]}], "TotalRecordCount": 1}],
+            "缺少人物 ID",
+        ),
+        (
+            [
+                {
+                    "Items": [{"Id": "f", "People": [{"Id": "../other", "Name": "演员", "Type": "Actor"}]}],
+                    "TotalRecordCount": 1,
+                }
+            ],
+            "格式无效",
+        ),
+        (
+            [{"Items": [{"Id": "f"}], "TotalRecordCount": 2}, {"Items": [{"Id": "f"}], "TotalRecordCount": 2}],
+            "分页重复",
+        ),
+        ([{"Items": [{"Id": "f"}], "TotalRecordCount": 2}, {"Items": [], "TotalRecordCount": 3}], "发生变化"),
+    ],
+)
+@pytest.mark.asyncio
+async def test_incomplete_library_never_returns_a_partial_actor_list(
+    pages: list[dict[str, object]], message: str
+) -> None:
+    remaining = iter(pages)
+
+    def respond(request: httpx2.Request) -> httpx2.Response:
+        if request.url.path.endswith("/VirtualFolders"):
+            return httpx2.Response(200, json=[{"ItemId": "a", "Name": "影片"}])
+        return httpx2.Response(200, json=next(remaining))
+
+    async with EmbyActorClient(_config(), client=httpx2.AsyncClient(transport=httpx2.MockTransport(respond))) as client:
+        with pytest.raises(MediaServerError, match=message):
+            await client.library_actors(["a"])
+
+
+@pytest.mark.parametrize("selected", [[], ["removed"]])
+@pytest.mark.asyncio
+async def test_invalid_selection_stops_before_loading_films(selected: list[str]) -> None:
+    def respond(request: httpx2.Request) -> httpx2.Response:
+        assert request.url.path.endswith("/VirtualFolders")
+        return httpx2.Response(200, json=[{"ItemId": "a", "Name": "影片"}])
+
+    async with EmbyActorClient(_config(), client=httpx2.AsyncClient(transport=httpx2.MockTransport(respond))) as client:
+        with pytest.raises(MediaServerError, match="媒体库已失效"):
+            await client.library_actors(selected)
+
+
+@pytest.mark.parametrize(
+    ("status", "data", "message"),
+    [
+        (401, {"private": "不应写入错误的正文"}, "认证失败"),
+        (403, {"private": "不应写入错误的正文"}, "权限不足"),
+        (500, {"private": "不应写入错误的正文"}, "HTTP 500"),
+        (200, {"Items": []}, "格式无效"),
+        (200, [{"ItemId": "a", "Name": "影片"}, {"ItemId": "a", "Name": "重复"}], "重复标识"),
+        (200, [{"ItemId": "a"}], "格式无效"),
+    ],
+)
+@pytest.mark.asyncio
+async def test_library_errors_are_clear_and_exclude_response_bodies(status: int, data: object, message: str) -> None:
+    def respond(request: httpx2.Request) -> httpx2.Response:
+        return httpx2.Response(status, json=data)
+
+    async with EmbyActorClient(_config(), client=httpx2.AsyncClient(transport=httpx2.MockTransport(respond))) as client:
+        with pytest.raises(MediaServerError, match=message) as error:
+            await client.list_libraries()
+        assert "不应写入错误的正文" not in str(error.value)
+
+
+@pytest.mark.parametrize("change", [{"Id": "wrong"}, {"Type": "Movie"}, {"Name": ""}])
+@pytest.mark.asyncio
+async def test_person_identity_must_match(change: dict[str, object]) -> None:
+    def respond(request: httpx2.Request) -> httpx2.Response:
+        assert request.method == "GET"
+        return httpx2.Response(200, json={**_person_dto(person_id="p1"), **change})
+
+    async with EmbyActorClient(_config(), client=httpx2.AsyncClient(transport=httpx2.MockTransport(respond))) as client:
+        with pytest.raises(MediaServerError, match="人物详情与请求对象不一致"):
+            await client.get_person("p1")
+
+
+@pytest.mark.asyncio
+async def test_empty_library_is_valid() -> None:
+    def respond(request: httpx2.Request) -> httpx2.Response:
+        data: object = [{"ItemId": "a", "Name": "空媒体库"}]
+        if request.url.path.endswith("/Items"):
+            data = {"Items": [], "TotalRecordCount": 0}
+        return httpx2.Response(200, json=data)
+
+    async with EmbyActorClient(_config(), client=httpx2.AsyncClient(transport=httpx2.MockTransport(respond))) as client:
+        assert await client.library_actors(["a"]) == []
