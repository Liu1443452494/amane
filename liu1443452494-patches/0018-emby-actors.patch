+class _EmbyState:
+    def __init__(self, people: list[dict[str, object]], *, fail_ids: tuple[str, ...] = ()) -> None:
+        self.people = {str(person["Id"]): person for person in people}
+        self.fail_ids = fail_ids
+        self.fail_posts: tuple[str, ...] = ()
+        self.requests: list[httpx2.Request] = []
+        self.updates: list[dict[str, object]] = []
+        self.uploads: list[httpx2.Request] = []
+
+    def respond(self, request: httpx2.Request) -> httpx2.Response:
+        self.requests.append(request)
+        if request.url.path == "/Library/VirtualFolders":
+            return httpx2.Response(200, json=[{"ItemId": "library", "Name": "测试媒体库"}])
+        if request.url.path == "/Items":
+            return httpx2.Response(
+                200,
+                json={
+                    "Items": [
+                        {
+                            "Id": "film",
+                            "People": [
+                                {"Id": person_id, "Name": person["Name"], "Type": "Actor"}
+                                for person_id, person in self.people.items()
+                            ],
+                        }
+                    ],
+                    "TotalRecordCount": 1,
+                },
+            )
+        person_id = request.url.path.split("/")[2]
+        if person_id in self.fail_ids:
+            return httpx2.Response(503, text="不允许写入任务记录的服务器正文")
+        if request.method == "GET":
+            return httpx2.Response(200, json=self.people[person_id])
+        if request.url.path in self.fail_posts:
+            return httpx2.Response(500, text="不允许保存的写入响应正文")
+        if request.url.path.endswith("/Images/Primary"):
+            self.uploads.append(request)
+        else:
+            self.updates.append(json.loads(request.content))
+        return httpx2.Response(204)
+
+    def client(self, config: MediaServerConfig) -> EmbyActorClient:
+        return EmbyActorClient(config, client=httpx2.AsyncClient(transport=httpx2.MockTransport(self.respond)))
+
