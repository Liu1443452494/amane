+"""旧数据库升级保留路径投影, 人工保护默认关闭; 回退不丢失原有媒体记录."""
+
+from pathlib import Path
+
+from alembic import command
+from sqlalchemy import create_engine, inspect, text
+from sqlmodel import Session, select
+
+from amane.db.models import MediaFile
+from amane.parsing import Mosaic, WatermarkMode
+from tests.helpers import alembic_config
+
+
+def test_watermark_migration_preserves_existing_media(tmp_path: Path) -> None:
+    config = alembic_config(tmp_path / "迁移.db")
+    command.upgrade(config, "9054ebacea29")
+    engine = create_engine(f"sqlite:///{tmp_path / '迁移.db'}")
+    with engine.begin() as connection:
+        connection.execute(
+            text(
+                "INSERT INTO media_files (path,status,library_id,created_at,updated_at,mosaic,definition,has_subtitle_in_name,has_external_subtitle) VALUES ('/原目录/SSIS-345-UC-4K.mp4','SCRAPED',1,'2026-10-01','2026-10-01','CRACKED','4K',1,1)"
+            )
+        )
+    command.upgrade(config, "head")
+    with Session(engine) as session:
+        media = session.exec(select(MediaFile)).one()
+        assert media.path == "/原目录/SSIS-345-UC-4K.mp4" and media.mosaic is Mosaic.CRACKED
+        assert media.has_subtitle and media.definition == "4K"
+        assert media.watermark_mode is WatermarkMode.AUTO and media.watermark_subtitle is None
+        assert media.watermark_mosaic is None and not media.watermark_definition_locked
+        assert media.organized_outputs is None
+    command.downgrade(config, "9054ebacea29")
+    with engine.connect() as connection:
+        assert "watermark_mode" not in {column["name"] for column in inspect(connection).get_columns("media_files")}
+        assert connection.execute(text("SELECT path,definition FROM media_files")).one() == (
+            "/原目录/SSIS-345-UC-4K.mp4",
+            "4K",
+        )
+    command.upgrade(config, "head")
+    engine.dispose()
