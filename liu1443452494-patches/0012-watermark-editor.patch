@@ -0,0 +1,72 @@
+"""人工设置在 NFO 与实际图片角标中保持一致."""
+
+from pathlib import Path
+from xml.etree import ElementTree
+
+import pytest
+from PIL import Image
+
+from amane.db.models import MediaFile, Metadata
+from amane.db.watermarks import effective_file_info
+from amane.media import apply_cover_watermarks_from_info, write_nfo
+from amane.parsing import ContentType, MosaicNature, WatermarkMode, parse_file_info
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("nature", list(MosaicNature))
+async def test_effective_watermarks_replace_conflicting_nfo_labels(tmp_path: Path, nature: MosaicNature) -> None:
+    media = MediaFile(
+        library_id=1,
+        path="HEYZO-1234-C-4K.mp4",
+        watermark_mode=WatermarkMode.MANUAL,
+        watermark_subtitle=False,
+        watermark_mosaic=nature,
+        watermark_definition=None,
+        watermark_definition_locked=True,
+    )
+    metadata = Metadata(
+        number="HEYZO-1234",
+        content_type=ContentType.UNCENSORED,
+        title="保持原题",
+        tags=["剧情", "中文字幕", "无码", "4K", "演员"],
+    )
+    info = effective_file_info(media, parse_file_info(media.path, has_external_subtitle=True))
+    nfo = tmp_path / "影片.nfo"
+    assert await write_nfo(metadata, nfo, file_info=info)
+    label = {
+        MosaicNature.CENSORED: "有码",
+        MosaicNature.UNCENSORED: "无码",
+        MosaicNature.CRACKED: "破解",
+        MosaicNature.LEAKED: "流出",
+    }[nature]
+    root = ElementTree.parse(nfo).getroot()
+    for element in ("tag", "genre"):
+        assert [node.text for node in root.findall(element)] == ["剧情", "演员", label]
+    assert root.findtext("title") == "HEYZO-1234 保持原题"
+    assert metadata.tags == ["剧情", "中文字幕", "无码", "4K", "演员"]
+
+    stamps = tmp_path / "水印"
+    stamps.mkdir()
+    for name, color in (("uncensored", "red"), ("cracked", "green"), ("leaked", "purple")):
+        Image.new("RGBA", (32, 16), color).save(stamps / f"{name}.png")
+    poster = tmp_path / "poster.jpg"
+    Image.new("RGB", (300, 200), "blue").save(poster)
+    original = poster.read_bytes()
+    changed = apply_cover_watermarks_from_info(poster, info, metadata.content_type, watermark_dir=stamps, scale=0.1)
+    assert changed is (nature is not MosaicNature.CENSORED)
+    if nature is MosaicNature.CENSORED:
+        assert poster.read_bytes() == original
+    else:
+        with Image.open(poster) as image:
+            pixel = image.convert("RGB").getpixel((15, 12))
+            assert isinstance(pixel, tuple)
+            red, green, blue = pixel
+            if nature is MosaicNature.CRACKED:
+                assert green > red + 40 and green > blue + 40
+            elif nature is MosaicNature.UNCENSORED:
+                assert red > green + 80 and red > blue + 80
+            else:
+                assert red > green + 40 and blue > green + 40
+            # 人工破解或流出不得额外继承番号的无码水印, 第二个位置保持原背景.
+            second = image.convert("RGB").getpixel((15, 40))
+            assert isinstance(second, tuple) and second[2] > 200 and second[0] < 30
