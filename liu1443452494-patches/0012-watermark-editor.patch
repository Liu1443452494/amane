+"""水印接口的文件范围、磁盘延迟更新及非法请求."""
+
+from pathlib import Path
+
+import pytest
+from httpx2 import AsyncClient
+
+from amane.db.repository import Repository
+from amane.media import write_nfo
+from amane.parsing import parse_file_info
+
+
+@pytest.mark.asyncio
+async def test_watermark_http(client: AsyncClient, repo: Repository, safe_path: Path) -> None:
+    library = await repo.create_library(
+        name="测试库", path=str(safe_path), video_template="{raw_name}.{ext}", subtitle_extensions=[".srt"]
+    )
+    metadata = await repo.upsert_metadata(number="SSIS-345", title="原有标题", tags=["剧情"])
+    assert library.id is not None and metadata.id is not None
+    source = safe_path / "SSIS-345-C-1080p.mp4"
+    source.write_bytes(b"video")
+    media = await repo.create_media_file(library.id, path=str(source), metadata_id=metadata.id)
+    assert media.id is not None
+    other = await repo.create_media_file(library.id, path=str(safe_path / "SSIS-345.mp4"), metadata_id=metadata.id)
+    nfo = source.with_suffix(".nfo")
+    assert await write_nfo(metadata, nfo, file_info=parse_file_info(source))
+    original_nfo = nfo.read_bytes()
+    endpoint = f"media/{media.id}/watermarks"
+    current = await client.get(endpoint)
+    assert current.status_code == 200
+    assert current.json()["mode"] == "auto" and current.json()["has_subtitle"]
+    assert "4K" in current.json()["definition_options"]
+    for body in (
+        {"mode": "manual", "has_subtitle": None},
+        {"mode": "manual", "has_subtitle": 0},
+        {"mode": "manual", "definition": "未知档位"},
+        {"mode": "manual", "mosaic": None},
+        {"mode": "auto", "definition": None},
+        {"mode": "manual", "path": "禁止修改路径"},
+        {},
+    ):
+        response = await client.patch(endpoint, json=body)
+        assert response.status_code == 422 and response.json()["detail"]
+
+    updated = await client.patch(endpoint, json={"mode": "manual", "has_subtitle": False, "definition": None})
+    assert updated.status_code == 200 and updated.json()["changed"]
+    assert not updated.json()["has_subtitle"] and updated.json()["definition"] is None
+    assert set(updated.json()["protected_fields"]) == {"has_subtitle", "definition"}
+    assert nfo.read_bytes() == original_nfo and source.read_bytes() == b"video"
+    stored = await repo.get_media_file(media.id)
+    assert stored is not None and stored.organized_outputs is not None
+    assert (await client.get(f"media/{other.id}/watermarks")).json()["mode"] == "auto"
+    detail = (await client.get(f"metadata/{metadata.id}")).json()
+    assert detail["metadata"]["title"] == "原有标题"
+    assert not detail["metadata"]["file_phase"]["has_subtitle"]
+    assert (await client.get("tasks")).json()["total"] == 0
+    repeated = await client.patch(endpoint, json={"mode": "manual", "has_subtitle": False, "definition": None})
+    assert not repeated.json()["changed"]
+
+    (safe_path / "外挂字幕.srt").write_text("字幕", encoding="utf-8")
+    restored = await client.patch(endpoint, json={"mode": "auto"})
+    assert restored.status_code == 200 and restored.json()["changed"]
+    assert restored.json()["protected_fields"] == [] and restored.json()["has_subtitle"]
+    assert restored.json()["definition"] == "1080p"
+    assert nfo.read_bytes() == original_nfo
+    for missing in (
+        await client.get("media/999999/watermarks"),
+        await client.patch("media/999999/watermarks", json={"mode": "auto"}),
+    ):
+        assert missing.status_code == 404 and missing.json()["detail"] == "媒体文件不存在"
