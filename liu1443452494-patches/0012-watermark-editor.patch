+        trailer_template=prefix + "trailer.mp4",
+    )
+    metadata = await repo.upsert_metadata(
+        number="SSIS-345",
+        title="原有标题",
+        tags=["剧情"],
+        thumb_urls=["https://example.test/thumb.jpg"],
+        poster_urls=["https://example.test/poster.jpg"],
+        trailer_urls=["https://example.test/trailer.mp4"],
+        extrafanart_urls={"test": ["https://example.test/1.jpg", "https://example.test/2.jpg"]},
+    )
+    assert library.id is not None and metadata.id is not None
+    media = await repo.create_media_file(
+        library.id, path=str(source), metadata_id=metadata.id, status=MediaFileStatus.SCRAPED
+    )
+    assert media.id is not None
+    handler = OrganizeHandler(
+        repo,
+        HotSettings(watermark=WatermarkConfig(enabled=True)),
+        resource_store,
+        web_client=cast("WebClient", FakeClient()),
+    )
+    result = await handler.handle(OrganizePayload(library_id=library.id, media_file_ids=[media.id]))
+    assert result.result is not None and result.result.organized == 1
+    paths = resolve_paths(library, metadata, ext="mp4", source_path=source, file_info=parse_file_info(source))
+    return WatermarkCase(library, metadata, media, paths, handler)
