+"""产物快照只清理可验证的旧文件, 不越过安全目录或删除替换后的文件."""
+
+from pathlib import Path
+
+import pytest
+
+from amane.db.models import Library, Metadata
+from amane.media import write_nfo
+from amane.organize import resolve_paths
+from amane.organize.watermark_outputs import (
+    OutputPath,
+    OutputProtection,
+    capture_output_baseline,
+    finish_output_snapshot,
+    read_output_snapshot,
+)
+from amane.parsing import parse_file_info
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "condition", ["replace", "outside", "modified", "failed", "wrong_number", "shared", "invalid_snapshot"]
+)
+async def test_output_cleanup_boundaries(tmp_path: Path, condition: str) -> None:
+    library_root = tmp_path / "媒体库"
+    library_root.mkdir()
+    source = library_root / "SSIS-345.mp4"
+    source.write_bytes(b"video")
+    old_dir = tmp_path / "安全目录外" if condition == "outside" else library_root / "旧元数据"
+    old_nfo = old_dir / "SSIS-345.nfo"
+    library = Library(
+        path=str(library_root),
+        name="测试",
+        video_template="{raw_name}.{ext}",
+        nfo_template=old_nfo.as_posix(),
+        copy_resources=[],
+    )
+    metadata = Metadata(number="SSIS-345", title="原题")
+    await write_nfo(metadata, old_nfo)
+    if condition == "wrong_number":
+        await write_nfo(Metadata(number="SSIS-999"), old_nfo)
+    baseline = await capture_output_baseline(
+        library, metadata, source, parse_file_info(source), safe_dirs=None, actor_genders={}
+    )
+    if condition == "invalid_snapshot":
+        baseline = '{"version":99,"number":"SSIS-345","outputs":[]}'
+    previous = read_output_snapshot(baseline, metadata.number)
+    new_nfo = library_root / "新元数据" / "SSIS-345.nfo"
+    await write_nfo(metadata, new_nfo)
+    if condition == "modified":
+        old_nfo.write_text("用户修改后的内容", encoding="utf-8")
+    protection = OutputProtection()
+    if condition == "shared":
+        protection.directories.append(old_dir)
+    result = await finish_output_snapshot(
+        previous,
+        [OutputPath(kind="nfo", path=new_nfo)],
+        library_root=library_root,
+        safe_dirs=(),
+        protection=protection,
+        success=condition != "failed",
+    )
+    assert new_nfo.exists() and source.read_bytes() == b"video"
+    assert old_nfo.exists() is (condition != "replace")
+    assert read_output_snapshot(result, metadata.number).outputs[-1].path == new_nfo
+    if condition == "replace":
+        assert not old_dir.exists() and library_root.is_dir()
+    if condition == "wrong_number":
+        assert previous.outputs == []
+    if condition == "modified":
+        assert old_nfo.read_text(encoding="utf-8") == "用户修改后的内容"
+
+
+@pytest.mark.asyncio
+async def test_changed_parent_is_not_followed_during_cleanup(tmp_path: Path) -> None:
+    source = tmp_path / "SSIS-345.mp4"
+    source.write_bytes(b"video")
+    library = Library(
+        name="测试",
+        path=str(tmp_path),
+        video_template="{raw_name}.{ext}",
+        nfo_template="旧目录/{number}.nfo",
+        copy_resources=[],
+    )
+    metadata = Metadata(number="SSIS-345")
+    paths = resolve_paths(library, metadata, ext="mp4", source_path=source, file_info=parse_file_info(source))
+    await write_nfo(metadata, paths.nfo)
+    baseline = await capture_output_baseline(
+        library, metadata, source, parse_file_info(source), safe_dirs=(), actor_genders={}
+    )
+    moved = tmp_path / "移动后的目录"
+    paths.nfo.parent.rename(moved)
+    paths.nfo.parent.mkdir()
+    paths.nfo.write_text("另一个文件", encoding="utf-8")
+    new_nfo = tmp_path / "新目录" / "SSIS-345.nfo"
+    await write_nfo(metadata, new_nfo)
+    await finish_output_snapshot(
+        read_output_snapshot(baseline, metadata.number),
+        [OutputPath(kind="nfo", path=new_nfo)],
+        library_root=tmp_path,
+        safe_dirs=(),
+        protection=OutputProtection(),
+        success=True,
+    )
+    assert paths.nfo.read_text(encoding="utf-8") == "另一个文件"
+    assert (moved / "SSIS-345.nfo").exists()
