+import {
+  Alert,
+  Button,
+  Checkbox,
+  Group,
+  Input,
+  Loader,
+  Modal,
+  Select,
+  Stack,
+  Text,
+  Tooltip,
+} from "@mantine/core";
+import { notifications } from "@mantine/notifications";
+import { IconPencil } from "@tabler/icons-react";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { useState } from "react";
+import { useTranslation } from "react-i18next";
+import {
+  getMediaQueryKey,
+  getMediaWatermarksOptions,
+  getMediaWatermarksQueryKey,
+  getMetadataQueryKey,
+  listMediaQueryKey,
+  listMetadataQueryKey,
+  listTasksQueryKey,
+  submitTaskMutation,
+  updateMediaWatermarksMutation,
+} from "@/client/@tanstack/react-query.gen";
+import type {
+  MediaFileResponse,
+  MediaWatermarkResponse,
+  MediaWatermarkUpdateRequest,
+  MosaicNature,
+} from "@/client/types.gen";
+import { EnumToggle } from "@/components/common/enum-toggle";
+import { extractErrorMessage } from "@/lib/api-error";
+import { confirm } from "@/lib/confirm";
+import { buildWatermarkUpdate, type WatermarkDraft } from "./watermark-edit";
+
+const MODES: readonly MediaWatermarkResponse["mode"][] = ["auto", "manual"];
+// 文案提取器按常量名解析取值, 不与列表筛选的马赛克枚举共用名称.
+const WATERMARK_NATURES: readonly MosaicNature[] = ["censored", "uncensored", "cracked", "leaked"];
+
+interface WatermarkEditButtonProps {
+  metadataId: number;
+  metadataNumber: string;
+  files: MediaFileResponse[];
+}
+
+export function WatermarkEditButton({
+  metadataId,
+  metadataNumber,
+  files,
+}: WatermarkEditButtonProps) {
+  const { t } = useTranslation(["metadata", "common"]);
+  const [opened, setOpened] = useState(false);
+  const queryClient = useQueryClient();
+  const update = useMutation(updateMediaWatermarksMutation());
+  const organize = useMutation(submitTaskMutation());
+  const saving = update.isPending || organize.isPending;
+
+  async function save(media: MediaFileResponse, body: MediaWatermarkUpdateRequest) {
+    try {
+      const result = await update.mutateAsync({ path: { media_id: media.id }, body });
+      queryClient.setQueryData(
+        getMediaWatermarksQueryKey({ path: { media_id: media.id } }),
+        result,
+      );
+      void queryClient.invalidateQueries({
+        queryKey: getMetadataQueryKey({ path: { metadata_id: metadataId } }),
+      });
+      void queryClient.invalidateQueries({ queryKey: listMetadataQueryKey() });
+      void queryClient.invalidateQueries({ queryKey: listMediaQueryKey() });
+      void queryClient.invalidateQueries({
+        queryKey: getMediaQueryKey({ path: { media_id: media.id } }),
+      });
+      setOpened(false);
+      notifications.show({ message: t("watermark.saved"), color: "blue" });
+      if (!result.changed) return;
+
+      const organizeNow = await confirm({
+        title: t("watermark.organizeTitle"),
+        message: (
+          <Stack gap="xs">
+            <Text size="sm">{t("watermark.organizeMessage")}</Text>
+            <Text size="xs" c="dimmed" style={{ overflowWrap: "anywhere" }}>
+              {media.path}
+            </Text>
+          </Stack>
+        ),
+        confirmLabel: t("watermark.organizeNow"),
+        cancelLabel: t("watermark.organizeLater"),
+        danger: false,
+      });
+      if (!organizeNow) return;
+
+      await organize.mutateAsync({
+        body: {
+          type: "organize",
+          library_id: media.library_id,
+          media_file_ids: [media.id],
+        },
+      });
+      void queryClient.invalidateQueries({ queryKey: listTasksQueryKey() });
+      notifications.show({ message: t("common:toast.organizeStarted"), color: "blue" });
+    } catch (error) {
+      notifications.show({
+        message: extractErrorMessage(error, t("common:toast.operationFailed")),
+        color: "red",
+      });
+    }
+  }
+
+  return (
+    <>
+      <Tooltip label={t("watermark.noFiles")} disabled={files.length > 0}>
+        <Button
+          size="xs"
+          variant="light"
+          leftSection={<IconPencil size={14} />}
+          disabled={files.length === 0}
+          loading={saving}
+          onClick={() => setOpened(true)}
+        >
+          {t("watermark.action")}
+        </Button>
+      </Tooltip>
+      {opened && (
+        <WatermarkEditDialog
+          files={files}
+          metadataNumber={metadataNumber}
+          saving={saving}
+          onClose={() => setOpened(false)}
+          onSave={(media, body) => void save(media, body)}
+        />
+      )}
+    </>
+  );
+}
+
+function WatermarkEditDialog({
+  files,
+  metadataNumber,
+  saving,
+  onClose,
+  onSave,
+}: {
+  files: MediaFileResponse[];
+  metadataNumber: string;
+  saving: boolean;
+  onClose: () => void;
+  onSave: (media: MediaFileResponse, body: MediaWatermarkUpdateRequest) => void;
+}) {
+  const { t } = useTranslation(["metadata", "common"]);
+  const [selectedId, setSelectedId] = useState<string | null>(
+    files.length === 1 ? String(files[0].id) : null,
+  );
+  const media = files.find((file) => String(file.id) === selectedId);
+  const settings = useQuery({
+    ...getMediaWatermarksOptions({ path: { media_id: media?.id ?? 0 } }),
+    enabled: media != null,
+    refetchOnMount: "always",
+    refetchOnWindowFocus: false,
+    refetchOnReconnect: false,
+  });
+
+  return (
+    <Modal
+      opened
+      onClose={() => {
+        if (!saving) onClose();
+      }}
+      title={`${t("watermark.action")} — ${metadataNumber}`}
+      size="lg"
+      closeOnEscape={!saving}
+      closeOnClickOutside={!saving}
+      withCloseButton={!saving}
+    >
+      <Stack>
+        {files.length > 1 ? (
+          <Select
+            label={t("watermark.file")}
+            placeholder={t("watermark.selectFile")}
+            data={files.map((file) => ({ value: String(file.id), label: file.path }))}
+            value={selectedId}
+            onChange={setSelectedId}
+            disabled={saving}
+            allowDeselect={false}
+            searchable
+          />
+        ) : (
+          <Text size="sm" style={{ overflowWrap: "anywhere" }}>
+            {media?.path}
+          </Text>
+        )}
+        {!media ? (
+          <Text size="sm" c="dimmed">
+            {files.length === 0 ? t("watermark.noFiles") : t("watermark.selectFile")}
+          </Text>
+        ) : settings.isError ? (
+          <Alert color="red">
+            <Stack gap="xs">
+              <Text size="sm">
+                {extractErrorMessage(settings.error, t("common:toast.operationFailed"))}
+              </Text>
+              <Button variant="light" size="xs" onClick={() => void settings.refetch()}>
+                {t("common:actions.retry")}
+              </Button>
+            </Stack>
+          </Alert>
+        ) : !settings.isFetchedAfterMount || !settings.data ? (
+          <Group gap="xs">
+            <Loader size="sm" />
+            <Text size="sm">{t("common:status.loading")}</Text>
+          </Group>
+        ) : (
+          <WatermarkEditForm
+            key={media.id}
+            initial={settings.data}
+            saving={saving}
+            onClose={onClose}
+            onSave={(body) => onSave(media, body)}
+          />
+        )}
+      </Stack>
+    </Modal>
+  );
+}
+
+function WatermarkEditForm({
+  initial,
+  saving,
+  onClose,
+  onSave,
+}: {
+  initial: MediaWatermarkResponse;
+  saving: boolean;
+  onClose: () => void;
+  onSave: (body: MediaWatermarkUpdateRequest) => void;
+}) {
+  const { t } = useTranslation(["metadata", "common"]);
+  const [draft, setDraft] = useState<WatermarkDraft>(initial);
+  const disabled = saving || draft.mode === "auto";
+  const shown = draft.mode === "auto" ? initial : draft;
+  const update = buildWatermarkUpdate(initial, draft);
+
+  return (
+    <Stack>
+      <Input.Wrapper label={t("watermark.mode")}>
+        <EnumToggle
+          options={MODES}
+          value={draft.mode}
+          onChange={(mode) => setDraft((previous) => ({ ...previous, mode }))}
+          getLabel={(mode) => t(`watermark.${mode}`)}
+          disabled={saving}
+        />
+      </Input.Wrapper>
+      <Text size="sm" c="dimmed">
+        {draft.mode === "auto" ? t("watermark.autoHint") : t("watermark.manualHint")}
+      </Text>
+      <Checkbox
+        label={t("filePhase.subtitle")}
+        checked={shown.has_subtitle}
+        disabled={disabled}
+        onChange={(event) => {
+          const hasSubtitle = event.currentTarget.checked;
+          setDraft((previous) => ({ ...previous, has_subtitle: hasSubtitle }));
+        }}
+      />
+      <Input.Wrapper label={t("watermark.mosaic")}>
+        <EnumToggle
+          options={WATERMARK_NATURES}
+          value={shown.mosaic}
+          onChange={(mosaic) => setDraft((previous) => ({ ...previous, mosaic }))}
+          getLabel={(nature) => t(`filePhase.${nature}`)}
+          disabled={disabled}
+          fullWidth
+        />
+      </Input.Wrapper>
+      <Input.Wrapper label={t("search.definition")}>
+        <EnumToggle
+          options={["", ...initial.definition_options]}
+          value={shown.definition ?? ""}
+          onChange={(definition) =>
+            setDraft((previous) => ({ ...previous, definition: definition || null }))
+          }
+          getLabel={(definition) => definition || t("watermark.noDefinition")}
+          disabled={disabled}
+          fullWidth
+        />
+      </Input.Wrapper>
+      <Group justify="flex-end">
+        <Button variant="default" onClick={onClose} disabled={saving}>
+          {t("common:actions.cancel")}
+        </Button>
+        <Button
+          loading={saving}
+          disabled={update === null}
+          onClick={() => {
+            if (update !== null) onSave(update);
+          }}
+        >
+          {t("common:actions.save")}
+        </Button>
+      </Group>
+    </Stack>
+  );
+}
