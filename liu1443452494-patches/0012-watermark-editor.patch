+async def _save(repo: Repository, case: WatermarkCase, update: WatermarkUpdate) -> MediaFile:
+    assert case.media.id is not None
+    current = await repo.get_media_file(case.media.id)
+    assert current is not None and current.id is not None
+    baseline = current.organized_outputs
+    if baseline is None:
+        baseline = await capture_output_baseline(
+            case.library,
+            case.metadata,
+            Path(current.path),
+            effective_file_info(current, parse_file_info(current.path)),
+            safe_dirs=(),
+            actor_genders={},
+        )
+    result = await repo.update_media_watermarks(current.id, update, organized_outputs=baseline)
+    assert result is not None and result.changed
+    return result.media
+
+
+async def _organize(case: WatermarkCase) -> None:
+    assert case.library.id is not None and case.media.id is not None
+    result = await case.handler.handle(OrganizePayload(library_id=case.library.id, media_file_ids=[case.media.id]))
+    assert result.result is not None and result.result.organized == 1 and result.result.failed == 0
+
+
+def _paths(case: WatermarkCase, media: MediaFile) -> ResolvedPaths:
+    return resolve_paths(
+        case.library,
+        case.metadata,
+        ext="mp4",
+        source_path=Path(media.path),
+        file_info=effective_file_info(media, parse_file_info(media.path)),
+    )
