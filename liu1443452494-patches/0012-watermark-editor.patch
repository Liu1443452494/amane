--- /dev/null
+++ b/web/src/components/media/watermark-edit.ts
@@ -0,0 +1,32 @@
+import type { MediaWatermarkResponse, MediaWatermarkUpdateRequest } from "@/client/types.gen";
+
+export type WatermarkDraft = Pick<
+  MediaWatermarkResponse,
+  "mode" | "has_subtitle" | "mosaic" | "definition"
+>;
+
+/** 自动只清除人工设置；手动省略未修改字段，保留明确的 false 与空分辨率。 */
+export function buildWatermarkUpdate(
+  initial: WatermarkDraft,
+  draft: WatermarkDraft,
+): MediaWatermarkUpdateRequest | null {
+  if (draft.mode === "auto") {
+    return initial.mode === "auto" ? null : { mode: "auto" };
+  }
+
+  const update: MediaWatermarkUpdateRequest = { mode: "manual" };
+  let changed = initial.mode !== draft.mode;
+  if (draft.has_subtitle !== initial.has_subtitle) {
+    update.has_subtitle = draft.has_subtitle;
+    changed = true;
+  }
+  if (draft.mosaic !== initial.mosaic && draft.mosaic !== null) {
+    update.mosaic = draft.mosaic;
+    changed = true;
+  }
+  if (draft.definition !== initial.definition) {
+    update.definition = draft.definition;
+    changed = true;
+  }
+  return changed ? update : null;
+}
