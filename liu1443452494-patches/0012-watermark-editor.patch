+"""人工水印的部分更新、否定值、自动恢复及查询一致性."""
+
+import asyncio
+from pathlib import Path
+
+import pytest
+from pydantic import ValidationError
+
+from amane.api.models.media import to_media_file_response
+from amane.db.models import MediaFile
+from amane.db.repository import Repository
+from amane.db.watermarks import WatermarkUpdate, apply_watermark_update, effective_file_info, watermark_state
+from amane.parsing import ContentType, Mosaic, MosaicNature, WatermarkField, WatermarkMode, parse_file_info
+
+
+@pytest.mark.parametrize(
+    ("body", "message"),
+    [
