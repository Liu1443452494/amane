+@pytest_asyncio.fixture
+async def watermark_case(repo: Repository, resource_store: ResourceStore, tmp_path: Path) -> WatermarkCase:
+    root = tmp_path / "媒体库"
+    root.mkdir()
+    source = root / "SSIS-345.mp4"
