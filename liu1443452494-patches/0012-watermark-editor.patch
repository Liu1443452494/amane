+class OutputPath(BaseModel):
+    kind: OutputKind
+    path: Path
+
+
+class OutputStamp(OutputPath):
+    parent: Path
+    size: int
+    modified_ns: int
+    changed_ns: int
+    device: int
+    inode: int
+    symlink: bool
+
+
+class OutputSnapshot(BaseModel):
+    version: Literal[1] = 1
+    number: str
+    outputs: list[OutputStamp] = Field(default_factory=list)
+
+
+class OutputProtection(BaseModel):
+    paths: set[str] = Field(default_factory=set)
+    directories: list[Path] = Field(default_factory=list)
+
+    def contains(self, path: Path) -> bool:
+        return path_key(path) in self.paths or any(
+            path_is_under(path.parent, directory) for directory in self.directories
+        )
+
+
+def read_output_snapshot(value: str | None, number: str) -> OutputSnapshot:
+    if value is not None:
+        try:
+            snapshot = OutputSnapshot.model_validate_json(value)
+            if snapshot.number.casefold() == number.casefold():
+                return snapshot
+        except ValidationError:
+            pass
+        logger.warning("整理产物快照无效", number=number)
+    return OutputSnapshot(number=number)
+
+
+def planned_outputs(paths: ResolvedPaths, *, write_nfo: bool, kinds: Sequence[LibraryResource]) -> list[OutputPath]:
+    outputs: list[OutputPath] = []
+    if write_nfo:
+        outputs.append(OutputPath(kind="nfo", path=paths.nfo))
+    if paths.link is not None:
+        outputs.append(OutputPath(kind="link", path=paths.link))
+    outputs.extend(
+        output
+        for output in (
+            OutputPath(kind="thumb", path=paths.thumb),
+            OutputPath(kind="poster", path=paths.poster),
+            OutputPath(kind="fanart", path=paths.fanart),
+            OutputPath(kind="trailer", path=paths.trailer),
+        )
+        if LibraryResource(output.kind) in kinds
+    )
+    return outputs
+
+
+def _stamp(output: OutputPath) -> OutputStamp | None:
+    try:
+        info = output.path.lstat()
+        symlink = stat.S_ISLNK(info.st_mode)
+        if not stat.S_ISREG(info.st_mode) and not (symlink and output.kind == "link"):
+            return None
+        return OutputStamp(
+            kind=output.kind,
+            path=output.path,
+            parent=resolved_path(output.path.parent),
+            size=info.st_size,
+            modified_ns=info.st_mtime_ns,
+            changed_ns=info.st_ctime_ns,
+            device=info.st_dev,
+            inode=info.st_ino,
+            symlink=symlink,
+        )
+    except OSError:
+        return None
+
+
+def _nfo_matches(path: Path, number: str) -> bool:
+    try:
+        if path.stat().st_size > 2_000_000 or path.is_symlink():
+            return False
+        content = path.read_bytes()
+        if b"<!DOCTYPE" in content.upper() or b"<!ENTITY" in content.upper():
+            return False
+        return ElementTree.fromstring(content).findtext("num", "").casefold() == number.casefold()
+    except OSError, ElementTree.ParseError, ValueError:
+        return False
+
+
+@in_thread
+def capture_output_baseline(
+    library: Library,
+    metadata: Metadata,
+    source: Path,
+    file_info: FileInfo,
+    *,
+    safe_dirs: Sequence[Path] | None,
+    actor_genders: Mapping[str, ActorGender],
+) -> str:
+    """首次编辑前记录旧模板位置; NFO 只验证番号归属, 不用于恢复元数据."""
+    paths = resolve_paths(
+        library,
+        metadata,
+        ext=source.suffix.lstrip("."),
+        source_path=source,
+        file_info=file_info,
+        safe_dirs=safe_dirs,
+        actor_genders=actor_genders,
+    )
+    snapshot = OutputSnapshot(number=metadata.number)
+    dest = video_dest(paths.video.parent, paths.video.stem, source)
+    owns_outputs = _nfo_matches(paths.nfo, metadata.number)
+    if not owns_outputs and not paths.nfo.exists():
+        with suppress(OSError):
+            owns_outputs = source.samefile(dest)
+    if not owns_outputs:
+        return snapshot.model_dump_json()
+    outputs = planned_outputs(paths, write_nfo=library.write_nfo, kinds=library.copy_resources)
+    if LibraryResource.extrafanart in library.copy_resources and paths.extrafanart_dir.is_dir():
+        outputs.extend(
+            OutputPath(kind="extrafanart", path=path)
+            for path in paths.extrafanart_dir.glob("*.jpg")
+            if path.stem.isdecimal()
+        )
+    # 独立元数据目录中的字幕不在视频旁边, 首次编辑时一并记录其位置.
+    subtitle_dirs = {paths.nfo.parent, paths.link.parent if paths.link is not None else paths.nfo.parent}
+    for directory in subtitle_dirs:
+        if path_key(directory) != path_key(source.parent):
+            outputs.extend(
+                OutputPath(kind="subtitle", path=path)
+                for path in discover_subtitles.sync(directory / source.name, library.subtitle_extensions, file_info)
+            )
+    snapshot.outputs = [stamp for output in outputs if (stamp := _stamp(output)) is not None]
+    return snapshot.model_dump_json()
+
+
+async def shared_output_protection(
+    repo: Repository,
+    media: MediaFile,
+    metadata: Metadata,
+    *,
+    safe_dirs: Sequence[Path] | None,
+) -> OutputProtection:
+    """同番号的其它版本可以共享附属文件; 当前版本不得删除它们仍在使用的路径."""
+    protection = OutputProtection(paths={path_key(media.path)})
+    if metadata.id is None:
+        return protection
+    peers = await repo.list_media_files(metadata_ids=[metadata.id], limit=None)
+    actor_genders = {actor.name: actor.gender for actor in await repo.get_actors_by_names(metadata.actors)}
+    for peer in peers:
+        if peer.id == media.id:
+            continue
+        protection.paths.add(path_key(peer.path))
+        protection.paths.update(
+            path_key(output.path) for output in read_output_snapshot(peer.organized_outputs, metadata.number).outputs
+        )
+        library = await repo.get_library(peer.library_id)
+        if library is None:
+            continue
+        try:
+            paths = await _peer_paths(library, metadata, peer, safe_dirs, actor_genders)
+            if peer.organized_outputs is None:
+                baseline = await capture_output_baseline(
+                    library,
+                    metadata,
+                    Path(peer.path),
+                    effective_file_info(
+                        peer, parse_file_info(peer.path, has_external_subtitle=peer.has_external_subtitle)
+                    ),
+                    safe_dirs=safe_dirs,
+                    actor_genders=actor_genders,
+                )
+                protection.paths.update(
+                    path_key(output.path) for output in read_output_snapshot(baseline, metadata.number).outputs
+                )
+        except OSError, ValueError:
+            continue
+        protection.paths.update(
+            path_key(output.path)
+            for output in planned_outputs(paths, write_nfo=library.write_nfo, kinds=library.copy_resources)
+        )
+        if LibraryResource.extrafanart in library.copy_resources:
+            protection.directories.append(paths.extrafanart_dir)
+    return protection
+
+
+@in_thread
+def _peer_paths(
+    library: Library,
+    metadata: Metadata,
+    peer: MediaFile,
+    safe_dirs: Sequence[Path] | None,
+    actor_genders: Mapping[str, ActorGender],
+) -> ResolvedPaths:
+    return resolve_paths(
+        library,
+        metadata,
+        ext=Path(peer.path).suffix.lstrip("."),
+        source_path=Path(peer.path),
+        file_info=effective_file_info(
+            peer, parse_file_info(peer.path, has_external_subtitle=peer.has_external_subtitle)
+        ),
+        safe_dirs=safe_dirs,
+        actor_genders=actor_genders,
+    )
+
+
+@in_thread
+def retained_subtitle_sources(
+    snapshot: OutputSnapshot,
+    library_root: Path,
+    safe_dirs: Sequence[Path] | None,
+    protection: OutputProtection,
+) -> list[Path]:
+    roots = [library_root, *(safe_dirs or [])]
+    return [
+        output.path
+        for output in snapshot.outputs
+        if output.kind == "subtitle"
+        and not protection.contains(output.path)
+        and output.parent == resolved_path(output.path.parent)
+        and (safe_dirs is None or any(is_descendant(output.path.parent, root) for root in roots))
+        and _stamp(output) == output
+    ]
+
+
+@in_thread
+def finish_output_snapshot(
+    previous: OutputSnapshot,
+    outputs: Sequence[OutputPath],
+    *,
+    library_root: Path,
+    safe_dirs: Sequence[Path] | None,
+    protection: OutputProtection,
+    success: bool,
+) -> str:
+    current = [stamp for output in outputs if (stamp := _stamp(output)) is not None]
+    keys = {path_key(output.path) for output in current}
+    kinds = {output.kind for output in current}
+    remaining: list[OutputStamp] = []
+    roots = [library_root, *(safe_dirs or [])]
+    for old in previous.outputs:
+        if path_key(old.path) in keys:
+            continue
+        if not success or old.kind not in kinds or protection.contains(old.path):
+            remaining.append(old)
+            continue
+        if not old.path.is_absolute() or old.parent != resolved_path(old.path.parent):
+            logger.warning("保留位置发生变化的旧产物", path=str(old.path))
+            remaining.append(old)
+            continue
+        if safe_dirs is not None and not any(is_descendant(old.path.parent, root) for root in roots):
+            logger.warning("保留安全目录外的旧产物", path=str(old.path))
+            remaining.append(old)
+            continue
+        actual = _stamp(old)
+        if actual is None:
+            continue
+        if actual != old:
+            logger.warning("保留已被外部修改的旧产物", path=str(old.path))
+            remaining.append(old)
+            continue
+        try:
+            old.path.unlink()
+            logger.info("已删除被替代的整理产物", path=str(old.path))
+            parent = old.path.parent
+            while parent != parent.parent and all(path_key(parent) != path_key(root) for root in roots):
+                if safe_dirs is not None and not any(is_descendant(parent, root) for root in roots):
+                    break
+                try:
+                    parent.rmdir()
+                except OSError:
+                    break
+                parent = parent.parent
+        except OSError as exc:
+            remaining.append(old)
+            logger.warning("旧整理产物删除失败", path=str(old.path), error=str(exc))
+    return OutputSnapshot(number=previous.number, outputs=[*remaining, *current]).model_dump_json()
