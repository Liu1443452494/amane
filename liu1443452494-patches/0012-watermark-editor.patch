+    library = await repo.create_library(
+        name="测试",
+        path=str(root),
+        video_template="{raw_name}.{ext}",
+        copy_resources=list(LibraryResource),
+        nfo_template=prefix + "{number}.nfo",
+        thumb_template=prefix + "thumb.jpg",
+        poster_template=prefix + "poster.jpg",
+        fanart_template=prefix + "fanart.jpg",
