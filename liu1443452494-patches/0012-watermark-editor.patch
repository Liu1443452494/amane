diff --git a/web/tests/watermark-edit.test.mjs b/web/tests/watermark-edit.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4f37218d40bd874a7ea9d75a23ae20063478fb72
--- /dev/null
+++ b/web/tests/watermark-edit.test.mjs
@@ -0,0 +1,72 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { buildWatermarkUpdate } from "../src/components/media/watermark-edit.ts";
+
+const automatic = {
+  mode: "auto",
+  has_subtitle: true,
+  mosaic: "censored",
+  definition: "1080p",
+};
+const manual = { ...automatic, mode: "manual" };
+
+for (const { name, initial, draft, expected } of [
+  {
+    name: "取消已有中字时提交明确的否定值，其他标记不受保护",
+    initial: automatic,
+    draft: { ...automatic, mode: "manual", has_subtitle: false },
+    expected: { mode: "manual", has_subtitle: false },
+  },
+  {
+    name: "清除分辨率时保留显式空值",
+    initial: manual,
+    draft: { ...manual, definition: null },
+    expected: { mode: "manual", definition: null },
+  },
+  {
+    name: "修改马赛克状态时不提交未改动字段",
+    initial: manual,
+    draft: { ...manual, mosaic: "cracked" },
+    expected: { mode: "manual", mosaic: "cracked" },
+  },
+  {
+    name: "已有人工设置切回自动时丢弃尚未保存的字段草稿",
+    initial: manual,
+    draft: { mode: "auto", has_subtitle: false, mosaic: "leaked", definition: "4K" },
+    expected: { mode: "auto" },
+  },
+  {
+    name: "自动切换手动后未修改任何字段时仅保存模式",
+    initial: automatic,
+    draft: manual,
+    expected: { mode: "manual" },
+  },
+  {
+    name: "修改后恢复原值不产生保存请求",
+    initial: manual,
+    draft: { ...manual },
+    expected: null,
+  },
+  {
+    name: "自动模式中的未保存手动草稿不产生保存请求",
+    initial: automatic,
+    draft: { ...automatic, has_subtitle: false, definition: null },
+    expected: null,
+  },
+  {
+    name: "尚未识别的马赛克性质保持省略，不提交非法空值",
+    initial: { ...automatic, mosaic: null },
+    draft: { ...automatic, mode: "manual", mosaic: null, has_subtitle: false },
+    expected: { mode: "manual", has_subtitle: false },
+  },
+  {
+    name: "同时修改多个字段时完整保存本次变化",
+    initial: automatic,
+    draft: { mode: "manual", has_subtitle: false, mosaic: "uncensored", definition: "4K" },
+    expected: { mode: "manual", has_subtitle: false, mosaic: "uncensored", definition: "4K" },
+  },
+]) {
+  test(name, () => {
+    assert.deepEqual(buildWatermarkUpdate(initial, draft), expected);
+  });
+}
