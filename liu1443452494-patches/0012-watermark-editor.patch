+@pytest.mark.asyncio
+async def test_existing_outputs_are_replaced_then_markers_can_be_removed(
+    repo: Repository, resource_store: ResourceStore, watermark_case: WatermarkCase
+) -> None:
+    case = watermark_case
+    old_nfo = case.paths.nfo.read_bytes()
+    original_poster = case.paths.poster.read_bytes()
+    unrelated = case.paths.nfo.parent / "用户说明.txt"
+    unrelated.write_text("保留用户文件", encoding="utf-8")
+    edited = await _save(
+        repo,
+        case,
+        WatermarkUpdate(mode=WatermarkMode.MANUAL, has_subtitle=True, mosaic=MosaicNature.CRACKED, definition="4K"),
+    )
+    new_paths = _paths(case, edited)
+    assert case.paths.nfo.read_bytes() == old_nfo and not new_paths.nfo.exists()
+    assert len(read_output_snapshot(edited.organized_outputs, case.metadata.number).outputs) == 7
+    await _organize(case)
+    assert new_paths.nfo.is_file() and new_paths.poster.read_bytes() != original_poster
+    assert new_paths.fanart.read_bytes() == original_poster
+    assert not case.paths.nfo.exists() and not case.paths.poster.exists() and not case.paths.extrafanart_dir.exists()
+    assert unrelated.read_text(encoding="utf-8") == "保留用户文件" and Path(edited.path).read_bytes() == b"video"
+    root = ElementTree.parse(new_paths.nfo).getroot()
+    assert [node.text for node in root.findall("tag")] == ["剧情", "中文字幕", "破解", "4K"]
+    assert [node.text for node in root.findall("genre")] == ["剧情", "中文字幕", "破解", "4K"]
+    assert root.findtext("title") == "SSIS-345 原有标题"
+    resource = await resource_store.resolve(case.metadata.poster_urls[0])
+    assert resource is not None and resource.read_bytes() == original_poster
+
+    # 所有角标取消后从缓存原图重建, 不能继续处理上次叠加水印的图片.
+    cleared = await _save(
+        repo,
+        case,
+        WatermarkUpdate(mode=WatermarkMode.MANUAL, has_subtitle=False, mosaic=MosaicNature.CENSORED, definition=None),
+    )
+    await _organize(case)
+    cleared_paths = _paths(case, cleared)
+    assert cleared_paths.poster.read_bytes() == original_poster
+    assert not new_paths.nfo.parent.exists()
+    assert [node.text for node in ElementTree.parse(cleared_paths.nfo).getroot().findall("tag")] == ["剧情", "有码"]
+    assert case.metadata.id is not None
+    metadata = await repo.get_metadata(case.metadata.id)
+    assert metadata is not None and metadata.title == "原有标题" and metadata.tags == ["剧情"]
+    restored = await _save(repo, case, WatermarkUpdate(mode=WatermarkMode.AUTO))
+    await _organize(case)
+    assert restored.watermark_subtitle is None and not restored.watermark_definition_locked
+    assert _paths(case, restored).poster.read_bytes() == original_poster
