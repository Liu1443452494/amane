new file mode 100644
index 0000000000000000000000000000000000000000..4dade740a3bee643b430d70897ebef663c61293b
--- /dev/null
+++ b/src/amane/db/watermarks.py
@@ -0,0 +1,135 @@
+"""媒体文件的人工水印设置与统一生效值."""
+
+from dataclasses import replace
+from typing import Self
+
+from pydantic import BaseModel, ConfigDict, Field, StrictBool, field_validator, model_validator
+
+from ..parsing import (
+    DEFINITION_VALUES,
+    ContentType,
+    FileInfo,
+    Mosaic,
+    MosaicNature,
+    WatermarkField,
+    WatermarkMode,
+    mosaic_nature,
+)
+from .models import MediaFile
+
+
+class WatermarkUpdate(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    mode: WatermarkMode
+    has_subtitle: StrictBool | None = None
+    mosaic: MosaicNature | None = None
+    definition: str | None = None
+
+    @field_validator("definition")
+    @classmethod
+    def known_definition(cls, value: str | None) -> str | None:
+        if value is not None and value not in DEFINITION_VALUES:
+            raise ValueError(f"未知分辨率: {value}")
+        return value
+
+    @model_validator(mode="after")
+    def validate_fields(self) -> Self:
+        changed_fields = self.model_fields_set - {"mode"}
+        if self.mode is WatermarkMode.AUTO and changed_fields:
+            raise ValueError("自动模式不能指定人工水印字段")
+        if "has_subtitle" in changed_fields and self.has_subtitle is None:
+            raise ValueError("中字必须明确选择有或无")
+        if "mosaic" in changed_fields and self.mosaic is None:
+            raise ValueError("马赛克性质必须选择有码、无码、破解或流出")
+        return self
+
+
+class WatermarkState(BaseModel):
+    mode: WatermarkMode
+    has_subtitle: bool
+    mosaic: MosaicNature | None
+    definition: str | None
+    protected_fields: list[WatermarkField] = Field(default_factory=list)
+
+
+class WatermarkUpdateResult(BaseModel):
+    media: MediaFile
+    changed: bool
+
+
+def protected_watermark_fields(media: MediaFile) -> frozenset[WatermarkField]:
+    if media.watermark_mode is WatermarkMode.AUTO:
+        return frozenset()
+    fields: set[WatermarkField] = set()
+    if media.watermark_subtitle is not None:
+        fields.add(WatermarkField.SUBTITLE)
+    if media.watermark_mosaic is not None:
+        fields.add(WatermarkField.MOSAIC)
+    if media.watermark_definition_locked:
+        fields.add(WatermarkField.DEFINITION)
+    return frozenset(fields)
+
+
+def effective_mosaic(media: MediaFile) -> Mosaic | None:
+    if media.watermark_mode is WatermarkMode.MANUAL and media.watermark_mosaic is not None:
+        if media.watermark_mosaic is MosaicNature.CENSORED:
+            return None
+        return Mosaic(media.watermark_mosaic)
+    return media.mosaic
+
+
+def effective_definition(media: MediaFile) -> str | None:
+    if media.watermark_mode is WatermarkMode.MANUAL and media.watermark_definition_locked:
+        return media.watermark_definition
+    return media.definition
+
+
+def watermark_state(media: MediaFile, content_type: ContentType | None) -> WatermarkState:
+    fields = protected_watermark_fields(media)
+    return WatermarkState(
+        mode=media.watermark_mode,
+        has_subtitle=media.has_subtitle,
+        mosaic=media.watermark_mosaic if WatermarkField.MOSAIC in fields else mosaic_nature(media.mosaic, content_type),
+        definition=effective_definition(media),
+        protected_fields=[field for field in WatermarkField if field in fields],
+    )
+
+
+def effective_file_info(media: MediaFile, parsed: FileInfo) -> FileInfo:
+    """只替换受保护字段; 解析得到的番号、分集及其他上下文继续沿用."""
+    fields = protected_watermark_fields(media)
+    subtitle = media.watermark_subtitle if WatermarkField.SUBTITLE in fields else None
+    nature = media.watermark_mosaic if WatermarkField.MOSAIC in fields else None
+    mosaic = parsed.mosaic
+    if nature is not None:
+        mosaic = None if nature is MosaicNature.CENSORED else Mosaic(nature)
+    return replace(
+        parsed,
+        has_subtitle_in_name=subtitle if subtitle is not None else parsed.has_subtitle_in_name,
+        has_external_subtitle=False if subtitle is not None else parsed.has_external_subtitle,
+        mosaic=mosaic,
+        mosaic_override=nature,
+        definition=media.watermark_definition if WatermarkField.DEFINITION in fields else parsed.definition,
+        watermark_fields=fields,
+    )
+
+
+def apply_watermark_update(media: MediaFile, update: WatermarkUpdate, content_type: ContentType | None) -> None:
+    """仅保护实际改变的字段; 重复提交当前值不扩大保护范围."""
+    previous = watermark_state(media, content_type)
+    media.watermark_mode = update.mode
+    if update.mode is WatermarkMode.AUTO:
+        media.watermark_subtitle = None
+        media.watermark_mosaic = None
+        media.watermark_definition = None
+        media.watermark_definition_locked = False
+        return
+    fields = update.model_fields_set
+    if "has_subtitle" in fields and update.has_subtitle != previous.has_subtitle:
+        media.watermark_subtitle = update.has_subtitle
+    if "mosaic" in fields and update.mosaic != previous.mosaic:
+        media.watermark_mosaic = update.mosaic
+    if "definition" in fields and update.definition != previous.definition:
+        media.watermark_definition = update.definition
+        media.watermark_definition_locked = True
