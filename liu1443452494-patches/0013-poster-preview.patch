index 0000000000000000000000000000000000000000..0a6ea4c2ce613cdc3d9e06a4062dc029bb6e3544
--- /dev/null
+++ b/web/src/components/media/liu1443452494-detail-actions.tsx
@@ -0,0 +1,56 @@
+import { Box, Button, Group, Tooltip } from "@mantine/core";
+import { useDisclosure } from "@mantine/hooks";
+import { IconPhoto } from "@tabler/icons-react";
+import type { ComponentProps } from "react";
+import { useTranslation } from "react-i18next";
+import { FanartLightbox } from "@/components/media/fanart-lightbox";
+import { ProcessingLogButton } from "@/components/media/liu1443452494-processing-log";
+import { WatermarkEditButton } from "@/components/media/watermark-edit-dialog";
+
+type DetailActionsProps = ComponentProps<typeof WatermarkEditButton> & {
+  posterSrc: string | null;
+};
+
+export function DetailActions({
+  metadataId,
+  metadataNumber,
+  files,
+  posterSrc,
+}: DetailActionsProps) {
+  return (
+    <Group gap="xs" wrap="wrap">
+      <ProcessingLogButton metadataId={metadataId} />
+      <WatermarkEditButton
+        key={`watermark-${metadataId}`}
+        metadataId={metadataId}
+        metadataNumber={metadataNumber}
+        files={files}
+      />
+      <PosterPreviewButton key={`poster-${metadataId}`} posterSrc={posterSrc} />
+    </Group>
+  );
+}
+
+function PosterPreviewButton({ posterSrc }: { posterSrc: string | null }) {
+  const { t } = useTranslation("metadata");
+  const [opened, preview] = useDisclosure(false);
+
+  return (
+    <>
+      <Tooltip label={t("detail.previewPoster.empty")} disabled={Boolean(posterSrc)}>
+        <Box display="inline-block">
+          <Button
+            size="xs"
+            variant="light"
+            leftSection={<IconPhoto size={14} />}
+            disabled={!posterSrc}
+            onClick={preview.open}
+          >
+            {t("detail.previewPoster.action")}
+          </Button>
+        </Box>
+      </Tooltip>
+      {opened && posterSrc && <FanartLightbox images={[posterSrc]} onClose={preview.close} />}
+    </>
+  );
+}
