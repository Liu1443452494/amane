+def _western_card_matches(link_number: str, labels: list[str], query_number: str) -> bool:
+    """欧美紧凑链接必须与卡片唯一番号、查询片商及有效日期同时一致。"""
+    western = parse_western_number(query_number)
+    compact = re.fullmatch(r"(.+)-(\d{6})", link_number)
+    if western is None or compact is None or len(labels) != 1:
+        return False
+    date = compact[2]
+    candidate = parse_western_number(f"{compact[1]}.{date[:2]}.{date[2:4]}.{date[4:]}")
+    return is_same_number(labels[0], query_number) and candidate == western
+
