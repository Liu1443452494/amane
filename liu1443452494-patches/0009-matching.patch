@@ -0,0 +1,75 @@
+"""自用补丁的真实搜索响应回放及欧美编号身份边界。"""
+
+from pathlib import Path
+
+import pytest
+
+from amane.crawlers.models import SearchQuery
+from amane.crawlers.sites.freejavbt import FreejavbtCrawler, _western_card_matches
+from tests.crawlers.driven import build_mock, build_mock_web, http_client, load_toml
+
+CASES = tuple(sorted((Path(__file__).parent / "liu1443452494_cases" / "freejavbt").glob("*.toml")))
+
+
+@pytest.mark.parametrize("case_path", CASES, ids=[path.stem for path in CASES])
+@pytest.mark.asyncio
+async def test_recorded_search(case_path: Path) -> None:
+    """复用数据驱动设施，补丁用例独立于需要另行获取的上游夹具仓库。"""
+    config = load_toml(case_path)["search"]
+    mock_web = build_mock_web()
+    build_mock(mock_web, case_path.parent, config["responses"])
+    crawler = FreejavbtCrawler(client=http_client(mock_web))
+    result = await crawler._search(SearchQuery(config["number"]))
+    if config.get("expected_none"):
+        assert result is None
+    else:
+        assert result == config["expected_urls"][0]
+
+
+@pytest.mark.parametrize(
+    ("link_number", "labels", "query", "matched"),
+    [
+        ("BLACKED-170125", ["blacked.17.01.25"], "Blacked.17.01.25", True),
+        ("BLACKED-170125", ["Blacked.17.01.25"], "blacked.2017.01.25", True),
+        ("BLACKED-170125", ["Blacked.1917.01.25"], "blacked.1917.01.25", False),
+        ("BLACKED-170125", ["Blacked.2117.01.25"], "blacked.2117.01.25", False),
+        ("BLACKED-170110", ["blacked.17.01.25"], "Blacked.17.01.25", False),
+        ("OTHER-170125", ["blacked.17.01.25"], "Blacked.17.01.25", False),
+        ("BLACKED-170125", ["blacked.17.01.10"], "Blacked.17.01.25", False),
+        ("BLACKED-170125", ["Other.17.01.25"], "Blacked.17.01.25", False),
+        ("BLACKED-170125", ["blacked.17.01.25 解説"], "Blacked.17.01.25", False),
+        ("BLACKED-170125", [], "Blacked.17.01.25", False),
+        ("BLACKED-170125", ["blacked.17.01.25", "blacked.17.01.10"], "Blacked.17.01.25", False),
+        ("BLACKED-170230", ["blacked.17.02.30"], "Blacked.17.02.30", False),
+        ("BLACKED-171301", ["blacked.17.13.01"], "Blacked.17.13.01", False),
+        ("BLACKED-170125", ["BLACKED-170125"], "BLACKED-170125", False),
+        ("010115-001", ["010115_001"], "010115_001", False),
+        ("BLACKED-170125-other", ["blacked.17.01.25"], "Blacked.17.01.25", False),
+        ("BLACKED-170125", ["blacked.17.01.25"], "", False),
+    ],
+)
+def test_western_card_requires_consistent_identity(
+    link_number: str, labels: list[str], query: str, matched: bool
+) -> None:
+    assert _western_card_matches(link_number, labels, query) is matched
+
+
+@pytest.mark.parametrize(
+    "replacement",
+    [
+        "https://other.test/en/BLACKED-170125",
+        "https://freejavbt.com.other.test/en/BLACKED-170125",
+        "https://user:password@freejavbt.com/en/BLACKED-170125",
+        "https://[invalid/en/BLACKED-170125",
+    ],
+)
+@pytest.mark.asyncio
+async def test_compact_number_does_not_authorize_a_foreign_link(replacement: str) -> None:
+    path = Path(__file__).parent / "liu1443452494_cases" / "freejavbt" / "blacked-search.html"
+    original = "https://freejavbt.com/en/BLACKED-170125"
+    html = path.read_text(encoding="utf-8")
+    assert original in html
+    mock_web = build_mock_web()
+    mock_web.get_text.return_value = html.replace(original, replacement)
+    crawler = FreejavbtCrawler(client=http_client(mock_web))
+    assert await crawler._search(SearchQuery("Blacked.17.01.25")) is None
