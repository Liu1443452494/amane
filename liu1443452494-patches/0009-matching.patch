+@pytest.mark.asyncio
+async def test_larger_digital_poster_competes_with_dvd_and_rejects_other_works(
+    resource_store: ResourceStore, tmp_path: Path
+) -> None:
+    dvd = "https://m.media-amazon.com/images/I/51Disc.jpg"
+    digital = "https://m.media-amazon.com/images/I/71Digital.jpg"
+    wrong = "https://m.media-amazon.com/images/I/81Wrong.jpg"
+    placeholder = "https://m.media-amazon.com/images/I/01Placeholder.gif"
+    cards = [search_card(dvd)]
+    pages = {"https://www.amazon.co.jp/dp/B000000001": product_html(dvd)}
+    for asin, title in (
+        ("B000000002", "【視聴期限なし】原題の長い物語 楓カレン|オンラインコード版"),
+        ("B000000003", "【7日間視聴期限】原題の長い物語 楓カレン|オンラインコード版"),
+        ("B000000004", "【視聴期限なし】原題の長い物語 総集編 楓カレン|オンラインコード版"),
+        ("B000000005", "【視聴期限なし】原題の長い物語|オンラインコード版"),
+        ("B000000006", "【視聴期限なし】原題の長い物語 楓カレン|オンラインコード版"),
+    ):
+        card = search_card(placeholder, asin, title=title).replace(" [DVD]", "")
+        if asin == "B000000006":
+            card = card.replace(f'href="/dp/{asin}"', 'href="/dp/B000000099"')
+        cards.append(card.replace('<img class="s-image"', '<span>Software Download</span><img class="s-image"'))
+        pages[f"https://www.amazon.co.jp/dp/{asin}"] = product_html(
+            digital if asin in {"B000000002", "B000000003"} else wrong, asin, title=title
+        )
+    pages[search_url()] = "".join(cards)
+    client = PosterClient(
+        pages=pages,
+        images={
+            dvd: image_bytes(minimum_bytes=3000),
+            digital: image_bytes(minimum_bytes=6000),
+            wrong: image_bytes(minimum_bytes=9000),
+        },
+    )
+    result = await materialize_images(
+        [], [], [], resource_store, cast("WebClient", client), HotSettings(), tmp_path, poster_query=poster_query()
+    )
+    assert result.poster_urls == [digital, dvd]
+    assert client.downloaded == [dvd, digital]
+    assert "https://www.amazon.co.jp/dp/B000000002" in client.page_requests
+    assert "https://www.amazon.co.jp/dp/B000000003" in client.page_requests
+    assert "https://www.amazon.co.jp/dp/B000000004" not in client.page_requests
+    assert "https://www.amazon.co.jp/dp/B000000006" not in client.page_requests
+
+
