+            needs_conversion = image.format != "JPEG"
+    except (OSError, ValueError, SyntaxError, Image.DecompressionBombError) as exc:
+        raise OSError(f"整理图片无法读取: {src}") from exc
+    if not needs_conversion:
+        _write_into_library(src, dst)
+        return False
+
+    temporary = dst.with_name(f".{dst.stem}.{uuid4().hex}.jpg")
+    try:
+        marked = False
+        jpeg_quality = config.scraping.jpeg_quality if config is not None else 95
+        wm = config.watermark if config is not None else WatermarkConfig()
