+@pytest.mark.parametrize("suffix", [".png", ".webp", ".JPG", ".jpeg"])
+def test_conversion_only_applies_to_jpeg_output_names(tmp_path: Path, suffix: str) -> None:
+    source = tmp_path / "缓存原图.webp"
+    Image.new("RGB", (60, 40), "blue").save(source, format="WEBP")
+    original = source.read_bytes()
+    target = tmp_path / f"fanart{suffix}"
+    file_module._copy_library_image(source, target)
+    with Image.open(target) as image:
+        assert image.format == ("JPEG" if suffix.lower() in {".jpg", ".jpeg"} else "WEBP")
+    if suffix in {".png", ".webp"}:
+        assert target.read_bytes() == original
+    assert source.read_bytes() == original
+
