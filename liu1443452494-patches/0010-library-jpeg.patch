+def test_failed_conversion_preserves_previous_file_and_removes_temporary(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    source = tmp_path / "缓存原图.webp"
+    Image.new("RGB", (60, 40), "blue").save(source, format="WEBP")
+    original = source.read_bytes()
+    target = tmp_path / "fanart.jpg"
+    Image.new("RGB", (60, 40), "red").save(target)
+    previous = target.read_bytes()
+
+    def reject(image: Image.Image, path: Path, quality: int, *, preserve_details: bool = False) -> None:
+        path.write_bytes(b"partial-jpeg")
+        raise OSError("模拟 JPEG 编码失败")
+
+    monkeypatch.setattr(file_module, "_save_jpeg", reject)
+    with pytest.raises(OSError, match="模拟 JPEG 编码失败"):
+        file_module._copy_library_image(source, target)
+    assert target.read_bytes() == previous
+    assert source.read_bytes() == original
+    assert set(tmp_path.iterdir()) == {source, target}
+
