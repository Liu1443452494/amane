+        # 编码完成后按新文件写入库路径，权限由目标目录决定。
+        _write_into_library(temporary, dst, record=False)
+    finally:
+        temporary.unlink(missing_ok=True)
+    record_copied_file(src, dst)
+    return True
 
 
