@@ -0,0 +1,335 @@
+"""整理图片的真实格式、原图保留与单次 JPEG 编码。"""
+
+from io import BytesIO
+from pathlib import Path
+from typing import cast
+
+import pytest
+from PIL import Image, ImageCms, JpegImagePlugin
+
+from amane.config import HotSettings, ScrapingConfig, WatermarkConfig
+from amane.db.models import Metadata
+from amane.enums import DownloadableResource, LibraryResource
+from amane.handlers import file as file_module
+from amane.handlers.file import _place_library_images
+from amane.media import ResourceStore, materialize_images
+from amane.media import images as image_module
+from amane.net.http import WebClient
+from amane.parsing import ContentType, parse_file_info
+from tests.handlers.test_file_ops import _paths
+from tests.media.test_liu1443452494_image_quality import PosterClient
+
+
+@pytest.mark.parametrize(
+    ("image_format", "suffix", "mode"),
+    [
+        ("JPEG", ".jpg", "RGB"),
+        ("JPEG", ".webp", "RGB"),
+        ("WEBP", ".webp", "RGB"),
+        ("WEBP", ".jpg", "RGB"),
+        ("PNG", ".png", "RGBA"),
+        ("PNG", ".jpg", "P"),
+    ],
+)
+def test_jpeg_outputs_keep_sources_and_repeat_from_original(
+    tmp_path: Path, image_format: str, suffix: str, mode: str
+) -> None:
+    source = tmp_path / f"缓存原图{suffix}"
+    Image.new(mode, (300, 200), 0 if mode == "P" else "blue").save(source, format=image_format)
+    original = source.read_bytes()
+    trailer = tmp_path / "预告片.mp4"
+    trailer.write_bytes(b"unchanged-video")
+    paths = _paths(tmp_path / "整理")
+    outputs = [paths.thumb, paths.poster, paths.fanart, paths.extrafanart_dir / "1.jpg"]
+    first: list[bytes] = []
+    for turn in range(2):
+        if turn:
+            for output in outputs:
+                output.write_bytes(b"old-output-must-not-be-the-source")
+        _place_library_images.sync(
+            paths,
+            thumb_local=source,
+            poster_local=source,
+            trailer_local=trailer,
+            extrafanart=[source],
+            kinds=set(LibraryResource),
+            config=HotSettings(watermark=WatermarkConfig(enabled=False)),
+            file_info=parse_file_info("MIDV-123.mp4"),
+            content_type=ContentType.CENSORED,
+            watermark_dir=None,
+        )
+        for index, output in enumerate(outputs):
+            with Image.open(output) as image:
+                image.load()
+                assert image.format == "JPEG" and image.size == (300, 200)
+                if image_format != "JPEG":
+                    assert isinstance(image, JpegImagePlugin.JpegImageFile)
+                    assert JpegImagePlugin.get_sampling(image) == 0
+            data = output.read_bytes()
+            if image_format == "JPEG":
+                assert data == original
+            if turn:
+                assert data == first[index]
+            else:
+                first.append(data)
+        assert source.read_bytes() == original
+        assert paths.trailer.read_bytes() == trailer.read_bytes()
+
+
+@pytest.mark.parametrize("quality", [None, 50, 68, 95, 100])
+def test_conversion_uses_configured_quality_and_limits_watermarks(tmp_path: Path, quality: int | None) -> None:
+    source = tmp_path / "缓存原图.webp"
+    Image.new("RGB", (400, 240), "blue").save(source, format="WEBP")
+    original = source.read_bytes()
+    stamps = tmp_path / "角标"
+    stamps.mkdir()
+    Image.new("RGBA", (40, 20), (255, 0, 0, 255)).save(stamps / "subtitle.png")
+    config = (
+        HotSettings(
+            scraping=ScrapingConfig(jpeg_quality=quality),
+            watermark=WatermarkConfig(enabled=True, scale=0.2),
+        )
+        if quality is not None
+        else None
+    )
+    paths = _paths(tmp_path / "整理")
+    _place_library_images.sync(
+        paths,
+        thumb_local=source,
+        poster_local=source,
+        trailer_local=None,
+        extrafanart=[source],
+        kinds={LibraryResource.thumb, LibraryResource.poster, LibraryResource.fanart, LibraryResource.extrafanart},
+        config=config,
+        file_info=parse_file_info("MIDV-123-C.mp4") if config is not None else None,
+        content_type=ContentType.CENSORED,
+        watermark_dir=stamps,
+    )
+    # 核对真实 JPEG 量化表，避免仅验证质量参数被传递。
+    encoded = BytesIO()
+    with Image.open(source) as image:
+        image.convert("RGB").save(encoded, format="JPEG", quality=quality if quality is not None else 95, subsampling=0)
+    with Image.open(encoded) as expected:
+        assert isinstance(expected, JpegImagePlugin.JpegImageFile)
+        background = expected.getpixel((20, 20))
+        for output_path in (paths.thumb, paths.poster, paths.fanart, paths.extrafanart_dir / "1.jpg"):
+            with Image.open(output_path) as output:
+                assert isinstance(output, JpegImagePlugin.JpegImageFile)
+                assert output.size == (400, 240)
+                assert JpegImagePlugin.get_sampling(output) == 0
+                assert output.quantization == expected.quantization
+                if config is not None and output_path in (paths.thumb, paths.poster):
+                    assert output.getpixel((20, 20)) != background
+                else:
+                    assert output.getpixel((20, 20)) == background
+    assert source.read_bytes() == original
+
+
+def test_conversion_preserves_orientation_color_profile_and_transparency(tmp_path: Path) -> None:
+    source = tmp_path / "透明原图.png"
+    image = Image.new("RGBA", (90, 60), (255, 0, 0, 0))
+    image.paste((0, 0, 255, 255), (0, 0, 45, 60))
+    exif = Image.Exif()
+    exif[274] = 6
+    profile = ImageCms.ImageCmsProfile(ImageCms.createProfile("sRGB")).tobytes()
+    image.save(source, exif=exif, icc_profile=profile)
+    original = source.read_bytes()
+    paths = _paths(tmp_path / "整理")
+    _place_library_images.sync(
+        paths,
+        thumb_local=source,
+        poster_local=None,
+        trailer_local=None,
+        extrafanart=[],
+        kinds={LibraryResource.fanart},
+        config=None,
+        file_info=None,
+        content_type=ContentType.CENSORED,
+        watermark_dir=None,
+    )
+    with Image.open(paths.fanart) as output:
+        output.load()
+        assert output.format == "JPEG" and output.size == (60, 90)
+        assert output.getexif().get(274, 1) == 1
+        assert output.info["icc_profile"] == profile
+        assert output.getpixel((30, 70)) == (255, 255, 255)
+        blue = output.getpixel((30, 20))
+        assert isinstance(blue, tuple) and blue[2] > 245 and blue[0] < 10
+    assert source.read_bytes() == original
+
+
+@pytest.mark.parametrize("kind", [LibraryResource.thumb, LibraryResource.poster])
+def test_webp_watermark_and_conversion_encode_once(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, kind: LibraryResource
+) -> None:
+    source = tmp_path / "缓存原图.webp"
+    Image.new("RGB", (400, 240), "blue").save(source, format="WEBP")
+    original = source.read_bytes()
+    stamps = tmp_path / "角标"
+    stamps.mkdir()
+    Image.new("RGBA", (40, 20), (255, 0, 0, 255)).save(stamps / "subtitle.png")
+    saved: list[Path] = []
+    save_jpeg = image_module._save_jpeg
+
+    def record_save(image: Image.Image, path: Path, quality: int, *, preserve_details: bool = False) -> None:
+        saved.append(path)
+        save_jpeg(image, path, quality, preserve_details=preserve_details)
+
+    monkeypatch.setattr(image_module, "_save_jpeg", record_save)
+    monkeypatch.setattr(file_module, "_save_jpeg", record_save)
+    paths = _paths(tmp_path / "整理")
+    _place_library_images.sync(
+        paths,
+        thumb_local=source,
+        poster_local=source,
+        trailer_local=None,
+        extrafanart=[],
+        kinds={kind},
+        config=HotSettings(watermark=WatermarkConfig(enabled=True, scale=0.2)),
+        file_info=parse_file_info("MIDV-123-C.mp4"),
+        content_type=ContentType.CENSORED,
+        watermark_dir=stamps,
+    )
+    output_path = paths.thumb if kind == LibraryResource.thumb else paths.poster
+    with Image.open(output_path) as output:
+        output.load()
+        assert output.format == "JPEG" and output.size == (400, 240)
+        assert isinstance(output, JpegImagePlugin.JpegImageFile)
+        assert JpegImagePlugin.get_sampling(output) == 0
+        red = output.getpixel((20, 20))
+        assert isinstance(red, tuple) and red[0] > 230 and red[2] < 30
+    assert len(saved) == 1
+    assert source.read_bytes() == original
+
