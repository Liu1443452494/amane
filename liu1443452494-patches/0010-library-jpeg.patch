+def test_conversion_tolerates_denied_file_metadata_and_records_final_image(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    source = tmp_path / "缓存原图.webp"
+    Image.new("RGB", (60, 40), "blue").save(source, format="WEBP")
+    original = source.read_bytes()
+    target = tmp_path / "fanart.jpg"
+    recorded: list[tuple[Path, Path, int]] = []
+
+    def reject_metadata(*args: object, **kwargs: object) -> None:
+        raise PermissionError("模拟网盘拒绝写入文件时间")
+
+    def record(src: Path, dst: Path) -> None:
+        with Image.open(dst) as image:
+            image.load()
+            assert image.format == "JPEG"
+        recorded.append((src, dst, dst.stat().st_size))
+
+    monkeypatch.setattr(file_module.shutil, "copystat", reject_metadata)
+    monkeypatch.setattr(file_module, "record_copied_file", record)
+    file_module._copy_library_image(source, target)
+    assert recorded == [(source, target, target.stat().st_size)]
+    assert source.read_bytes() == original
+    assert set(tmp_path.iterdir()) == {source, target}
+
