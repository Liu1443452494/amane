+@pytest.mark.parametrize("condition", ["success", "content", "replace"])
+@pytest.mark.parametrize("record", [True, False])
+def test_copy_events_follow_final_copy_result(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, condition: str, record: bool
+) -> None:
+    """成功写入仅记录最终目标，复制或替换失败时保留旧产物并清除临时文件。"""
+    source = tmp_path / "原始资源.mp4"
+    source.write_bytes(b"original-resource")
+    target = tmp_path / "整理副本.mp4"
+    target.write_bytes(b"previous-resource")
+    copied: list[tuple[Path, Path, bytes]] = []
+    failure = OSError("模拟内容复制或目标替换失败")
+
+    def fail_contents(src: Path, dst: Path) -> None:
+        dst.write_bytes(b"partial-resource")
+        raise failure
+
+    def fail_replace(self: Path, destination: Path) -> Path:
+        raise failure
+
+    def record_copy(src: Path, dst: Path) -> None:
+        copied.append((src, dst, dst.read_bytes()))
+
+    monkeypatch.setattr(file_module, "record_copied_file", record_copy)
+    if condition == "content":
+        monkeypatch.setattr(file_module.shutil, "copyfile", fail_contents)
+    elif condition == "replace":
+        monkeypatch.setattr(Path, "replace", fail_replace)
+    if condition != "success":
+        with pytest.raises(OSError, match="模拟内容复制或目标替换失败") as error:
+            file_module._write_into_library(source, target, record=record)
+        assert error.value is failure
+        assert target.read_bytes() == b"previous-resource"
+    else:
+        file_module._write_into_library(source, target, record=record)
+        assert target.read_bytes() == b"original-resource"
+    expected = [(source, target, b"original-resource")] if record and condition == "success" else []
+    assert copied == expected
+    assert source.read_bytes() == b"original-resource"
+    assert set(tmp_path.iterdir()) == {source, target}
