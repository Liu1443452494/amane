@@ -0,0 +1,145 @@
+"""编辑后延迟整理、连续改名恢复，以及同号影片分批落盘。"""
+
+from pathlib import Path
+from typing import cast
+from xml.etree import ElementTree
+
+import pytest
+from fastapi import FastAPI
+from httpx2 import AsyncClient
+
+from amane.app.runtime import AppRuntime
+from amane.config import HotSettings, WatermarkConfig
+from amane.db.repository import Repository
+from amane.enums import LibraryResource, MoveMode
+from amane.handlers import OrganizeHandler, OrganizePayload
+from amane.net.http import WebClient
+from amane.organize.watermark_outputs import read_output_snapshot
+from amane.parsing import ContentType
+from tests.media.test_liu1443452494_image_quality import PosterClient, image_bytes
+
+
+async def _organize(handler: OrganizeHandler, library_id: int, media_id: int) -> None:
+    result = await handler.handle(OrganizePayload(library_id=library_id, media_file_ids=[media_id]))
+    assert result.result is not None and result.result.organized == 1 and result.result.failed == 0
+
+
+@pytest.mark.asyncio
+async def test_organize_number_edit_and_separate_batches(
+    client: AsyncClient, app: FastAPI, repo: Repository, safe_path: Path
+) -> None:
+    runtime: AppRuntime = app.state.runtime
+    number = "Vixen.19.05.09"
+    first_name = f"{number}  Jia Episode 1"
+    second_name = f"{number}  Jia Episode 2"
+    url = "https://images.test/cover.jpg"
+    web = PosterClient(images={url: image_bytes((800, 400))})
+    library = await repo.create_library(
+        name="分批整理",
+        path=str(safe_path),
+        move_mode=MoveMode.MOVE,
+        video_template="电影/{number}/{number}.{ext}",
+        nfo_template="{video_dir}/{number}.nfo",
+        subtitle_template="{video_dir}/{number}.srt",
+        subtitle_extensions=[".srt"],
+        copy_resources=[LibraryResource.poster, LibraryResource.fanart],
+    )
+    metadata = await repo.upsert_metadata(
+        number=number,
+        content_type=ContentType.WESTERN,
+        title="第一部标题",
+        plot="第一部剧情",
+        thumb_urls=[url],
+        poster_urls=[url],
+        raw={"javdb": {"number": number, "title": "第一部标题"}},
+    )
+    assert library.id is not None and metadata.id is not None
+    source = safe_path / f"{number}.mp4"
+    source.write_bytes(b"first movie")
+    source.with_suffix(".srt").write_text("第一部字幕", encoding="utf-8")
+    media = await repo.create_media_file(library.id, path=str(source), metadata_id=metadata.id)
+    assert media.id is not None
+    handler = OrganizeHandler(
+        repo,
+        HotSettings(watermark=WatermarkConfig(enabled=False)),
+        runtime.resource_store,
+        web_client=cast("WebClient", web),
+        library_locks=runtime.library_locks,
+    )
+    await _organize(handler, library.id, media.id)
+    old_dir = safe_path / "电影" / number
+    old_nfo = old_dir / f"{number}.nfo"
+    original_nfo = old_nfo.read_bytes()
+    endpoint = f"metadata/{metadata.id}"
+    schema = (await client.get("metadata/schema")).json()
+    assert "organize_number" in schema["properties"] and "number" not in schema["properties"]
+    for invalid in ("../越界", "名称\n", "a" * 201, 3, [], {}):
+        response = await client.patch(endpoint, json={"organize_number": invalid})
+        assert response.status_code == 422 and "organize_number" in response.text
+    assert (await client.patch("metadata/999999", json={"organize_number": first_name})).status_code == 404
+    assert (await client.patch(endpoint, json={"number": first_name})).status_code == 422
+    updated = await client.patch(endpoint, json={"organize_number": f"  {first_name}  "})
+    assert updated.status_code == 200 and updated.json()["organize_number"] == first_name
+    assert updated.json()["number"] == number and updated.json()["title"] == "第一部标题"
+    other_edit = await client.patch(endpoint, json={"plot": "人工修订的第一部剧情"})
+    assert other_edit.status_code == 200 and other_edit.json()["organize_number"] == first_name
+    assert old_nfo.read_bytes() == original_nfo
+    stored = await repo.get_media_file(media.id)
+    assert stored is not None
+    snapshot = stored.organized_outputs
+    assert old_nfo in {output.path for output in read_output_snapshot(snapshot, number).outputs}
+    assert (await client.patch(endpoint, json={"organize_number": first_name})).status_code == 200
+    repeated = await repo.get_media_file(media.id)
+    assert repeated is not None and repeated.organized_outputs == snapshot
+    assert (await client.get("tasks")).json()["total"] == 0
+
+    first_dir = safe_path / "电影" / first_name
+    first_dir.mkdir()
+    conflict = first_dir / f"{first_name}.mp4"
+    conflict.write_bytes(b"other movie")
+    failed = await handler.handle(OrganizePayload(library_id=library.id, media_file_ids=[media.id]))
+    assert failed.result is not None and failed.result.conflicted == 1
+    assert conflict.read_bytes() == b"other movie" and old_nfo.read_bytes() == original_nfo
+    conflict.unlink()
+    await _organize(handler, library.id, media.id)
+    assert not old_dir.exists()
+    assert (first_dir / f"{first_name}.mp4").read_bytes() == b"first movie"
+    assert (first_dir / f"{first_name}.srt").read_text(encoding="utf-8") == "第一部字幕"
+    assert not (first_dir / "thumb.jpg").exists()
+    assert (first_dir / "fanart.jpg").read_bytes() == (first_dir / "poster.jpg").read_bytes()
+    nfo = ElementTree.parse(first_dir / f"{first_name}.nfo").getroot()
+    assert nfo.findtext("num") == first_name and nfo.findtext("title") == f"{first_name} 第一部标题"
+    saved = (await client.get(endpoint)).json()["metadata"]
+    assert saved["number"] == number and saved["raw"] == metadata.raw and saved["plot"] == "人工修订的第一部剧情"
+
+    assert (await client.patch(endpoint, json={"organize_number": "临时名称"})).status_code == 200
+    cleared = await client.patch(endpoint, json={"organize_number": None})
+    assert cleared.status_code == 200 and cleared.json()["organize_number"] is None
+    await _organize(handler, library.id, media.id)
+    assert not first_dir.exists() and not (safe_path / "电影" / "临时名称").exists()
+    assert ElementTree.parse(old_nfo).getroot().findtext("num") == number
+    assert (await client.patch(endpoint, json={"organize_number": first_name})).status_code == 200
+    await _organize(handler, library.id, media.id)
+    first_outputs = {path: path.read_bytes() for path in first_dir.iterdir() if path.is_file()}
+    assert (await client.delete(endpoint)).status_code == 204
+    second = await repo.upsert_metadata(
+        number=number, content_type=ContentType.WESTERN, title="第二部标题", thumb_urls=[url], poster_urls=[url]
+    )
+    assert second.id is not None and second.organize_number is None
+    response = await client.patch(f"metadata/{second.id}", json={"organize_number": second_name})
+    assert response.status_code == 200 and response.json()["organize_number"] == second_name
+    response = await client.patch(f"metadata/{second.id}", json={"organize_number": ""})
+    assert response.status_code == 200 and response.json()["organize_number"] is None
+    source.write_bytes(b"second movie")
+    second_media = await repo.create_media_file(library.id, path=str(source), metadata_id=second.id)
+    assert second_media.id is not None
+    await _organize(handler, library.id, second_media.id)
+    response = await client.patch(f"metadata/{second.id}", json={"organize_number": second_name})
+    assert response.status_code == 200
+    await _organize(handler, library.id, second_media.id)
+    second_dir = safe_path / "电影" / second_name
+    assert (second_dir / f"{second_name}.mp4").read_bytes() == b"second movie"
+    assert (
+        ElementTree.parse(second_dir / f"{second_name}.nfo").getroot().findtext("title") == f"{second_name} 第二部标题"
+    )
+    assert all(path.read_bytes() == data for path, data in first_outputs.items())
