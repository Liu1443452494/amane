@@ -0,0 +1,56 @@
+"""修改整理用番号前记录旧产物，保存过程不移动或重写媒体文件。"""
+
+from contextlib import AsyncExitStack
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+import structlog
+
+from ...db.repo_types import WriteMode
+from ...db.watermarks import effective_file_info
+from ...organize.watermark_outputs import OutputSnapshot, capture_output_baseline
+from ...parsing import parse_file_info
+
+if TYPE_CHECKING:
+    from ...app.runtime import AppRuntime
+    from ...db.models import Metadata
+    from ...db.repo_types import MetadataFields
+    from ...db.repository import Repository
+
+
+async def update_organize_number(
+    metadata_id: int, updates: MetadataFields, repo: Repository, runtime: AppRuntime
+) -> Metadata | None:
+    files = await repo.get_media_by_metadata_id(metadata_id)
+    # 与整理共用库锁，按固定顺序取得多个库的锁，避免旧产物在记录期间被移动。
+    async with AsyncExitStack() as stack:
+        for library_id in sorted({media.library_id for media in files}):
+            await stack.enter_async_context(await runtime.library_locks.get(library_id))
+        metadata = await repo.get_metadata(metadata_id)
+        if metadata is None:
+            return None
+        if "organize_number" in updates and updates["organize_number"] != metadata.organize_number:
+            actor_genders = {actor.name: actor.gender for actor in await repo.get_actors_by_names(metadata.actors)}
+            for media in await repo.get_media_by_metadata_id(metadata_id):
+                if media.id is None or media.organized_outputs is not None:
+                    continue
+                baseline = OutputSnapshot(number=metadata.number).model_dump_json()
+                library = await repo.get_library(media.library_id)
+                if library is not None:
+                    try:
+                        baseline = await capture_output_baseline(
+                            library,
+                            metadata,
+                            Path(media.path),
+                            effective_file_info(
+                                media, parse_file_info(media.path, has_external_subtitle=media.has_external_subtitle)
+                            ),
+                            safe_dirs=runtime.safe_dirs,
+                            actor_genders=actor_genders,
+                        )
+                    except (OSError, ValueError) as exc:
+                        structlog.get_logger().warning(
+                            "整理改名前的产物无法确认，保留旧文件", media_id=media.id, error=str(exc)
+                        )
+                await repo.update_media_file(media.id, organized_outputs=baseline)
+        return await repo.update_metadata(metadata_id, mode=WriteMode.MANUAL, **updates)
