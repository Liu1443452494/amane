+"""整理用番号迁移保留原番号及其唯一约束。"""
+
+from pathlib import Path
+
+import pytest
+from alembic import command
+from alembic.script import ScriptDirectory
+from sqlalchemy import create_engine, inspect, text
+from sqlalchemy.exc import IntegrityError
+
+from amane.db.sqlite_migrate import upgrade_sqlite_database
+from tests.helpers import alembic_config
+
+
+def test_organize_number_migration_preserves_existing_metadata(tmp_path: Path) -> None:
+    path = tmp_path / "整理番号迁移.db"
+    config = alembic_config(path)
+    command.upgrade(config, "0bbd0974b7c7")
+    engine = create_engine(f"sqlite:///{path}")
+    insert = text(
+        "INSERT INTO metadata (number,title,content_type,actors,directors,tags,poster_urls,thumb_urls,"
+        "trailer_urls,extrafanart_urls,scores,external_ids,source_urls,field_sources,raw,created_at,updated_at) "
+        "VALUES (:number,:title,'WESTERN','[]','[]','[]','[]','[]','[]','{}','{}','{}','{}','{}','{}',"
+        "CURRENT_TIMESTAMP,CURRENT_TIMESTAMP)"
+    )
+    try:
+        with engine.begin() as connection:
+            connection.execute(insert, {"number": "Vixen.19.05.09", "title": "原有标题"})
+        command.upgrade(config, "c4b12eeaee74")
+        with engine.begin() as connection:
+            assert connection.execute(text("SELECT number,title,organize_number FROM metadata")).one() == (
+                "Vixen.19.05.09",
+                "原有标题",
+                None,
+            )
+            connection.execute(text("UPDATE metadata SET organize_number='Vixen.19.05.09  Jia Episode 1'"))
+        command.downgrade(config, "0bbd0974b7c7")
+        with engine.connect() as connection:
+            assert "organize_number" not in {column["name"] for column in inspect(connection).get_columns("metadata")}
+            assert connection.execute(text("SELECT number,title FROM metadata")).one() == ("Vixen.19.05.09", "原有标题")
+        with pytest.raises(IntegrityError, match="UNIQUE"), engine.begin() as connection:
+            connection.execute(insert, {"number": "vixen.19.05.09", "title": "重复番号"})
+        command.upgrade(config, "c4b12eeaee74")
+        with engine.connect() as connection:
+            assert connection.execute(text("SELECT number,title,organize_number FROM metadata")).one() == (
+                "Vixen.19.05.09",
+                "原有标题",
+                None,
+            )
+    finally:
+        engine.dispose()
+
+
+@pytest.mark.parametrize(
+    ("starting_revisions", "has_custom_data", "has_extrafanart_template"),
+    [
+        (("c4b12eeaee74",), True, False),
+        (("fb4fd486708c",), False, True),
+        (("c4b12eeaee74", "fb4fd486708c"), True, True),
+    ],
+    ids=["自用终点", "上游终点", "两分支均已升级"],
+)
+def test_startup_merges_extrafanart_and_custom_migrations(
+    tmp_path: Path,
+    starting_revisions: tuple[str, ...],
+    has_custom_data: bool,
+    has_extrafanart_template: bool,
+) -> None:
+    """启动补齐缺失分支，保留整理番号、人工水印与媒体库剧照模板。"""
+    path = tmp_path / "分支合并.db"
+    config = alembic_config(path)
+    for revision in starting_revisions:
+        command.upgrade(config, revision)
+    engine = create_engine(f"sqlite:///{path}")
+    insert = text(
+        "INSERT INTO metadata (number,title,content_type,actors,directors,tags,poster_urls,thumb_urls,"
+        "trailer_urls,extrafanart_urls,scores,external_ids,source_urls,field_sources,raw,created_at,updated_at) "
+        "VALUES (:number,'原有标题','CENSORED','[]','[]','[]','[]','[]','[]','{}','{}','{}','{}','{}','{}',"
+        "CURRENT_TIMESTAMP,CURRENT_TIMESTAMP)"
+    )
+    saved_outputs = '{"version":1,"number":"SSIS-345","outputs":[]}'
+    try:
+        with engine.begin() as connection:
+            assert set(connection.execute(text("SELECT version_num FROM alembic_version")).scalars()) == set(
+                starting_revisions
+            )
+            connection.execute(insert, {"number": "SSIS-345"})
+            connection.execute(
+                text(
+                    "INSERT INTO libraries "
+                    "(id,name,path,automation,recursive,patterns,move_mode,link_mode,video_template,"
+                    "write_nfo,copy_resources,trailer_pattern,blacklist_patterns,subtitle_extensions,min_file_size) "
+                    "VALUES (1,'原有媒体库','/原目录','SCRAPE',1,'[]','MOVE','STRM','{number}.{ext}',"
+                    "1,'[]','','[]','[]',0)"
+                )
+            )
+            connection.execute(
+                text(
+                    "INSERT INTO media_files "
+                    "(path,status,library_id,metadata_id,created_at,updated_at,mosaic,definition,"
+                    "has_subtitle_in_name,has_external_subtitle) "
+                    "VALUES ('/原目录/SSIS-345-C-4K.mp4','SCRAPED',1,1,'2026-11-01','2026-11-01',"
+                    "'CENSORED','4K',1,0)"
+                )
+            )
+            if has_custom_data:
+                connection.execute(text("UPDATE metadata SET organize_number='SSIS-345 整理名称'"))
+                connection.execute(
+                    text(
+                        "UPDATE media_files SET watermark_mode='MANUAL',watermark_subtitle=0,"
+                        "watermark_mosaic='LEAKED',watermark_definition=NULL,watermark_definition_locked=1,"
+                        "organized_outputs=:outputs"
+                    ),
+                    {"outputs": saved_outputs},
+                )
+            if has_extrafanart_template:
+                connection.execute(text("UPDATE libraries SET extrafanart_name_template='{number}_{index_padded}.jpg'"))
+
+        backup = upgrade_sqlite_database(path)
+        assert backup is not None and backup.is_file()
+        heads = ScriptDirectory.from_config(config).get_heads()
+        assert len(heads) == 1
+        with engine.connect() as connection:
+            assert connection.execute(text("SELECT version_num FROM alembic_version")).scalars().all() == heads
+            assert connection.execute(text("SELECT number,title,organize_number FROM metadata")).one() == (
+                "SSIS-345",
+                "原有标题",
+                "SSIS-345 整理名称" if has_custom_data else None,
+            )
+            assert connection.execute(text("SELECT name,path,extrafanart_name_template FROM libraries")).one() == (
+                "原有媒体库",
+                "/原目录",
+                "{number}_{index_padded}.jpg" if has_extrafanart_template else None,
+            )
+            assert connection.execute(
+                text("SELECT path,status,library_id,metadata_id,mosaic,definition FROM media_files")
+            ).one() == ("/原目录/SSIS-345-C-4K.mp4", "SCRAPED", 1, 1, "CENSORED", "4K")
+            expected_watermarks = (
+                ("MANUAL", 0, "LEAKED", None, 1, saved_outputs)
+                if has_custom_data
+                else ("AUTO", None, None, None, 0, None)
+            )
+            assert (
+                connection.execute(
+                    text(
+                        "SELECT watermark_mode,watermark_subtitle,watermark_mosaic,watermark_definition,"
+                        "watermark_definition_locked,organized_outputs FROM media_files"
