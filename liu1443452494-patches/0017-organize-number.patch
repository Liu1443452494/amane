@@ -0,0 +1,27 @@
+"""整理用番号的文件名校验，不参与刮削番号识别。"""
+
+import ntpath
+
+
+def normalize_organize_number(value: str | None) -> str | None:
+    """允许名称中的空格，空值恢复原番号；拒绝无法作为单个文件名的内容。"""
+    if value is None:
+        return None
+    if any(ord(char) < 32 or ord(char) == 127 for char in value):
+        raise ValueError("整理用番号不能包含换行或控制字符")
+    number = value.strip()
+    if not number:
+        return None
+    if any(char in '<>:"/\\|?*' for char in number):
+        raise ValueError('整理用番号不能包含文件名非法字符：< > : " / \\ | ? *')
+    if number.endswith("."):
+        raise ValueError("整理用番号不能以句点结尾")
+    if ntpath.isreserved(number):
+        raise ValueError("整理用番号不能使用系统保留名称")
+    try:
+        encoded = number.encode("utf-8")
+    except UnicodeEncodeError as exc:
+        raise ValueError("整理用番号包含无法编码为 UTF-8 的字符") from exc
+    if len(encoded) > 200:
+        raise ValueError("整理用番号过长，UTF-8 编码后不能超过 200 字节")
+    return number
