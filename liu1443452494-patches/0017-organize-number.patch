+"""整理用番号不能改变刮削查询或被刮削结果覆盖。"""
+
+import pytest
+
+from amane.config import HotSettings
+from amane.crawlers.models import FetchOptions, MediaMetadata, SearchQuery
+from amane.db.repo_types import WriteMode
+from amane.db.repository import Repository
+from amane.enums import SiteName
+from amane.handlers import ScrapeHandler, ScrapePayload
+from amane.media import ResourceStore
+from amane.parsing import ContentType
+from tests.handlers.test_liu1443452494_image_quality import OriginalCrawler
+from tests.handlers.test_scraper import FakeFactory
+
+
+class NumberRecordingCrawler(OriginalCrawler):
+    def __init__(self, metadata: MediaMetadata) -> None:
+        super().__init__(metadata)
+        self.numbers: list[str] = []
+
+    async def fetch(self, query: SearchQuery, options: FetchOptions | None = None) -> MediaMetadata | None:
+        self.numbers.append(query.number)
+        return await super().fetch(query, options)
+
+
+@pytest.mark.asyncio
+async def test_rescrape_keeps_organize_number_and_uses_original_query(
+    repo: Repository, resource_store: ResourceStore
+) -> None:
+    number = "Vixen.19.05.09"
+    custom = f"{number}  Jia Episode 1"
+    metadata = await repo.upsert_metadata(number=number, content_type=ContentType.WESTERN, title="旧标题")
+    assert metadata.id is not None
+    await repo.update_metadata(metadata.id, mode=WriteMode.MANUAL, organize_number=custom)
+    crawler = NumberRecordingCrawler(MediaMetadata(number=number, title="重新取得的标题"))
+    config = HotSettings()
+    config.scraping.content_routes[ContentType.WESTERN] = [SiteName.DMM]
+    handler = ScrapeHandler(repo, FakeFactory({"dmm": crawler}), resource_store, config)
+    result = await handler.handle(ScrapePayload(number=number, content_type=ContentType.WESTERN, use_cache=set()))
+    assert result.success and crawler.numbers == [number]
+    saved = await repo.get_metadata(metadata.id)
+    assert saved is not None and saved.organize_number == custom and saved.number == number
+    assert saved.title == "重新取得的标题" and saved.raw["dmm"]["number"] == number
