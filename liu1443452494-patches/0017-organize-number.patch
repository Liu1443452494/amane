+@pytest.mark.parametrize(
+    ("available", "suffix", "first_name", "last_name", "expected_format"),
+    [
+        (10, ".jpeg", "MY-456-01.jpeg", "MY-456-10.jpeg", "JPEG"),
+        (9, ".jpeg", "MY-456-1.jpeg", "MY-456-9.jpeg", "JPEG"),
+        (10, ".webp", "MY-456-01.webp", "MY-456-10.webp", "WEBP"),
+        (9, ".png", "MY-456-1.png", "MY-456-9.png", "WEBP"),
+    ],
+)
+async def test_custom_still_names_preserve_sources_and_track_actual_outputs(
+    resource_store: ResourceStore,
+    tmp_path: Path,
+    available: int,
+    suffix: str,
+    first_name: str,
+    last_name: str,
+    expected_format: str,
+) -> None:
+    """自定义剧照名使用整理用番号及成功下载数量, 转换和快照始终指向实际副本。"""
+    urls = [f"https://images.test/still-{index}.webp" for index in range(1, 11)]
+    originals: dict[str, bytes] = {}
+    for index, url in enumerate(urls[:available], 1):
+        encoded = BytesIO()
+        Image.new("RGB", (60 + index, 40), "blue").save(encoded, format="WEBP")
+        originals[url] = encoded.getvalue()
+    client = PosterClient(images=originals)
+    source = tmp_path / "MIDV-123.mp4"
+    source.write_bytes(b"original-video")
+    library_root = tmp_path / "媒体库"
+    library_root.mkdir()
+    library = Library(
+        name="测试",
+        path=str(library_root),
+        video_template="{number}/{number}.{ext}",
+        extrafanart_name_template="{number}-{index_padded}" + suffix,
+        copy_resources=[LibraryResource.extrafanart],
+    )
+    metadata = Metadata(number="MIDV-123", organize_number="MY-456", extrafanart_urls={"test": urls})
+    file_info = parse_file_info(source)
+    paths = resolve_paths(library, metadata, ext="mp4", source_path=source, file_info=file_info)
+    result = await file_module.execute_file_operations(
+        media_file=MediaFile(path=str(source), library_id=1),
+        metadata=metadata,
+        paths=paths,
+        move_mode=MoveMode.COPY,
+        resource_store=resource_store,
+        file_info=file_info,
+        write_nfo=False,
+        copy_resources=library.copy_resources,
+        web_client=cast(WebClient, client),
+        config=HotSettings(watermark=WatermarkConfig(enabled=False)),
+        library=library,
+        track_outputs=True,
+    )
+    assert result.outcome is PlaceOutcome.PLACED
+    names = sorted(path.name for path in paths.extrafanart_dir.iterdir())
+    assert len(names) == available
+    assert names[0] == first_name and names[-1] == last_name
+    assert len(result.outputs) == available
+    assert all(output.kind == "extrafanart" for output in result.outputs)
+    assert {output.path for output in result.outputs} == set(paths.extrafanart_dir.iterdir())
+    for index, output in enumerate(result.outputs, 1):
+        with Image.open(output.path) as image:
+            image.load()
+            assert image.format == expected_format
+            assert image.size == (60 + index, 40)
+        original = originals[urls[index - 1]]
+        cached = await resource_store.resolve(urls[index - 1])
+        assert cached is not None and cached.read_bytes() == original
+        if expected_format == "WEBP":
+            assert output.path.read_bytes() == original
+    for url in urls[available:]:
+        assert await resource_store.resolve(url) is None
+    assert source.read_bytes() == b"original-video"
