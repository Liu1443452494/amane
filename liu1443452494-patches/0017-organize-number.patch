+"""整理用番号的输入边界、路径和 NFO 输出。"""
+
+from pathlib import Path
+from xml.etree import ElementTree
+
+import pytest
+
+from amane.db.models import Library, Metadata
+from amane.liu1443452494_organize_number import normalize_organize_number
+from amane.media import write_nfo
+from amane.organize import resolve_paths
+from amane.organize.strm_content import render_strm_content
+
+
+@pytest.mark.parametrize(
+    ("value", "expected", "error"),
+    [
+        (None, None, None),
+        ("", None, None),
+        ("   ", None, None),
+        ("  Vixen.19.05.09  Jia Episode 1  ", "Vixen.19.05.09  Jia Episode 1", None),
+        ("中文片名 & Episode 2", "中文片名 & Episode 2", None),
+        ("a" * 200, "a" * 200, None),
+        ("中" * 66, "中" * 66, None),
+        ("a" * 201, None, "过长"),
+        ("中" * 67, None, "过长"),
+        *[(value, None, "非法字符") for value in ("../电影", "目录\\电影", "a:b", 'a"b', "a?b", "a*b", "a|b", "a<b>")],
+        *[(value, None, "控制字符") for value in ("电影\n", "\t电影", "电影\x00", "电影\x7f")],
+        *[(value, None, "句点") for value in (".", "..", "电影.")],
+        *[(value, None, "保留名称") for value in ("CON", "nul.mp4", "COM1", "lpt²", "CON .txt", "CONIN$", "CONOUT$")],
+        ("电影\ud800", None, "无法编码为 UTF-8"),
+    ],
+)
+def test_organize_number_validation(value: str | None, expected: str | None, error: str | None) -> None:
+    if error is not None:
+        with pytest.raises(ValueError, match=error):
+            normalize_organize_number(value)
+    else:
+        assert normalize_organize_number(value) == expected
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("custom", [None, "Vixen.19.05.09  Jia Episode 1", "中文片名 & Episode 2"])
+async def test_organize_number_changes_outputs_without_changing_identity(tmp_path: Path, custom: str | None) -> None:
+    metadata = Metadata(
+        number="Vixen.19.05.09",
+        organize_number=custom,
+        title="时光与场所",
+        external_ids={"javdb": "来源标识"},
+    )
+    library = Library(name="测试库", path=str(tmp_path), video_template="{number}/{number}.{ext}")
+    expected = custom or metadata.number
+    paths = resolve_paths(library, metadata, ext="mp4")
+    assert paths.video == tmp_path / expected / f"{expected}.mp4"
+    assert render_strm_content("https://example.test/{number}", paths.video, tmp_path, metadata) == (
+        "https://example.test/Vixen.19.05.09\n"
+    )
+    assert render_strm_content(None, paths.video, tmp_path, metadata) == f"{paths.video}\n"
+    assert await write_nfo(metadata, paths.nfo)
+    root = ElementTree.parse(paths.nfo).getroot()
+    assert root.findtext("num") == expected
+    for field in ("title", "originaltitle", "sorttitle"):
+        assert root.findtext(field) == f"{expected} 时光与场所"
+    assert root.findtext("javdbid") == "来源标识"
+    assert metadata.number == "Vixen.19.05.09" and metadata.title == "时光与场所"
