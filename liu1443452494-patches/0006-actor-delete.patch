new file mode 100644
index 0000000000000000000000000000000000000000..12eaca3dcdf94bd56648f3beac0b9e3100c85505
--- /dev/null
+++ b/tests/handlers/test_liu1443452494_actor_delete.py
@@ -0,0 +1,78 @@
+"""删除旧演员后复用影片缓存, 按更新后的 XML 创建展示名与演员标签。"""
+
+from pathlib import Path
+from unittest.mock import AsyncMock
+
+import pytest
+
+from amane.config import HotSettings
+from amane.db.models import FacetKind
+from amane.db.repository import Repository
+from amane.handlers import ScrapeHandler, ScrapePayload
+from amane.media import ResourceStore
+from amane.organize.template import TemplateContext
+from amane.parsing import ContentType
+from tests.handlers.test_scraper import FakeFactory, MockCrawler
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("initial_standard", [None, "旧标准名"])
+async def test_deleted_actor_is_recreated_from_updated_xml(
+    tmp_path: Path,
+    repo: Repository,
+    resource_store: ResourceStore,
+    monkeypatch: pytest.MonkeyPatch,
+    initial_standard: str | None,
+) -> None:
+    mapping = tmp_path / "mapping_actor.xml"
+    if initial_standard is not None:
+        mapping.write_text(f'<actors><a zh_cn="{initial_standard}" keyword="Actor A"/></actors>', encoding="utf-8")
+    crawler = MockCrawler()
+    fetch = AsyncMock(wraps=crawler.fetch)
+    monkeypatch.setattr(crawler, "fetch", fetch)
+    handler = ScrapeHandler(
+        repo=repo,
+        factory=FakeFactory({"javdb": crawler}),
+        resource_store=resource_store,
+        pipeline_config=HotSettings(),
+    )
+    payload = ScrapePayload(number="MIDV-123", content_type=ContentType.CENSORED)
+    assert (await handler.handle(payload)).success
+    original = await repo.get_metadata_by_number(payload.number)
+    old_name = initial_standard or "Actor A"
+    assert original is not None and original.id is not None
+    assert original.actors == [old_name]
+    old_actor = (await repo.get_actors_by_names([old_name]))[0]
+    assert old_actor.id is not None
+    old_actor.overview = "旧演员资料"
+    old_actor.raw = {"minnano": {"name": old_name}}
+    await repo.save_actor(old_actor)
+    await repo.add_actor_alias(old_actor.id, "枫花恋")
+    await repo.add_actor_alias(old_actor.id, "过期别名")
+    another = await repo.upsert_metadata(number="MIDV-124", actors=[old_name])
+    assert another.id is not None
+
+    mapping.write_text('<actors><a zh_cn="枫花恋" keyword="Actor A"/></actors>', encoding="utf-8")
+    assert await repo.delete_facet(FacetKind.ACTOR, old_actor.id)
+    assert await repo.get_actor(old_actor.id) is None
+    assert await repo.get_actor_aliases(old_actor.id) == []
+    assert await repo.list_facet_rules(FacetKind.ACTOR) == []
+    assert not await repo.delete_facet(FacetKind.ACTOR, old_actor.id)
+    for metadata_id in (original.id, another.id):
+        removed = await repo.get_metadata(metadata_id)
+        assert removed is not None and removed.actors == []
+
+    assert (await handler.handle(payload)).success
+    assert fetch.await_count == 1
+    updated = await repo.get_metadata(original.id)
+    assert updated is not None
+    assert updated.actors == ["枫花恋"]
+    assert updated.tags == ["Drama", "枫花恋"]
+    assert updated.raw == original.raw
+    assert TemplateContext.from_metadata(updated).variables["actresses"] == "枫花恋"
+    recreated = (await repo.get_actors_by_names(["枫花恋"]))[0]
+    assert recreated.id is not None and recreated.name == "枫花恋"
+    assert not recreated.overview and not recreated.raw
+    assert await repo.get_actor_aliases(recreated.id) == ["Actor A"]
+    untouched = await repo.get_metadata(another.id)
+    assert untouched is not None and untouched.actors == []
