diff --git a/web/src/components/media/reorganize-button.tsx b/web/src/components/media/reorganize-button.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..6fc3d4a82603075cb15eca4e7da0a163b95f02d0
--- /dev/null
+++ b/web/src/components/media/reorganize-button.tsx
@@ -0,0 +1,122 @@
+import { Box, Button, Group, Modal, Select, Stack, Text, Tooltip } from "@mantine/core";
+import { notifications } from "@mantine/notifications";
+import { IconFolderDown } from "@tabler/icons-react";
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { useState } from "react";
+import { useTranslation } from "react-i18next";
+import { listTasksQueryKey, submitTaskMutation } from "@/client/@tanstack/react-query.gen";
+import type { MediaFileResponse } from "@/client/types.gen";
+import { extractErrorMessage } from "@/lib/api-error";
+
+interface ReorganizeButtonProps {
+  metadataNumber: string;
+  files: MediaFileResponse[];
+}
+
+export function ReorganizeButton({ metadataNumber, files }: ReorganizeButtonProps) {
+  const { t } = useTranslation(["metadata", "common"]);
+  const queryClient = useQueryClient();
+  const [opened, setOpened] = useState(false);
+  const [selectedId, setSelectedId] = useState<string | null>(null);
+  const selected = files.find((file) => String(file.id) === selectedId);
+  const organize = useMutation({
+    ...submitTaskMutation(),
+    onSuccess: () => {
+      setOpened(false);
+      setSelectedId(null);
+      void queryClient.invalidateQueries({ queryKey: listTasksQueryKey() });
+      notifications.show({ message: t("common:toast.organizeStarted"), color: "blue" });
+    },
+    onError: (error) =>
+      notifications.show({
+        message: extractErrorMessage(error, t("common:toast.operationFailed")),
+        color: "red",
+      }),
+  });
+  const saving = organize.isPending;
+
+  function submit(media: MediaFileResponse) {
+    if (saving) return;
+    organize.mutate({
+      body: {
+        type: "organize",
+        library_id: media.library_id,
+        media_file_ids: [media.id],
+      },
+    });
+  }
+
+  function start() {
+    if (saving) return;
+    if (files.length === 1) {
+      submit(files[0]);
+    } else if (files.length > 1) {
+      setSelectedId(null);
+      setOpened(true);
+    }
+  }
+
+  return (
+    <>
+      <Tooltip label={t("detail.noFiles")} disabled={files.length > 0}>
+        <Box display="inline-block">
+          <Button
+            size="xs"
+            variant="light"
+            leftSection={<IconFolderDown size={14} />}
+            disabled={files.length === 0}
+            loading={saving}
+            onClick={start}
+          >
+            {t("detail.reorganize.action")}
+          </Button>
+        </Box>
+      </Tooltip>
+      {opened && (
+        <Modal
+          opened
+          onClose={() => {
+            if (!saving) setOpened(false);
+          }}
+          title={`${t("detail.reorganize.action")} — ${metadataNumber}`}
+          size="lg"
+          closeOnEscape={!saving}
+          closeOnClickOutside={!saving}
+          withCloseButton={!saving}
+        >
+          <Stack>
+            <Select
+              label={t("detail.reorganize.file")}
+              placeholder={t("detail.reorganize.selectFile")}
+              data={files.map((file) => ({ value: String(file.id), label: file.path }))}
+              value={selectedId}
+              onChange={setSelectedId}
+              disabled={saving}
+              allowDeselect={false}
+              searchable
+            />
+            {selected && (
+              <Text size="sm" style={{ overflowWrap: "anywhere" }}>
+                {selected.path}
+              </Text>
+            )}
+            <Group justify="flex-end">
+              <Button variant="default" onClick={() => setOpened(false)} disabled={saving}>
+                {t("common:actions.cancel")}
+              </Button>
+              <Button
+                loading={saving}
+                disabled={!selected}
+                onClick={() => {
+                  if (selected) submit(selected);
+                }}
+              >
+                {t("detail.reorganize.action")}
+              </Button>
+            </Group>
+          </Stack>
+        </Modal>
+      )}
+    </>
+  );
+}
